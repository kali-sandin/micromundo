C WORLD.h);\n          if (dx * dx + dy * dy <= r2) outA.push(e);\n        }\n        const listB = bucket[typeB];\n        for (let i = 0; i < listB.length; i += 1) {\n          const e = listB[i];\n          const dx = torusDelta(e.x - x\x2C WORLD.w);\n          const dy = torusDelta(e.y - y\x2C WORLD.h);\n          if (dx * dx + dy * dy <= r2) outB.push(e);\n        }\n      }\n    }\n  }\n\n  function nearestFood(e\x2C candidates\x2C extra) {\n    let best = null;\n    let bestD2 = Infinity;\n    // Itera candidates; si extra se proporciona\x2C tambien lo recorre sin merge\n    for (let pass = 0; pass < 2; pass += 1) {\n      const arr = pass === 0 ? candidates : extra;\n      if (!arr) continue;\n      for (let i = 0; i < arr.length; i += 1) {\n        const t = arr[i];\n        if (!t.alive) continue;\n        if (t.virtualA) continue;\n        if (t.dormant) continue;\n        if (e.type === TYPE.PREDATOR && isColonyProducer(t)) continue;\n        if (isColonyProducer(t) && ((t.leafCount || 0) <= 0 || t.leafEnergy <= 0.35)) continue;\n        if (t.type === TYPE.PRODUCER && t.sub !== PRODUCER.A && !canEatArmored(e\x2C t)) continue;\n        if (e.type === TYPE.PREDATOR && t.type === TYPE.CONSUMER) {\n          const sizeRatio = t.size / Math.max(1\x2C e.size);\n          if (sizeRatio > 0.85) continue;\n        }\n        const dx = torusDelta(t.x - e.x\x2C WORLD.w);\n        const dy = torusDelta(t.y - e.y\x2C WORLD.h);\n        const d2 = dx * dx + dy * dy;\n        if (d2 < bestD2) {\n          best = t;\n          bestD2 = d2;\n          if (bestD2 < 4) return best;\n        }\n      }\n    }\n    return best;\n  }\n\n  function feedingPower(e\x2C target) {\n    const mode = Number(e.feeding || 0);\n    const predatorBonus = e.type === TYPE.PREDATOR ? 2.4 : 0;\n    let power = e.size * 0.95 + e.pseudopodia * 0.72 + e.cilia * 0.18 + e.chemosense * 0.16 + predatorBonus;\n    if (mode === 1) power += e.cilia * 0.42;\n    else if (mode === 2) power += e.pseudopodia * 1.05 + e.size * 0.25;\n    else if (mode === 3) power += e.chemosense * 0.35 + e.size * 0.44;\n    else power += 0.35;\n    if (isColonyProducer(target)) power += -0.15;\n    return power;\n  }\n\n  function armorResistance(target) {\n    if (!target) return 0;\n    const plantMass = target.type === TYPE.PRODUCER && !isColonyProducer(target) ? Math.max(0\x2C target.radius - 4) * 0.045 : 0;\n    return Number(target.armor || 0) + plantMass;\n  }\n\n  function canEatArmored(e\x2C target) {\n    if (target?.virtualA) return true;\n    if (!target) return true;\n    if (target.type === TYPE.PRODUCER) {\n      if (target.sub === PRODUCER.A) return true;\n      const mobileProducerShield = target.sub === PRODUCER.C ? 0.95 : 0;\n      return feedingPower(e\x2C target) >= armorResistance(target) + mobileProducerShield;\n    }\n    // Consumers/predators: armor protege si feedingPower no supera armorResistance\n    return feedingPower(e\x2C target) >= armorResistance(target);\n  }\n\n  const nearby = [];\n  const nearbyMobile = [];\n  const mateCandidates = [];\n  const mateSeekCandidates = [];\n  const producerThreats = [];\n  const consumerThreats = [];\n  const producerCrowd = [];\n\n  function producerCCrowdFactor(e) {\n    if (!e || !isMobileProducer(e)) return 1;\n    queryNearby(e.x\x2C e.y\x2C PRODUCER_C_CROWD_RADIUS\x2C GB_MOBILE\x2C producerCrowd);\n    let close = 0;\n    for (let i = 0; i < producerCrowd.length; i += 1) {\n      const other = producerCrowd[i];\n      if (!other || other === e || !other.alive || !isMobileProducer(other)) continue;\n      close += 1;\n    }\n    if (close <= PRODUCER_C_CROWD_LIMIT) return 1;\n    return clamp(1 - (close - PRODUCER_C_CROWD_LIMIT) * 0.22\x2C 0\x2C 1);\n  }\n\n  function updateResting(e\x2C dt\x2C pressure = false) {\n    if (!hasMove(e\x2C 4)) return false;\n    if (pressure && sim.time < e.restUntil) {\n      e.restUntil = sim.time;\n      return false;\n    }\n    if (sim.time < e.restUntil) return true;\n    if (pressure || sim.time < e.restCooldown) return false;\n    const restChance = e.energy < e.maxEnergy * 0.38 ? 0.34 : 0.16;\n    if (chance(Math.min(1\x2C dt * restChance))) {\n      e.restUntil = sim.time + rand(1.8\x2C 4.6);\n      e.restCooldown = e.restUntil + rand(4\x2C 10);\n      return true;\n    }\n    return false;\n  }\n\n  function burstMultiplier(e\x2C dt\x2C pressure = false) {\n    if (!hasMove(e\x2C 5) || sim.time < e.burstCooldown || e.energy < e.maxEnergy * 0.18) return 1;\n    const p = pressure ? 0.035 : 0.007;\n    if (!chance(Math.min(1\x2C dt * p))) return 1;\n    e.burstCooldown = sim.time + rand(18\x2C 42);\n    e.energy = Math.max(0\x2C e.energy - Math.max(3\x2C e.maxEnergy * 0.045));\n    return rand(2.6\x2C 4.2);\n  }\n\n  function nearestThreat(e\x2C list) {\n    let best = null;\n    let bestD2 = Infinity;\n    for (let i = 0; i < list.length; i += 1) {\n      const t = list[i];\n      if (!t || !t.alive || t === e) continue;\n      // Skip predators that can't eat this consumer (gape limitation)\n      if (e.size / Math.max(1\x2C t.size) > 0.85) continue;\n      // Skip predators that can't penetrate this consumer's armor\n      if (!canEatArmored(t\x2C e)) continue;\n      const d2 = torusDistance2(e\x2C t);\n      if (d2 < bestD2) {\n        best = t;\n        bestD2 = d2;\n      }\n    }\n    return best;\n  }\n\n  function consumerThreatRange(e) {\n    return Math.min(260\x2C Math.max(65\x2C e.perception * 0.7 + e.chemosense * 17.5 + e.cilia * 3));\n  }\n\n  function stepProducer(e\x2C dt) {\n    e.age += dt;\n    e.cooldown -= dt * e.fertility * clamp(sim.solarEnergy\x2C 0.1\x2C 6) * 5;\n\n    if (isMobileProducer(e)) {\n      // --- Dormancy (cryptobiosis): ProducerC en escasez severa prolongada ---\n      if (e.dormant) {\n        // Metabolismo m\xednimo durante dormancia\n        e.energy -= dt * 0.001;\n        e.dormantTimer += dt;\n        // Check revival: field mass local suficiente tras 15s m\xednimo\n        if (e.dormantTimer > 15) {\n          const ci = fieldIndex(fieldCellX(e.x)\x2C fieldCellY(e.y));\n          if (sim.producerField.mass[ci] > 0.15) {\n            e.dormant = false;\n            e.dormantTimer = 0;\n          }\n        }\n        // Skip threat scan\x2C movement\x2C feeding\n        wrapInsideWorld(e);\n        return;\n      }\n      // Entrar dormancia si energ\xeda cr\xedtica por >12s acumulados\n      if (e.energy < e.maxEnergy * 0.03) {\n        e._starveTimer = (e._starveTimer || 0) + dt;\n        if (e._starveTimer > 12) {\n          e.dormant = true;\n          e.dormantTimer = 0;\n          wrapInsideWorld(e);\n          return;\n        }\n      } else {\n        e._starveTimer = 0;\n      }\n      // Throttled threat scan: full scan every 1.5s\x2C reuse cached results between scans\n      if (sim.time - (e._threatScanAt || 0) > 1.5) {\n        e._threatScanAt = sim.time;\n        if (!e._threatBuf) { e._threatBuf = []; e._threatBufB = []; }\n        queryNearby2(e.x\x2C e.y\x2C e.perception || 105\x2C TYPE.CONSUMER\x2C TYPE.PREDATOR\x2C e._threatBuf\x2C e._threatBufB);\n      }\n      let threatDx = 0\x2C threatDy = 0;\n      let threatD2 = Infinity;\n      for (let li = 0; li < 2; li += 1) {\n        const list = li === 0 ? e._threatBuf : e._threatBufB;\n        if (!list) continue;\n        for (let i = 0; i < list.length; i += 1) {\n          const c = list[i];\n          if (!c || !c.alive) continue;\n          if (!canEatArmored(c\x2C e)) continue;\n          const tdx = torusDelta(e.x - c.x\x2C WORLD.w);\n          const tdy = torusDelta(e.y - c.y\x2C WORLD.h);\n          const d2 = tdx * tdx + tdy * tdy;\n          if (d2 < threatD2) { threatDx = tdx; threatDy = tdy; threatD2 = d2; }\n        }\n      }\n      const hasThreat = threatD2 < Infinity;\n      const resting = updateResting(e\x2C dt\x2C hasThreat);\n      if (hasThreat) {\n        const away = Math.atan2(-threatDy\x2C -threatDx);\n        const pull = hasMove(e\x2C 0) ? 0.52 : hasMove(e\x2C 2) ? 0.24 : hasMove(e\x2C 3) ? 0.38 : 0.46;\n        e.angle += normalizeAngle(away - e.angle) * pull;\n        if (hasMove(e\x2C 0) && chance(0.035 * dt / BASE_DT)) e.angle += rand(-1.4\x2C 1.4);\n      } else {\n        const wander = hasMove(e\x2C 2) ? 0.65 : hasMove(e\x2C 3) ? 1.1 : 1.6;\n        e.angle += rand(-wander\x2C wander) * Math.sqrt(dt * BASE_DT);\n      }\n      if (hasMove(e\x2C 3)) e.angle += lutSin(sim.time * 1.3 + e.id) * 0.02;\n      const panic = hasThreat ? (hasMove(e\x2C 2) ? 1.34 : 1.82) : 1;\n      const moveScale = resting ? 0 : burstMultiplier(e\x2C dt\x2C hasThreat);\n      e.x += lutCos(e.angle) * e.speed * panic * moveScale * dt;\n      e.y += lutSin(e.angle) * e.speed * panic * moveScale * dt;\n      const crowdFactor = producerCCrowdFactor(e);\n      e._crowdFactor = crowdFactor;\n      const sensoryCost = (Number(e.chemosense || 0) * 0.003 + Math.max(0\x2C Number(e.perception || 0) - 40) * 0.000012) * dt * (resting ? 0.42 : 1);\n      const crowdStress = (1 - crowdFactor) * dt * 0.12;\n      const speedCost = Math.pow(Math.max(0\x2C e.speed) / 42\x2C 1.65) * 0.011; // speed metabolism for mobile ProducerC (half of consumer rate)\n      const respCost = dt * (0.008 + speedCost + (e.armor || 0) * 0.003); // basal + speed + armor cost\n      e.energy = Math.min(e.maxEnergy\x2C e.energy + dt * sim.solarEnergy * 0.12 * crowdFactor - sensoryCost - crowdStress - respCost);\n      if (Number.isFinite(Number(e.maxAge)) && e.age > e.maxAge && chance(dt / 120)) {\n        kill(e\x2C 'Productor C m\xf3vil muere por senescencia');\n        return;\n      }\n      if (e.energy <= 0) {\n        kill(e\x2C 'Productor C m\xf3vil muere por energ\xeda');\n        return;\n      }\n      wrapInsideWorld(e);\n    }\n\n    if (isColonyProducer(e)) {\n      const sun = clamp(sim.solarEnergy\x2C 0.1\x2C 6);\n      if (e.age > e.maxAge && chance(dt / 110)) {\n        kill(e\x2C 'Productor B muere por senescencia');\n        return;\n      }\n      const respCost = dt * (0.015 + e.radius * 0.0005 + (e.armor || 0) * 0.004);\n      e.energy = Math.min(e.maxEnergy\x2C e.energy + dt * sun * 0.12 - respCost);\n      if (e.energy <= 0) {\n        kill(e\x2C 'Productor B muere por inanici\xf3n');\n        return;\n      }\n      // Growth denso-dependiente: mas grande mas lento crece (self-limiting + competicion implicita)\n      const growthRate = 0.018 * (1 - (e.radius / e.maxRadius) * 0.5);\n      const radiusGrowth = Math.min(e.maxRadius - e.radius\x2C dt * sun * growthRate);\n      if (radiusGrowth > 0) {\n        // Coste energetico por crecimiento: proportional al volumen ganado (radio^2)\n        const growthCost = radiusGrowth * e.radius * 0.015;\n        if (e.energy > growthCost) {\n          e.radius += radiusGrowth;\n          e.energy -= growthCost;\n        }\n      }\n      const leafCap = 8 + e.radius * 0.9;\n      if (e.leafEnergy < leafCap) {\n        const healthFactor = clamp(e.energy / e.maxEnergy\x2C 0.2\x2C 1);\n        const leafRegen = Math.min(leafCap - e.leafEnergy\x2C dt * sun * 0.25 * healthFactor);\n        e.leafEnergy += leafRegen;\n        const leafCost = leafRegen * 0.46;\n        e.energy = Math.max(0\x2C e.energy - leafCost);\n      }\n      const leafLimit = clamp(Math.floor(2 + e.radius / 6)\x2C 2\x2C 14);\n      const leafTarget = clamp(Math.floor(e.leafEnergy / 3)\x2C 0\x2C leafLimit);\n      if (leafTarget > e.leafCount && chance(Math.min(1\x2C dt * sun * 0.6))) e.leafCount += 1;\n      // Sync: si leafEnergy cae por debajo de threshold\x2C reducir leafCount para consistencia visual\n      if (e.leafCount > leafTarget + 1 && chance(dt * 0.5)) e.leafCount -= 1;\n\n      if (sim.time >= e.competitionAt) {\n        e.competitionAt = sim.time + rand(2.5\x2C 6);\n        queryNearby(e.x\x2C e.y\x2C e.radius + e.maxRadius + 8\x2C TYPE.PRODUCER\x2C nearby);\n        for (let i = 0; i < nearby.length; i += 1) {\n          const other = nearby[i];\n          if (other === e || !other.alive || !isColonyProducer(other) || other.id < e.id) continue;\n          const minGap = (e.radius + other.radius) * 0.72;\n          if (torusDistance2(e\x2C other) > minGap * minGap) continue;\n          const winner = e.energy + e.radius >= other.energy + other.radius ? e : other;\n          const loser = winner === e ? other : e;\n          const drain = Math.min(loser.energy\x2C 1.2 + winner.radius * 0.08);\n          loser.energy -= drain;\n          loser.leafEnergy = Math.max(0\x2C loser.leafEnergy - drain * 0.18);\n          loser.leafCount = Math.max(0\x2C loser.leafCount - (drain > 1.6 ? 1 : 0));\n          winner.energy = Math.min(winner.maxEnergy\x2C winner.energy + drain * 0.55);\n          if (loser.energy <= 0.15) kill(loser\x2C 'Productor B pierde competencia por sol');\n          if (!e.alive) return;\n        }\n      }\n    }\n\n    if (e.cooldown > 0) return;\n    // Reproductive senescence for producers: sin penalty primera mitad\x2C\n    // hasta -60% en segunda mitad. task_031\n    const prodLifeFraction = e.age / e.maxAge;\n    const prodSenescence = prodLifeFraction < 0.5 ? 1 : clamp(1 - (prodLifeFraction - 0.5) * 1.2\x2C 0.4\x2C 1);\n    if (!chance(prodSenescence)) return;\n    e.cooldown = isColonyProducer(e) ? rand(40\x2C 100) : rand(30\x2C 70);\n\n    // Cap unificado: 10000 producers (antes 50000\x2C causaba\u7206\u70b8 de colonies sin limitante).\n    if (sim.creatures.length - sim.freeIds.length > 10000 && !chance(0.2)) return;\n\n    if (isColonyProducer(e)) {\n      if (e.leafCount < COLONY_MIN_LEAVES_TO_REPRODUCE || e.energy < e.maxEnergy * 0.42) return;\n      queryNearby(e.x\x2C e.y\x2C COLONY_MATE_RANGE\x2C TYPE.PRODUCER\x2C nearby);\n      let hasLargeMate = false;\n      for (let ni = 0; ni < nearby.length; ni += 1) {\n        const p = nearby[ni];\n        if (p !== e && p.sub === PRODUCER.B) { hasLargeMate = true; break; }\n      }\n      if (!hasLargeMate || !chance(0.58)) return;\n      const childLeafEnergy = Math.min(e.leafEnergy\x2C COLONY_MIN_LEAVES_TO_REPRODUCE * 3.4);\n      const childLeafCount = Math.min(e.leafCount\x2C COLONY_MIN_LEAVES_TO_REPRODUCE);\n      e.leafCount = Math.max(0\x2C e.leafCount - childLeafCount);\n      e.leafEnergy = Math.max(0\x2C e.leafEnergy - childLeafEnergy);\n      const childEnergyB = e.energy * 0.28;\n      e.energy *= 0.72;\n      // Stress-induced mutagenesis for asexual colony producers\n      const bStress = e.energy < e.maxEnergy * 0.35 ? 2.5 : 1;\n      const childB = spawnProducer({\n        sub: PRODUCER.B\x2C\n        x: mod(e.x + rand(-720\x2C 720)\x2C WORLD.w)\x2C\n        y: mod(e.y + rand(-720\x2C 720)\x2C WORLD.h)\x2C\n        energy: childEnergyB\x2C\n        radius: inheritAsexual(e\x2C 'radius'\x2C 14\x2C 40\x2C false\x2C bStress)\x2C\n        maxRadius: inheritAsexual(e\x2C 'maxRadius'\x2C 28\x2C 72\x2C false\x2C bStress)\x2C\n        armor: inheritAsexual(e\x2C 'armor'\x2C 1.2\x2C 7\x2C false\x2C bStress)\x2C\n        fertility: inheritAsexual(e\x2C 'fertility'\x2C 0.012\x2C 0.085\x2C false\x2C bStress)\x2C\n        maxAge: inheritAsexual(e\x2C 'maxAge'\x2C 7500\x2C 21500\x2C false\x2C bStress)\x2C\n        leafEnergy: childLeafEnergy\x2C\n        leafCount: childLeafCount\n      });\n      // growthCost asexual: si hijo crece radius/armor sobre padre\x2C paga coste\n      if (childB) {\n        const dRadius = childB.radius - e.radius;\n        const dArmor = (childB.armor || 0) - (e.armor || 0);\n        if (dRadius > 0) childB.energy = Math.max(1\x2C childB.energy - dRadius * 0.8);\n        if (dArmor > 0) childB.energy = Math.max(1\x2C childB.energy - dArmor * 2.5);\n      }\n      sim.births += 1;\n      return;\n    }\n\n    if (isMobileProducer(e)) {\n      if ((e._crowdFactor !== undefined ? e._crowdFactor : producerCCrowdFactor(e)) < 0.85 || e.energy < e.maxEnergy * 0.58) return;\n    }\n    const childEnergy = isMobileProducer(e) ? Math.min(8\x2C e.energy * 0.32) : undefined;\n    const spread = rand(70\x2C 180);\n    // Stress-induced mutagenesis for asexual mobile producers\n    const pStress = e.energy < e.maxEnergy * 0.35 ? 2.5 : 1;\n    const childP = spawnProducer({\n      sub: e.sub\x2C\n      x: mod(e.x + Math.cos(rand(-Math.PI\x2C Math.PI)) * spread\x2C WORLD.w)\x2C\n      y: mod(e.y + Math.sin(rand(-Math.PI\x2C Math.PI)) * spread\x2C WORLD.h)\x2C\n      radius: inheritAsexual(e\x2C 'radius'\x2C 3\x2C 10\x2C false\x2C pStress)\x2C\n      armor: inheritAsexual(e\x2C 'armor'\x2C 0\x2C 4\x2C false\x2C pStress)\x2C\n      speed: e.speed ? inheritAsexual(e\x2C 'speed'\x2C 8\x2C 62\x2C false\x2C pStress) : 0\x2C\n      perception: inheritAsexual(e\x2C 'perception'\x2C 45\x2C PRODUCER_C_MAX_PERCEPTION\x2C false\x2C pStress)\x2C\n      chemosense: inheritAsexual(e\x2C 'chemosense'\x2C 0\x2C 5\x2C false\x2C pStress)\x2C\n      movementMask: chance(0.08) ? inheritMovementMask(e\x2C { movementMask: 1 << Math.floor(rand(0\x2C MOVE.length)) }) : movementMaskFromLegacy(e)\x2C\n      fertility: inheritAsexual(e\x2C 'fertility'\x2C 0.006\x2C 0.075\x2C false\x2C pStress)\x2C\n      maxAge: inheritAsexual(e\x2C 'maxAge'\x2C 3500\x2C 12000\x2C false\x2C pStress)\x2C\n      ...(childEnergy != null ? { energy: childEnergy } : {})\n    });\n    // growthCost asexual: si hijo crece radius/armor sobre padre\x2C paga coste\n    if (childP && isMobileProducer(e)) {\n      const dRadius = childP.radius - e.radius;\n      const dArmor = (childP.armor || 0) - (e.armor || 0);\n      if (dRadius > 0) childP.energy = Math.max(0.5\x2C childP.energy - dRadius * 0.6);\n      if (dArmor > 0) childP.energy = Math.max(0.5\x2C childP.energy - dArmor * 1.5);\n    }\n    e.energy *= 0.68;\n    sim.births += 1;\n  }\n\n  function steerCreature(e\x2C dt\x2C food\x2C threat = null) {\n    const pressure = Boolean(threat || (food && e.type === TYPE.PREDATOR));\n    const resting = updateResting(e\x2C dt\x2C pressure);\n    e._resting = resting;\n    let turnNoise = hasMove(e\x2C 0) ? 2.5 : hasMove(e\x2C 2) ? 1.2 : 0.8;\n    // Dispersion density-dependent: alta densidad local aumenta wander para redistribuir.\n    if (e.type === TYPE.CONSUMER && (e._crowdDensity || 0) > 8) {\n      turnNoise *= 1 + Math.min((e._crowdDensity - 8) * 0.12\x2C 1.5);\n    }\n    e.angle += rand(-turnNoise\x2C turnNoise) * Math.sqrt(dt * BASE_DT);\n\n    if (threat) {\n      const { dx\x2C dy } = torusVector(e\x2C threat);\n      const desired = Math.atan2(-dy\x2C -dx);\n      const distance = Math.sqrt(dx * dx + dy * dy);\n      const urgency = clamp(1 - distance / Math.max(1\x2C consumerThreatRange(e))\x2C 0.18\x2C 1);\n      const pull = hasMove(e\x2C 1) ? 0.38 : hasMove(e\x2C 0) ? 0.31 : hasMove(e\x2C 3) ? 0.26 : 0.20;\n      e.angle += normalizeAngle(desired - e.angle) * pull * (0.75 + urgency * 0.65);\n      if (hasMove(e\x2C 0) && chance(0.045 * dt / BASE_DT)) e.angle += rand(-0.7\x2C 0.7);\n    } else if (food && (hasMove(e\x2C 1) || e.chemosense > 1.3)) {\n      const { dx\x2C dy } = torusVector(e\x2C food);\n      const desired = Math.atan2(dy\x2C dx);\n      const pull = clamp(e.chemosense * 0.09\x2C 0.04\x2C 0.32);\n      e.angle += normalizeAngle(desired - e.angle) * pull;\n    }\n\n    if (hasMove(e\x2C 3)) {\n      e.angle += lutSin(sim.time * 0.9 + e.id) * 0.018;\n    }\n\n    if (resting) {\n      wrapInsideWorld(e);\n      return;\n    }\n\n    const ciliaPulse = 1 + lutSin(sim.time * 5 + e.id) * (e.cilia * 0.015);\n    const burst = burstMultiplier(e\x2C dt\x2C pressure);\n    const panic = threat ? (hasMove(e\x2C 2) ? 1.16 : hasMove(e\x2C 3) ? 1.28 : 1.46) : 1;\n    if (threat) e._hadPanic = panic; // flag for next step's metabolism surcharge\n    // Vegetation refuge: zonas con alta densidad de producerField ralentizan criaturas\n    let vegFactor = 1;\n    if (sim.producerField.mass.length) {\n      const fMass = sim.producerField.mass[fieldIndex(fieldCellX(e.x)\x2C fieldCellY(e.y))];\n      if (fMass > 1.2) {\n        vegFactor = e.type === TYPE.PREDATOR ? 0.6 : 0.85;\n      }\n    }\n    // Dispersion density-dependent: ligero speed boost cuando alta densidad local.\n    let dispersionFactor = 1;\n    if (e.type === TYPE.CONSUMER && (e._crowdDensity || 0) > 8 && !threat) {\n      dispersionFactor = 1 + Math.min((e._crowdDensity - 8) * 0.02\x2C 0.3);\n    }\n    e.x += lutCos(e.angle) * e.speed * ciliaPulse * burst * panic * vegFactor * dispersionFactor * dt;\n    e.y += lutSin(e.angle) * e.speed * ciliaPulse * burst * panic * vegFactor * dispersionFactor * dt;\n    wrapInsideWorld(e);\n  }\n\n  function feedConsumer(e\x2C target\x2C dt) {\n    if (!target) return false;\n    if (target.virtualCarcass) return eatCarcass(e\x2C target\x2C dt);\n    if (!target.alive) return false;\n    if (target.dormant) return false;\n    // Digestion (task_300): predator digiriendo no puede cazar\n    if (e.type === TYPE.PREDATOR && (e.digestTimer || 0) > 0) return false;\n    if (target.virtualA) return grazeProducerDensity(e\x2C dt);\n    const dx = torusDelta(target.x - e.x\x2C WORLD.w);\n    const dy = torusDelta(target.y - e.y\x2C WORLD.h);\n    const eatRange = e.radius + target.radius + (e.feeding === 1 ? e.cilia * 2.2 : 3);\n    if (dx * dx + dy * dy > eatRange * eatRange) return false;\n\n    if (isColonyProducer(target)) {\n      if (e.type === TYPE.PREDATOR) return false;\n      if ((e.grazeCooldown || 0) > 0) return false;\n      if ((target.leafCount || 0) <= 0 || target.leafEnergy <= 0.35 || !canEatArmored(e\x2C target)) return false;\n      const maxBite = 1.0 + e.size * 0.48 + e.pseudopodia * 0.32 + (e.feeding === 2 ? 0.7 : 0) + (e.feeding === 3 ? 0.5 : 0);\n      const bite = Math.min(target.leafEnergy * 0.4\x2C maxBite);\n      e.grazeCooldown = rand(0.3\x2C 0.8);\n      target.leafEnergy -= bite;\n      target.leafCount = Math.max(0\x2C (target.leafCount || 0) - 1);\n      // Colony energy drain: directo (0.30) + indirecto via leafEnergy regen (0.46)\n      // Coste total colonia = bite * 0.76. Gain capado a 3.0x bite (ratio ~4:1\x2C eficiencia trofica ~25%)\n      target.energy = Math.max(0\x2C target.energy - bite * 0.30);\n      const gainCol = Math.min(bite * 3.0\x2C 18);\n      const actualGainCol = Math.min(gainCol\x2C e.maxEnergy - e.energy);\n      const newEng = e.energy + actualGainCol;\n      sim.mobileEnergySum += actualGainCol;\n      e.energy = newEng;\n      sim.flowAccum.colonyFeed += actualGainCol;\n      return true;\n    }\n\n    if (!canEatArmored(e\x2C target)) return false;\n\n    // Holling Type II: handling time tras kill exitoso limita throughput maximo.\n    // Un predator no puede encadenar kills sin tiempo de procesado.\n    // Esto satura la tasa de consumo cuando la densidad de presas es alta.\n    if (e.huntCooldown > 0) return false;\n\n    // Predator satiation: depredadores saciados no cazan.\n    // >95% energy: ignoran presas (saciados). 85-95%: fallan 50% capturas.\n    // Reduce overpredacion y sumidero energetico en boom phases.\n    if (e.type === TYPE.PREDATOR && e.energy > e.maxEnergy * 0.95) return false;\n    if (e.type === TYPE.PREDATOR && e.energy > e.maxEnergy * 0.85 && chance(0.5)) return false;\n\n    // Chase success: depredadores no siempre matan al contacto.\n    // Presas rapidas y pequenas escapan mas. Presas lentas y grandes casi siempre caen.\n    // speedRatio = predator speed vs prey speed. sizeAdv = ventaja de talla del predator.\n    if (e.type === TYPE.PREDATOR && target.type === TYPE.CONSUMER) {\n      const predSpeed = Math.sqrt(e.vx * e.vx + e.vy * e.vy);\n      const preySpeed = Math.sqrt(target.vx * target.vx + target.vy * target.vy);\n      const speedRatio = predSpeed / Math.max(0.1\x2C preySpeed);\n      const sizeAdv = clamp(e.size / Math.max(1\x2C target.size) - 1\x2C 0\x2C 2);\n      const chaseSuccess = clamp(speedRatio * 0.25 + sizeAdv * 0.2 + 0.35\x2C 0.25\x2C 0.92);\n      if (!chance(chaseSuccess)) {\n        // Presa escapa: predator pierde tiempo de persecucion fallida\n        e.huntCooldown = 0.5 + rand(0\x2C 0.3);\n        return false;\n      }\n    }\n\n    // Gape-limitation: depredadores no pueden comer presas mucho mas grandes\n    let gapeFactor = 1;\n    if (e.type === TYPE.PREDATOR && target.type === TYPE.CONSUMER) {\n      const sizeRatio = target.size / Math.max(1\x2C e.size);\n      if (sizeRatio > 0.85) return false; // presa demasiado grande\n      if (sizeRatio > 0.5) gapeFactor = Math.min(1.0\x2C 0.85 / sizeRatio); // penalty progresivo\x2C nunca bonus\n    } else if (e.type === TYPE.PREDATOR && target.type === TYPE.PREDATOR) {\n      // Intraguild predation: solo presas claramente mas peque\xf1as\x2C gain reducido\n      const sizeRatio = target.size / Math.max(1\x2C e.size);\n      if (sizeRatio > 0.85) return false;\n      gapeFactor = 0.5; // canibalismo es menos eficiente\n    }\n\n    const rawGain = e.type === TYPE.PREDATOR\n      ? target.type === TYPE.PRODUCER\n        ? 62 + target.radius * 3.2 + target.energy * 0.35\n        : target.type === TYPE.PREDATOR\n          ? 46 + target.size * 8 + target.reserves * 3.5 // intraguild: 50% efficiency\n          : 92 + target.size * 16 + target.reserves * 7\n      : target.sub === PRODUCER.C\n          ? Math.min(target.energy * 1.8\x2C 36)\n          : 7.5;\n    // Cap gain to prevent energy creation in trophic transfers\n    const maxTransfer = e.type === TYPE.PREDATOR\n      ? target.type === TYPE.PRODUCER\n        ? target.energy * 1.0   // predator->ProducerC: max 1x prey energy (no creacion)\n        : target.type === TYPE.PREDATOR\n          ? target.energy * 0.5  // intraguild: max 0.5x (50% loss\x2C canibalismo costoso)\n          : target.energy * 1.3   // predator->consumer: max 1.3x (30% ecological loss)\n      : target.energy * 1.8;    // consumer->ProducerC already capped above\n    // Type III functional response: hunting efficiency cae cuando presas escasean.\n    // huntingEff = density^2 / (density^2 + halfSat^2). halfSat=6 => 50% efficiency a 6 presas.\n    // Refugio de baja densidad: presas raras sobreviven mejor\x2C estabiliza boom-bust.\n    let typeIII = 1;\n    if (e.type === TYPE.PREDATOR && target.type === TYPE.CONSUMER) {\n      const density = e._localPreyDensity || 6;\n      typeIII = (density * density) / (density * density + 36); // halfSat=6\n    }\n    // Beddington-DeAngelis predator interference: a alta densidad de predators\x2C\n    // cada uno caza menos por interferencia entre competidores.\n    // gain *= 60/predatorCount cuando predatorCount>60. Baja densidad: sin efecto.\n    const bdaInterference = (e.type === TYPE.PREDATOR && sim.predatorCount > 60)\n      ? 60 / sim.predatorCount\n      : 1;\n    const gain = Math.min(rawGain\x2C maxTransfer) * gapeFactor * typeIII * bdaInterference;\n\n    // Descuento gain de target ANTES de kill para evitar doble conteo energetico\n    // (sin esto\x2C kill lee target.energy intacta y crea carcass con energy ya consumida)\n    target.energy = Math.max(0\x2C target.energy - gain);\n    // Si target es mobile\x2C su energy ya se resto del sum via kill(). Si es producer\x2C no esta en el sum.\n    const actualGainPred = Math.min(gain\x2C e.maxEnergy - e.energy);\n    const newEng = e.energy + actualGainPred;\n    sim.mobileEnergySum += actualGainPred;\n    e.energy = newEng;\n    if (e.type === TYPE.PREDATOR) sim.flowAccum.predation += actualGainPred;\n    else sim.flowAccum.prodCGraze += actualGainPred;\n    // Holling Type II handling time: el predator pierde tiempo procesando la presa.\n    // Escala con el tamano de la presa: presas grandes = mas handling.\n    // Consumer->ProducerC: handling corto (1.5-2.5s). Predator->Consumer/Producer: mas largo.\n    const preySize = e.type === TYPE.PREDATOR\n      ? (target.type === TYPE.PRODUCER ? target.radius * 0.1 : target.size * 0.35)\n      : 0;\n    e.huntCooldown = e.type === TYPE.PREDATOR\n      ? 1.8 + preySize + rand(0\x2C 0.8)   // 1.8-3.5s para predators\n      : 1.2 + rand(0\x2C 0.5);              // 1.2-1.7s para consumers (ProducerC)\n    // Digestion timer (task_300): predator entra en digestion 8-15s tras kill.\n    // Speed reducida\x2C metab aumentada\x2C no busca comida. Estabiliza dinamicas depredador-presa.\n    if (e.type === TYPE.PREDATOR) {\n      e.digestTimer = 8 + rand(0\x2C 7);\n    }\n    // Sloppy feeding (microbial loop): 12% de energia de presa se pierde al producerField.\n    // Simula DOC leakage durante predacion. Cria hotspots de fertilidad en zonas de caza.\n    if (e.type === TYPE.PREDATOR && !target.virtualA) {\n      addProducerDensity(target.x\x2C target.y\x2C gain * 0.12 * 0.02\x2C 50);\n    }\n    // ProducerC supervivencia al grazing: como ProducerB (leaves)\x2C ProducerC no muere\n    // al ser comido por consumers si le queda energia. Solo predators kill siempre.\n    // Esto convierte ProducerC en recurso renovable\x2C no kill-on-contact.\n    if (e.type === TYPE.PREDATOR || target.type !== TYPE.PRODUCER || target.sub !== PRODUCER.C || target.energy <= 0) {\n      kill(target\x2C e.type === TYPE.PREDATOR ? (target.type === TYPE.PRODUCER ? 'Depredador consume productor' : 'Depredador consume consumidor') : null);\n    }\n    return true;\n  }\n\n  function reproduceMobile(e\x2C type\x2C cachedMate) {\n    // Population cap: contar SOLO mobiles (consumers+predators)\x2C no producers.\n    // Antes contaba todas las criaturas incluyendo colonies+ProducerC\x2C\n    // lo que bloqueaba reproduccion mobile cuando habia muchos producers.\n    const mobileCount = sim.liveConsumerCount + sim.predatorCount;\n    if (mobileCount > 5000 && !chance(0.2)) return;\n    // Density-dependent reproduction (carrying capacity):\n    //_factor logistico reduce fert cuando pop > K/2. frena boom suavemente.\n    const K = type === TYPE.PREDATOR ? 300 : 2000;\n    const pop = type === TYPE.PREDATOR ? sim.predatorCount : sim.liveConsumerCount;\n    if (pop > K * 0.5) {\n      const over = (pop - K * 0.5) / (K * 0.5); // 0 en K/2\x2C 1 en K\x2C >1 sobre K\n      const fertilityFactor = 1 / (1 + over * over);\n      if (!chance(fertilityFactor)) return;\n    }\n    // Umbral reproductivo: depredadores mas bajo (0.60 base\x2C 0.50 en crisis)\n    // Allee effect: umbral reproductivo mas bajo en baja densidad para ambos tipos.\n    // Consumers: <30 pop -> 0.55 vs 0.72 normal. Predators: <40 -> 0.50 vs 0.60.\n    const lowPop = type === TYPE.PREDATOR ? sim.predatorCount < 40 : sim.liveConsumerCount < 30;\n    const reproThreshold = type === TYPE.PREDATOR\n      ? (lowPop ? 0.50 : 0.60)\n      : (lowPop ? 0.55 : 0.72);\n    if (e.energy < e.maxEnergy * reproThreshold || e.cooldown > 0) return;\n    // Reproductive senescence: sin penalty primera mitad de vida\x2C\n    // penalty progresivo (hasta -60%) en segunda mitad. task_031\n    const lifeFraction = e.age / e.maxAge;\n    const senescenceFactor = lifeFraction < 0.5 ? 1 : clamp(1 - (lifeFraction - 0.5) * 1.2\x2C 0.4\x2C 1);\n    if (!chance(senescenceFactor)) return;\n    // Allee effect: ampliar rango de mate search en baja densidad.\n    // Consumers: <30 pop -> 1.5x range. Predators: <40 -> 1.5x range.\n    const alleeBoost = lowPop ? 1.5 : 1;\n    const mateRange = type === TYPE.PREDATOR ? Math.min(450\x2C e.perception * 1.2 * alleeBoost) : e.perception * 0.8 * alleeBoost;\n    let mate = null;\n    if (cachedMate && cachedMate.alive && cachedMate.energy > cachedMate.maxEnergy * 0.55 && cachedMate.cooldown <= 0) {\n      mate = cachedMate;\n    } else {\n      queryNearby(e.x\x2C e.y\x2C mateRange\x2C type\x2C mateCandidates);\n      for (let i = 0; i < mateCandidates.length; i += 1) {\n        const c = mateCandidates[i];\n        if (c !== e && c.alive && c.energy > c.maxEnergy * 0.55 && c.cooldown <= 0) {\n          mate = c;\n          break;\n        }\n      }\n    }\n    if (!mate) return;\n    const child = childFrom(e\x2C mate\x2C type);\n    const parentLoss = e.energy * (1 - 0.58) + mate.energy * (1 - 0.62);\n    e.energy *= 0.58;\n    mate.energy *= 0.62;\n    sim.mobileEnergySum -= parentLoss;\n    sim.flowAccum.reproduction += parentLoss;\n    e.cooldown = rand(18\x2C 55) / e.fertility;\n    mate.cooldown = rand(18\x2C 55) / mate.fertility;\n    if (sim.births % 12 === 0) {\n      if (LOG_EVENTS) logEvent(`${type === TYPE.PREDATOR ? 'Depredador' : 'Consumidor'} nace por recombinaci\xf3n: tama\xf1o ${child.size.toFixed(1)}\x2C flagelos ${child.flagella}\x2C cilios ${child.cilia}`\x2C 'birth');\n    }\n  }\n\n  function findMateTarget(e\x2C type) {\n    // Busqueda de pareja: Allee effect en baja densidad para ambos tipos.\n    const lowPopFind = type === TYPE.PREDATOR ? sim.predatorCount < 40 : sim.liveConsumerCount < 30;\n    const mateSearchThreshold = type === TYPE.PREDATOR\n      ? (lowPopFind ? 0.45 : 0.55)\n      : (lowPopFind ? 0.55 : 0.68);\n    if (e.energy < e.maxEnergy * mateSearchThreshold || e.cooldown > 0) return null;\n    const alleeR = lowPopFind ? 1.5 : 1;\n    const radius = type === TYPE.PREDATOR ? Math.min(550\x2C e.perception * 1.55 * alleeR) : e.perception * 0.9 * alleeR;\n    queryNearby(e.x\x2C e.y\x2C radius\x2C type\x2C mateSeekCandidates);\n    let best = null;\n    let bestD2 = Infinity;\n    for (let i = 0; i < mateSeekCandidates.length; i += 1) {\n      const c = mateSeekCandidates[i];\n      if (c === e || !c.alive || c.energy < c.maxEnergy * 0.50 || c.cooldown > 0) continue;\n      const d2 = torusDistance2(e\x2C c);\n      if (d2 < bestD2) {\n        best = c;\n        bestD2 = d2;\n      }\n    }\n    return best;\n  }\n\n  function stepMobile(e\x2C dt) {\n    e.age += dt;\n    e.cooldown -= dt;\n    if (e.grazeCooldown > 0) e.grazeCooldown -= dt;\n    if (e.huntCooldown > 0) e.huntCooldown -= dt;\n    if (e.feedHotspotTTL > 0) e.feedHotspotTTL -= dt;\n    if (e.digestTimer > 0) e.digestTimer -= dt;\n    // resting: usar valor del step anterior (post-updateResting). Siempre correcto\n    // porque updateResting corre al final de steerCreature del step previo.\n    // Mismo patron que _hadPanic. Primer step: _resting undefined -> false -> 7.5 (correcto).\n    const resting = e._resting || false;\n    // Metabolismo adaptativo: reduccion gradual para depredadores en baja cuenta\n    // Antes era *=0.5 binario que hacia preds inmortales (84min sin comer)\n    let metabFactor = resting ? 1.5 : 6.5;\n    if (e.type === TYPE.PREDATOR) {\n      metabFactor *= 0.85 + 0.15 * clamp(sim.predatorCount / 60\x2C 0\x2C 1);\n    }\n    // Metabolismo circadiano: 25% menos en pico nocturno compensa deficit de producers\n    if (sim.dayNightEnabled) {\n      const sp = Math.sin(sim.dayNightPhase);\n      if (sp < 0) metabFactor *= 1 + 0.25 * sp;\n    }\n    // Metabolic depression anti-extincion: organismos en inanicion reducen metabolismo.\n    // Coma metabolico a <3% energy (x0.25)\x2C depression severa a <8% (x0.45).\n    // Extiende supervivencia 2-4x en famine\x2C permite recovery si encuentra comida.\n    // Reserves (fat stores) mejoran depression: hasta -20% extra metabFactor.\n    const reserveBonus = 1 - Math.min(0.20\x2C (e.reserves || 0) * 0.012);\n    if (e.energy < e.maxEnergy * 0.03) metabFactor *= 0.25 * reserveBonus;\n    else if (e.energy < e.maxEnergy * 0.08) metabFactor *= 0.45 * reserveBonus;\n    // Senescence cost (Gompertz): criaturas viejas pagan mas metabolismo.\n    // >60% effMaxAge: hasta +50% metab. Acelera turnover\x2C previene inmortales.\n    const gompertzAge = e.maxAge * (1 - (e.oxidativeDamage || 0));\n    if (gompertzAge > 0 && e.age > gompertzAge * 0.6) {\n      metabFactor *= 1 + ((e.age - gompertzAge * 0.6) / (gompertzAge * 0.4)) * 0.5;\n    }\n    // Panic metabolism: huida tiene coste energetico extra (sprint anaerobico).\n    // Usa flag del step anterior (e._hadPanic) porque threat aun no se ha calculado aqui.\n    // panic=1.16 -> +8% metab\x2C panic=1.46 -> +64% metab\x2C panic=1.82 -> +201% metab.\n    if (e._hadPanic) {\n      metabFactor *= 1 + (e._hadPanic - 1) * (e._hadPanic - 1) * 3;\n      e._hadPanic = 0;\n    }\n    // Crowding stress (anti boom-bust): consumers en alta densidad local pagan mas metabolismo.\n    // Throttled cada 3s para evitar coste de queryNearby cada step.\n    // >8 vecinos en 120px: +3% metab por vecino extra. Simula competencia y stress por densidad.\n    if (e.type === TYPE.CONSUMER) {\n      e._crowdCheckTimer = (e._crowdCheckTimer || 0) + dt;\n      if (e._crowdCheckTimer >= 3) {\n        e._crowdCheckTimer = 0;\n        queryNearby(e.x\x2C e.y\x2C 120\x2C TYPE.CONSUMER\x2C nearby);\n        const neighbors = nearby.length;\n        e._crowdDensity = neighbors > 8 ? neighbors : 0;\n      }\n      if (e._crowdDensity > 8) {\n        metabFactor *= 1 + (e._crowdDensity - 8) * 0.03;\n      }\n    }\n    // Food-stress metabolism damping (Lotka-Volterra negative feedback):\n    // Criaturas que fallan >=10 intentos consecutivos de comida reducen metab 15%.\n    // Previene oscilaciones extremas: poblacion alta -> menos comida -> metab bajo -> menos muertes.\n    if ((e._foodFailCount || 0) >= 10) metabFactor *= 0.85;\n    // Reduccion metabolica nocturna: de noche el metabolismo baja (ritmos circadianos)\n    if (sim.dayNightEnabled) {\n      metabFactor *= 0.75 + 0.25 * clamp(sim.solarEnergy / sim.solarEnergyBase\x2C 0\x2C 1);\n    }\n    // Digestion surcharge (task_300): predator digiriendo paga +30% metabolism\n    if ((e.digestTimer || 0) > 0 && e.type === TYPE.PREDATOR) {\n      metabFactor *= 1.3;\n    }\n    // Momentum metabolico (EMA): suaviza transiciones de metabFactor\n    // 70% valor actual + 30% valor anterior. Evita saltos instantaneos.\n    if (!e._metabFactorSmooth) e._metabFactorSmooth = metabFactor;\n    e._metabFactorSmooth = e._metabFactorSmooth * 0.3 + metabFactor * 0.7;\n    const smoothFactor = e._metabFactorSmooth;\n    const metabCost = e.metabolism * dt * smoothFactor;\n    e.energy -= metabCost;\n    sim.mobileEnergySum -= metabCost;\n    sim.flowAccum.metabolism += metabCost;\n    // Oxidative damage (Rate of Living Theory): metabolism acumula ROS damage.\n    // Reduce effective maxAge hasta -50%. Criaturas high-performance viven menos.\n    // Reset en offspring (nacen limpios). Press towards metabolic efficiency.\n    e.oxidativeDamage = Math.min(0.5\x2C e.oxidativeDamage + metabCost * 0.0002);\n    // --- Consumer dormancy (diapausa): anti-extincion en crisis severa prolongada ---\n    // Consumer a <2% energy por >20s entra dormancia. Metabolismo minimo\x2C sin movimiento.\n    // Despierta cuando hay campo denso cerca. Protege population bottleneck.\n    if (e.type === TYPE.CONSUMER) {\n      if (e.dormant) {\n        e.energy -= dt * 0.002; // metabolism minimo\n        sim.mobileEnergySum -= dt * 0.002;\n        e.dormantTimer += dt;\n        if (e.dormantTimer > 15) {\n          const ci = fieldIndex(fieldCellX(e.x)\x2C fieldCellY(e.y));\n          if (sim.producerField.mass[ci] > 0.2) {\n            e.dormant = false;\n            e.dormantTimer = 0;\n          }\n        }\n        wrapInsideWorld(e);\n        return; // skip comportamiento\x2C movimiento\x2C reproduccion\n      }\n      if (e.energy < e.maxEnergy * 0.02) {\n        e._starveTimer = (e._starveTimer || 0) + dt;\n        if (e._starveTimer > 20) {\n          e.dormant = true;\n          e.dormantTimer = 0;\n          wrapInsideWorld(e);\n          return;\n        }\n      } else {\n        e._starveTimer = 0;\n      }\n    }\n    // DOC excretion: recicla 2.5% del metabCost al producerField (microbial loop)\n    if (metabCost > 0.01) {\n      const excretion = metabCost * 0.025;\n      addProducerDensity(e.x\x2C e.y\x2C excretion\x2C 60);\n      sim.flowAccum.excretion += excretion;\n    }\n    // Thermal entropy: disipacion adaptativa si el sistema tiene inflacion energetica\n    if (sim.thermalDecayRate > 0 && (e.type === TYPE.CONSUMER || e.type === TYPE.PREDATOR)) {\n      const thermalLoss = e.energy * sim.thermalDecayRate * dt;\n      e.energy -= thermalLoss;\n      sim.mobileEnergySum -= thermalLoss;\n      sim.flowAccum.thermal += thermalLoss;\n    }\n    const effMaxAge = e.maxAge * (1 - e.oxidativeDamage);\n    if (Number.isFinite(effMaxAge) && e.age > effMaxAge && chance(dt / (e.type === TYPE.PREDATOR ? 150 : 95))) {\n      kill(e\x2C e.type === TYPE.PREDATOR ? 'Depredador muere por senescencia' : 'Consumidor muere por senescencia');\n      return;\n    }\n\n    // Starvation progresivo: reduce capacidades con baja energia\n    // NOTA: fertility *= 0.3 en este bloque NO afecta cooldown en reproduceMobile\n    // porque el threshold de repro (72% maxEnergy) es incompatible con starvation (<15%).\n    // El save/restore de origFertility abajo es belt-and-suspenders.\n    var origSpeed = e.speed;\n    var origPerception = e.perception;\n    var origFertility = e.fertility;\n    var canReproduce = true;\n    if (e.energy < e.maxEnergy * 0.05) {\n      e.speed *= 0.3;\n      e.perception *= 0.7;\n      canReproduce = false;\n      e.starved = 2;\n    } else if (e.energy < e.maxEnergy * 0.15) {\n      e.speed *= 0.6;\n      e.perception *= 0.8;\n      e.fertility *= 0.3;\n      e.starved = 1;\n    } else {\n      e.starved = 0;\n    }\n\n    let food = null;\n    let steeringTarget = null;\n    let threat = null;\n    let cachedMate = null; // reuso de findMateTarget para reproduceMobile\n    // Digestion (task_300): predator digiriendo no busca comida. Speed ya reducida abajo.\n    const digesting = (e.digestTimer || 0) > 0 && e.type === TYPE.PREDATOR;\n    if (digesting) e.speed *= 0.7;\n    if (e.type === TYPE.PREDATOR) {\n      // queryNearby2: 1 sola pasada de grid para CONSUMER + GB_MOBILE (task_890).\n      // Antes eran 2 queries separadas con radii distintos. Ahora 1 pasada + filtrado por r2.\n      queryNearby2(e.x\x2C e.y\x2C e.perception\x2C TYPE.CONSUMER\x2C GB_MOBILE\x2C nearby\x2C nearbyMobile);\n      const consumerCount = nearby.length;\n      e._localPreyDensity = consumerCount;\n      // Digestion (task_300): predator digiriendo no busca comida\n      if (!digesting) {\n      food = consumerCount >= 3 ? nearestFood(e\x2C nearby) : null;\n      if (!food) {\n        const carrion = nearestCarcassFood(e\x2C e.perception * 0.85);\n        if (carrion) {\n          food = carrion;\n        } else if (consumerCount > 0) {\n          food = nearestFood(e\x2C nearby);\n        }\n      }\n      if (!food) {\n        // Buscar ProducerC en nearbyMobile (ya poblado por queryNearby2).\n        // Filtrar por radio reducido (perception*0.72) para mantener comportamiento.\n        const plantR2 = (e.perception * 0.72) * (e.perception * 0.72);\n        let bestPlant = null;\n        let bestD2 = Infinity;\n        for (let i = 0; i < nearbyMobile.length; i += 1) {\n          const p = nearbyMobile[i];\n          if (!p.alive || p.sub === PRODUCER.A || isColonyProducer(p) || !canEatArmored(e\x2C p)) continue;\n          const d2 = torusDistance2(e\x2C p);\n          if (d2 < bestD2 && d2 <= plantR2) {\n            bestPlant = p;\n            bestD2 = d2;\n          }\n        }\n        food = bestPlant;\n      }\n      // Intraguild predation: si no encontro comida y predatorCount>25\x2C cazar predators mas peque\xf1os\n      if (!food && sim.predatorCount > 25) {\n        queryNearby(e.x\x2C e.y\x2C e.perception * 0.6\x2C TYPE.PREDATOR\x2C nearby);\n        let bestPrey = null;\n        let bestPreyD2 = Infinity;\n        for (let i = 0; i < nearby.length; i += 1) {\n          const p = nearby[i];\n          if (p === e || !p.alive) continue;\n          const sizeRatio = p.size / e.size;\n          if (sizeRatio > 0.85) continue; // solo presas claramente m\xe1s peque\xf1as\n          const d2 = torusDistance2(e\x2C p);\n          if (d2 < bestPreyD2) {\n            bestPrey = p;\n            bestPreyD2 = d2;\n          }\n        }\n        if (bestPrey) food = bestPrey;\n      }\n      } // end if (!digesting)\n      // Si el predator tiene energia alta y no hay threat\x2C prioriza reproducir sobre cazar\n      if (food && e.energy > e.maxEnergy * 0.8 && !threat) {\n        cachedMate = findMateTarget(e\x2C TYPE.PREDATOR);\n        steeringTarget = cachedMate || food;\n      } else {\n        steeringTarget = food || (cachedMate = findMateTarget(e\x2C TYPE.PREDATOR));\n      }\n    } else {\n      queryNearby2(e.x\x2C e.y\x2C e.perception\x2C GB_COLONY\x2C GB_MOBILE\x2C nearby\x2C nearbyMobile);\n      const entityFood = nearestFood(e\x2C nearby\x2C nearbyMobile);\n      // Spatial memory: cache bestProducerDensityTarget result to avoid scanning\n      // the field grid every frame. TTL-based; rescan when expired or energy low.\n      let fieldFood = null;\n      if ((e.grazeCooldown || 0) <= 0) {\n        if (e.feedHotspotTTL > 0 && e.energy > e.maxEnergy * 0.25) {\n          // Use cached hotspot \u2014 skip expensive grid scan\n          _scratchFieldFood.sub = PRODUCER.A;\n          _scratchFieldFood.radius = Math.max(sim.producerField.cellW\x2C sim.producerField.cellH) * 0.45;\n          _scratchFieldFood.x = e.feedHotspotX;\n          _scratchFieldFood.y = e.feedHotspotY;\n          _scratchFieldFood.density = 0.5; // approximate; refreshed on next scan\n          fieldFood = _scratchFieldFood;\n        } else {\n          fieldFood = bestProducerDensityTarget(e.x\x2C e.y\x2C e.perception);\n          if (fieldFood) {\n            e.feedHotspotX = fieldFood.x;\n            e.feedHotspotY = fieldFood.y;\n            e.feedHotspotTTL = rand(2.5\x2C 5.0); // cache 2.5-5s\n          } else {\n            e.feedHotspotTTL = 0;\n          }\n        }\n      }\n      food = entityFood;\n      if (fieldFood) {\n        if (!entityFood) food = fieldFood;\n        else {\n          // ROI-based foraging: elegir comida por retorno energetico/distancia\x2C no solo distancia.\n          // Estima gain one-shot del entity vs gain rate sostenido del campo.\n          const edx = torusDelta(entityFood.x - e.x\x2C WORLD.w);\n          const edy = torusDelta(entityFood.y - e.y\x2C WORLD.h);\n          const fdx = torusDelta(fieldFood.x - e.x\x2C WORLD.w);\n          const fdy = torusDelta(fieldFood.y - e.y\x2C WORLD.h);\n          const eDist = Math.sqrt(edx * edx + edy * edy) + 1;\n          const fDist = Math.sqrt(fdx * fdx + fdy * fdy) + 1;\n          // Gain estimado del entity: ProducerC ~energy*1.8\x2C colony/ProducerA ~7.5-18\n          const entityGain = entityFood.sub === PRODUCER.C\n            ? Math.min(entityFood.energy * 1.8\x2C 36)\n            : isColonyProducer(entityFood) ? 12 : 7.5;\n          // Gain rate del campo: ~1.1/s en zona rica. score = gain*tiempoHorizonte.\n          // Horizonte 8s: cuanto tardaria en encontrar otra comida si ignora esta.\n          const fieldGainRate = 1.1;\n          const fieldHorizon = 8;\n          // feeding bias: grazers (0) prefieren campo\x2C phagocytes (2) prefieren presas\n          const feedingPref = e.feeding === 0 ? 1.4 : e.feeding === 2 ? 0.6 : 1.0;\n          const entityScore = entityGain / eDist;\n          const fieldScore = (fieldGainRate * fieldHorizon * feedingPref) / fDist;\n          if (fieldScore > entityScore) food = fieldFood;\n        }\n      }\n      if (!food && e.energy < e.maxEnergy * 0.42) food = nearestCarcassFood(e\x2C e.perception * 0.65);\n      if (e.starved !== 2 || food) {\n        queryNearby(e.x\x2C e.y\x2C consumerThreatRange(e)\x2C TYPE.PREDATOR\x2C consumerThreats);\n        threat = nearestThreat(e\x2C consumerThreats);\n      }\n      // Fear ecology (NCE): consumers grazan 40% menos cuando detectan predator cercano\n      e.fearFactor = threat ? 0.6 : 1;\n      steeringTarget = food;\n    }\n    steerCreature(e\x2C dt\x2C steeringTarget\x2C threat);\n    // Food-stress tracking: medir si consiguio energia neta este step\n    const _energyBeforeFeed = e.energy;\n    if (food) feedConsumer(e\x2C food\x2C dt);\n    // Actualizar contador de fallos consecutivos de alimentacion\n    if (e.energy > _energyBeforeFeed) e._foodFailCount = 0;\n    else e._foodFailCount = (e._foodFailCount || 0) + 1;\n    // Check de muerte por energia despues de comer: da oportunidad a criaturas\n    // que estan junto a comida sobrevivir un chunk mas\n    if (e.energy <= 0) {\n      kill(e\x2C e.type === TYPE.PREDATOR ? 'Depredador muere por energ\xeda' : 'Consumidor muere por energ\xeda');\n      return;\n    }\n    // Restaurar tras uso temporal (fertility despues de reproduceMobile)\n    e.speed = origSpeed;\n    e.perception = origPerception;\n    if (canReproduce && e.energy >= e.maxEnergy * (e.type === TYPE.PREDATOR ? 0.50 : 0.55)) reproduceMobile(e\x2C e.type\x2C cachedMate);\n    e.fertility = origFertility;\n  }\n\n  function compactIfNeeded() {\n    const aliveCount = sim.creatures.length - sim.freeIds.length;\n    if (sim.freeIds.length < 60 || sim.freeIds.length < aliveCount * 0.15) return;\n    const alive = [];\n    const selected = sim.selectedCreatureIds.map((key) => creatureByKey(key)).filter((e) => e && e.alive);\n    for (let i = 0; i < sim.creatures.length; i += 1) {\n      const e = sim.creatures[i];\n      if (!e || !e.alive) continue;\n      e.id = alive.length;\n      alive.push(e);\n    }\n    sim.creatures = alive;\n    sim.freeIds = [];\n    sim.selectedCreatureIds = selected.filter((e) => e.alive).map((e) => creatureKey(e));\n    sim._selectedKeysCache = null;\n    // Trails se clave por uid (estable durante compaction)\x2C solo limpiar seleccionados muertos\n    for (let i = sim.selectedCreatureIds.length - 1; i >= 0; i--) {\n      if (!creatureByKey(sim.selectedCreatureIds[i])) sim.selectedTrails.delete(sim.selectedCreatureIds[i]);\n    }\n    sim.selectedCreatureId = sim.selectedCreatureIds[sim.selectedCreatureIds.length - 1] ?? null;\n  }\n\n  function createTrail(x\x2C y) {\n    const xs = new Float32Array(TRAIL_MAX_POINTS);\n    const ys = new Float32Array(TRAIL_MAX_POINTS);\n    xs[0] = x; ys[0] = y;\n    return { xs\x2C ys\x2C head: 1\x2C count: 1 };\n  }\n\n  function trailPush(trail\x2C x\x2C y) {\n    trail.xs[trail.head] = x;\n    trail.ys[trail.head] = y;\n    trail.head = (trail.head + 1) % TRAIL_MAX_POINTS;\n    if (trail.count < TRAIL_MAX_POINTS) trail.count++;\n  }\n\n  function trailLast(trail) {\n    const i = (trail.head - 1 + TRAIL_MAX_POINTS) % TRAIL_MAX_POINTS;\n    return { x: trail.xs[i]\x2C y: trail.ys[i] };\n  }\n\n  function updateSelectedTrails() {\n    for (const key of sim.selectedCreatureIds) {\n      const e = creatureByKey(key);\n      if (!e || !e.alive) {\n        sim.selectedTrails.delete(key);\n        continue;\n      }\n      let trail = sim.selectedTrails.get(key);\n      if (!trail) {\n        trail = createTrail(e.x\x2C e.y);\n        sim.selectedTrails.set(key\x2C trail);\n        continue;\n      }\n      const prev = trailLast(trail);\n      const dx = torusDelta(e.x - mod(prev.x\x2C WORLD.w)\x2C WORLD.w);\n      const dy = torusDelta(e.y - mod(prev.y\x2C WORLD.h)\x2C WORLD.h);\n      if (dx * dx + dy * dy < TRAIL_MIN_STEP * TRAIL_MIN_STEP) continue;\n      trailPush(trail\x2C prev.x + dx\x2C prev.y + dy);\n    }\n  }\n\n  function checkMigration() {\n    // Fast exit: use live counters to skip full scan when all pops healthy\n    var THRESHOLD = 15;\n    var needB = sim.liveProducerBCount < THRESHOLD;\n    var needC = sim.liveProducerCCount < THRESHOLD;\n    var needM = sim.liveConsumerCount < THRESHOLD;\n    var needP = sim.predatorCount < THRESHOLD;\n    // Live counters ya disponibles: usarlos para skip del scan completo\n    var cB = sim.liveProducerBCount\x2C cC = sim.liveProducerCCount;\n    var cM = sim.liveConsumerCount\x2C cP = sim.predatorCount;\n    // Refinar needs con counts exactos\n    needB = needB && cB < THRESHOLD;\n    needC = needC && cC < THRESHOLD;\n    needM = needM && cM < THRESHOLD;\n    needP = needP && cP < THRESHOLD;\n    if (!needB && !needC && !needM && !needP) return;\n    // Solo construir survivors arrays para tipos que necesitan rescue\n    var sB = needB ? [] : null\x2C sC = needC ? [] : null\x2C sM = needM ? [] : null\x2C sP = needP ? [] : null;\n    for (var i = 0; i < sim.creatures.length; i += 1) {\n      var e = sim.creatures[i];\n      if (!e || !e.alive) continue;\n      if (e.type === TYPE.PRODUCER && e.sub === PRODUCER.B) { if (sB) sB.push(e); }\n      else if (e.type === TYPE.PRODUCER && e.sub === PRODUCER.C) { if (sC) sC.push(e); }\n      else if (e.type === TYPE.CONSUMER) { if (sM) sM.push(e); }\n      else if (e.type === TYPE.PREDATOR) { if (sP) sP.push(e); }\n    }\n    var baseProb = 0.03; // per checkMigration call (every 5s). Counts 4-14 get scaled rescue chance.\n    // Prob escalada inversa: menor poblacion = mayor chance de rescue\n    // count<=3: rescue garantizado (prob>=1). count=THRESHOLD-1: prob base.\n    // Ademas: count=0 permite recolonizacion (antes bloqueada por cB>0)\n    function rescueChance(count) {\n      if (count === 0) return baseProb * 4; // recolonizacion espontanea rara\n      if (count <= 3) return 1; // rescue garantizado cuando esta al borde\n      var scale = 1 + (THRESHOLD - count) / THRESHOLD; // 1.07..1.87x\n      return baseProb * scale;\n    }\n    if (cB < THRESHOLD && chance(rescueChance(cB))) migratePopulation('producerB'\x2C cB\x2C sB);\n    if (cC < THRESHOLD && chance(rescueChance(cC))) migratePopulation('producerC'\x2C cC\x2C sC);\n    if (cM < THRESHOLD && chance(rescueChance(cM))) migratePopulation('consumers'\x2C cM\x2C sM);\n    if (cP < THRESHOLD && chance(rescueChance(cP))) migratePopulation('predators'\x2C cP\x2C sP);\n  }\n\n  function migratePopulation(type\x2C count\x2C survivors) {\n    var n = Math.floor(rand(3\x2C 9));\n    var isPredator = type === 'predators';\n    var isProducerB = type === 'producerB';\n    var isProducerC = type === 'producerC';\n    // Si no hay survivors (especie extinguida)\x2C usar genes base aleatorios para recolonizacion\n    var hasSurvivors = survivors && survivors.length > 0;\n    function makeFallbackDonor() {\n      return {\n        size: isPredator ? rand(4\x2C 7) : rand(1\x2C 3)\x2C\n        reserves: rand(2\x2C 8)\x2C\n        flagella: Math.floor(rand(1\x2C 4))\x2C\n        cilia: Math.floor(rand(0\x2C 3))\x2C\n        chemosense: rand(0.5\x2C 2)\x2C\n        pseudopodia: rand(0\x2C 2)\x2C\n        armor: rand(0\x2C 2)\x2C\n        vacuole: rand(0\x2C 2)\x2C\n        feeding: Math.floor(rand(0\x2C 3))\x2C\n        movementMask: 1 << Math.floor(rand(0\x2C 3))\x2C\n        fertility: rand(0.4\x2C 0.7)\x2C\n        maxAge: isPredator ? rand(6000\x2C 10000) : rand(2000\x2C 5000)\n      };\n    }\n    for (var i = 0; i < n; i++) {\n      var donor = hasSurvivors ? survivors[Math.floor(rand(0\x2C survivors.length))] : makeFallbackDonor();\n      var edge = Math.floor(rand(0\x2C 4));\n      var margin = 80;\n      var x\x2C y;\n      if (edge === 0) { x = rand(0\x2C WORLD.w); y = margin; }\n      else if (edge === 1) { x = WORLD.w - margin; y = rand(0\x2C WORLD.h); }\n      else if (edge === 2) { x = rand(0\x2C WORLD.w); y = WORLD.h - margin; }\n      else { x = margin; y = rand(0\x2C WORLD.h); }\n      var opts = {\n        x: x\x2C y: y\x2C\n        size: mutate(Number(donor.size)\x2C 0.8\x2C 0.5\x2C isPredator ? 12 : 9)\x2C\n        reserves: mutate(Number(donor.reserves)\x2C 1.0\x2C 0\x2C isPredator ? 24 : 14)\x2C\n        flagella: Math.round(mutate(Number(donor.flagella)\x2C 1\x2C 0\x2C 7))\x2C\n        cilia: Math.round(mutate(Number(donor.cilia)\x2C 1\x2C 0\x2C 6))\x2C\n        chemosense: mutate(Number(donor.chemosense)\x2C 0.4\x2C 0\x2C 5)\x2C\n        pseudopodia: mutate(Number(donor.pseudopodia)\x2C 0.4\x2C 0\x2C 4)\x2C\n        armor: mutate(Number(donor.armor)\x2C 0.5\x2C 0\x2C 5)\x2C\n        vacuole: mutate(Number(donor.vacuole)\x2C 0.4\x2C 0\x2C 4)\x2C\n        feeding: chance(0.12) ? Math.floor(rand(0\x2C FEEDING.length)) : Number(donor.feeding || 0)\x2C\n        movementMask: chance(0.08) ? (1 << Math.floor(rand(0\x2C MOVE.length))) : Number(donor.movementMask || 2)\x2C\n        fertility: mutate(Number(donor.fertility)\x2C 0.1\x2C 0.22\x2C 3)\x2C\n        maxAge: mutate(Number(donor.maxAge)\x2C Number(donor.maxAge) * 0.15\x2C isPredator ? 5000 : 1800\x2C isPredator ? 15000 : 8000)\n      };\n      if (isProducerB) { opts.sub = PRODUCER.B; spawnProducer(opts); }\n      else if (isProducerC) { opts.sub = PRODUCER.C; spawnProducer(opts); }\n      else if (type === 'consumers') { opts.energy = rand(10\x2C 15); spawnConsumer(opts); }\n      else if (isPredator) { opts.energy = rand(30\x2C 50); spawnPredator(opts); }\n      sim.births += 1;\n    }\n    if (LOG_EVENTS) { var label = isPredator ? 'depredadores' : type === 'consumers' ? 'consumidores' : isProducerB ? 'productores B' : 'productores C'; logEvent('Migraci\xf3n: ' + n + ' ' + label + ' recoloniaron desde los bordes (pop. previa: ' + count + ')'\x2C 'birth'); }\n  }\n\n  function simulate(dt) {\n    sim.time += dt;\n\n    // Ciclo dia/noche: solarEnergy oscila sinusoidalmente sobre la base\n    if (sim.dayNightEnabled) {\n      const phase = (sim.time / sim.dayNightPeriod) * Math.PI * 2;\n      sim.dayNightPhase = phase;\n      const amp = 0.4;\n      sim.solarEnergy = Math.max(0.1\x2C sim.solarEnergyBase + amp * Math.sin(phase));\n    }\n\n    // predatorCount now maintained live via spawn/kill counters\n\n    stepProducerField(dt);\n    // Anti first-mover bias: rotar offset de inicio del loop cada simulate().\n    // Las criaturas con ID bajo ya no actuan siempre primero.\n    sim._loopOffset = ((sim._loopOffset || 0) + 1) % sim.creatures.length;\n    const n = sim.creatures.length;\n    const off = sim._loopOffset;\n    for (let k = 0; k < n; k += 1) {\n      const i = (k + off) % n;\n      const e = sim.creatures[i];\n      if (!e || !e.alive) continue;\n      if (e._birthStep === sim.time) continue;\n      if (e.type === TYPE.PRODUCER) stepProducer(e\x2C dt);\n      else stepMobile(e\x2C dt);\n    }\n    if (sim.selectedCreatureIds.length) updateSelectedTrails();\n\n    stepCarcasses(dt);\n\n    sim.migrationTimer -= dt;\n    if (sim.migrationTimer <= 0) {\n      sim.migrationTimer = 5.0;\n      checkMigration();\n    }\n  }\n\n  // Thermal entropy: muestrea energia total cada 5s y aplica disipacion suave si excede promedio movil.\n  // Simula perdida termica en transferencias troficas. Solo activo cuando hay inflacion energetica clara.\n  function applyThermalDecay() {\n    // Calcular energia total aproximada: mobiles + field\n    const mobileEnergy = sim.mobileEnergySum;\n    const fieldEnergy = sim.producerField.total || 0;\n    const total = mobileEnergy + fieldEnergy;\n    const hist = sim.thermalEnergyHistory;\n    hist.push(total);\n    if (hist.length > 12) hist.shift(); // ultimas 12 muestras = ~60s\n    if (hist.length < 4) { sim.thermalDecayRate = 0; return; } // necesita warmup\n    // Promedio movil excluyendo el valor actual\n    let sum = 0;\n    for (let i = 0; i < hist.length - 1; i += 1) sum += hist[i];\n    const movingAvg = sum / (hist.length - 1);\n    if (movingAvg < 1) { sim.thermalDecayRate = 0; return; }\n    const ratio = total / movingAvg;\n    if (ratio > 1.3) {\n      // Inflacion detectada: disipacion proporcional al exceso\x2C max 2%/s\n      sim.thermalDecayRate = Math.min(0.02\x2C (ratio - 1.3) * 0.015);\n    } else if (ratio < 1.1) {\n      // Sistema equilibrado o deflacion: desactivar\n      sim.thermalDecayRate = 0;\n    }\n    // thermalDecayRate se aplica continuamente en stepMobile como disipacion suave\n  }\n\n  function counts() {\n    const energyN = sim.liveConsumerCount + sim.predatorCount;\n    const producerDensity = sim.producerField.mass.length ? sim.producerField.total / sim.producerField.mass.length : 0;\n    // Include producer B/C energy in avg so the stat reflects the whole ecosystem.\n    // mobileEnergySum only tracks consumers+predators; producers are summed here (cheap\x2C ~3/s).\n    let producerEnergy = 0;\n    if (sim.liveProducerBCount + sim.liveProducerCCount > 0) {\n      const creatures = sim.creatures;\n      for (let i = 0; i < creatures.length; i += 1) {\n        const e = creatures[i];\n        if (!e || !e.alive) continue;\n        if (e.type === TYPE.PRODUCER) producerEnergy += e.energy || 0;\n      }\n    }\n    const totalN = energyN + sim.liveProducerBCount + sim.liveProducerCCount;\n    const totalEnergy = sim.mobileEnergySum + producerEnergy;\n    return { producerDensity\x2C producerB: sim.liveProducerBCount\x2C producerC: sim.liveProducerCCount\x2C consumers: sim.liveConsumerCount\x2C predators: sim.predatorCount\x2C energyAvg: totalN ? totalEnergy / totalN : 0 };\n  }\n\n  // Pre-allocated scratch for recordGeneHistory (avoids Object.fromEntries allocs each call)\n  const _geneTotalsScratch = {};\n  for (let i = 0; i < GROUPS.length; i += 1) {\n    const group = GROUPS[i];\n    const keys = GROUP_KEYS[group];\n    const sums = {};\n    for (let k = 0; k < keys.length; k += 1) sums[keys[k]] = 0;\n    _geneTotalsScratch[group] = { n: 0\x2C sums };\n  }\n\n  function recordGeneHistory() {\n    // Reset scratch\n    for (let i = 0; i < GROUPS.length; i += 1) {\n      const group = GROUPS[i];\n      _geneTotalsScratch[group].n = 0;\n      const keys = GROUP_KEYS[group];\n      const sums = _geneTotalsScratch[group].sums;\n      for (let k = 0; k < keys.length; k += 1) sums[keys[k]] = 0;\n    }\n\n    _geneTotalsScratch['producer-a'].n = 1;\n    _geneTotalsScratch['producer-a'].sums.densityTotal = sim.producerField.total;\n\n    for (let i = 0; i < sim.creatures.length; i += 1) {\n      const e = sim.creatures[i];\n      if (!e || !e.alive) continue;\n      const group = groupForCreature(e);\n      const keys = GROUP_KEYS[group];\n      _geneTotalsScratch[group].n += 1;\n      const sums = _geneTotalsScratch[group].sums;\n      for (let k = 0; k < keys.length; k += 1) {\n        sums[keys[k]] += e[keys[k]] || 0;\n      }\n    }\n\n    const point = { t: sim.time };\n    for (let i = 0; i < GROUPS.length; i += 1) {\n      const group = GROUPS[i];\n      const keys = GROUP_KEYS[group];\n      const n = _geneTotalsScratch[group].n || 0;\n      const avg = {};\n      const sums = _geneTotalsScratch[group].sums;\n      for (let k = 0; k < keys.length; k += 1) {\n        avg[keys[k]] = n ? sums[keys[k]] / n : 0;\n      }\n      point[group] = { n\x2C avg };\n    }\n    sim.geneHistory.push(point);\n    drawGeneHistory();\n  }\n\n  // Cached canvas sizing: only calls getBoundingClientRect when ResizeObserver marks dirty\n  const _canvasSizeCache = new WeakMap();\n\n  function resizeCanvasToDisplay(canvasEl\x2C context\x2C fallbackW\x2C fallbackH) {\n    let entry = _canvasSizeCache.get(canvasEl);\n    if (!entry) {\n      entry = { w: 0\x2C h: 0\x2C dirty: true };\n      _canvasSizeCache.set(canvasEl\x2C entry);\n      new ResizeObserver(() => { entry.dirty = true; }).observe(canvasEl);\n    }\n    if (!entry.dirty && canvasEl.width === entry.w && canvasEl.height === entry.h) {\n      return { w: entry.w\x2C h: entry.h };\n    }\n    const rect = canvasEl.getBoundingClientRect();\n    const dpr = Math.min(2\x2C window.devicePixelRatio || 1);\n    const w = Math.max(fallbackW\x2C Math.floor(rect.width * dpr));\n    const h = Math.max(fallbackH\x2C Math.floor(rect.height * dpr));\n    entry.w = w;\n    entry.h = h;\n    entry.dirty = false;\n    if (canvasEl.width !== w || canvasEl.height !== h) {\n      canvasEl.width = w;\n      canvasEl.height = h;\n      context.setTransform(1\x2C 0\x2C 0\x2C 1\x2C 0\x2C 0);\n    }\n    return { w\x2C h };\n  }\n\n  function removeInspectorPanel(key) {\n    sim.selectedCreatureIds = sim.selectedCreatureIds.filter((selectedKey) => selectedKey !== key);\n    sim._selectedKeysCache = null;\n    sim.selectedCreatureId = sim.selectedCreatureIds[sim.selectedCreatureIds.length - 1] ?? null;\n    sim.selectedTrails.delete(key);\n    if (sim.followCreatureId === key) setFollowCreature(key\x2C false);\n    const panel = document.querySelector(`.inspect-panel[data-inspect-uid="${key}"]`);\n    if (panel && panel !== els.inspectPanel) panel.remove();\n    else if (panel) {\n      panel.classList.add('hidden');\n      panel.removeAttribute('data-inspect-uid');\n    }\n  }\n\n  function closeInspector(key = null) {\n    const targetKey = key ?? sim.selectedCreatureIds[sim.selectedCreatureIds.length - 1];\n    if (targetKey == null) return;\n    removeInspectorPanel(targetKey);\n    updateInspectors();\n  }\n\n  function setFollowCreature(key\x2C enabled) {\n    sim.followCreatureId = enabled ? key : null;\n    if (!enabled && sim.lastCenteredCreatureId === key) sim.lastCenteredCreatureId = null;\n    updateFollowButtons();\n  }\n\n  function updateFollowButtons() {\n    document.querySelectorAll('.inspect-panel[data-inspect-uid]').forEach((panel) => {\n      const key = Number(panel.dataset.inspectUid);\n      const active = sim.followCreatureId === key;\n      const btn = panel.querySelector('.target-inspect');\n      if (btn) {\n        btn.classList.toggle('active'\x2C active);\n        btn.title = active ? 'Dejar de seguir' : 'Centrar vista';\n      }\n    });\n  }\n\n  function ensureInspectorPanel(key\x2C index) {\n    let panel = index === 0 ? els.inspectPanel : document.querySelector(`.inspect-panel[data-inspect-uid="${key}"]`);\n    if (!panel) {\n      panel = document.createElement('section');\n      panel.className = 'hud panel inspect-panel movable';\n      panel.setAttribute('aria-label'\x2C 'Valores del ser seleccionado');\n      panel.innerHTML = '<header class="panel-head drag-handle"><button class="icon-button target-inspect" type="button" title="Centrar vista">\u2316</button><button class="icon-button clone-inspect lightning-button" type="button" title="Crear como este">\u26a1</button><h2>Ser</h2><button class="icon-button close-inspect" type="button" title="Cerrar">\xd7</button></header><div class="inspect-body"></div>';\n      document.querySelector('.world-viewport').appendChild(panel);\n      makePanelDraggable(panel);\n    }\n    const header = panel.querySelector('.panel-head');\n    if (header && !header.querySelector('.target-inspect')) {\n      header.insertAdjacentHTML('afterbegin'\x2C '<button class="icon-button target-inspect" type="button" title="Centrar vista">\u2316</button>');\n    }\n    if (header && !header.querySelector('.clone-inspect')) {\n      const targetBtn = header.querySelector('.target-inspect');\n      targetBtn?.insertAdjacentHTML('afterend'\x2C '<button class="icon-button clone-inspect lightning-button" type="button" title="Crear como este">\u26a1</button>');\n    }\n    panel.dataset.inspectUid = String(key);\n    panel.classList.remove('hidden');\n    const close = panel.querySelector('.close-inspect\x2C .panel-head > .icon-button:last-child');\n    if (close && !close.dataset.boundInspectClose) {\n      close.dataset.boundInspectClose = '1';\n      close.addEventListener('click'\x2C () => closeInspector(Number(panel.dataset.inspectUid)));\n    }\n    const target = panel.querySelector('.target-inspect');\n    if (target && !target.dataset.boundInspectTarget) {\n      target.dataset.boundInspectTarget = '1';\n      target.addEventListener('click'\x2C (ev) => {\n        ev.stopPropagation();\n        centerOnCreature(Number(panel.dataset.inspectUid)\x2C true);\n      });\n    }\n    const clone = panel.querySelector('.clone-inspect');\n    if (clone && !clone.dataset.boundInspectClone) {\n      clone.dataset.boundInspectClone = '1';\n      clone.addEventListener('click'\x2C (ev) => {\n        ev.stopPropagation();\n        openCloneDialog(Number(panel.dataset.inspectUid));\n      });\n    }\n    return panel;\n  }\n\n  function placeInspectorPanel(panel\x2C screenX\x2C screenY\x2C index) {\n    const x = clamp(screenX + 112 + index * 30\x2C 8\x2C window.innerWidth - 420);\n    const y = clamp(screenY + 14 + index * 24\x2C 68\x2C window.innerHeight - 240);\n    panel.style.left = `${x}px`;\n    panel.style.top = `${y}px`;\n    panel.style.right = 'auto';\n    panel.style.bottom = 'auto';\n  }\n\n  function selectCreature(e\x2C screenX = window.innerWidth * 0.5\x2C screenY = window.innerHeight * 0.5) {\n    if (!e || !e.alive) return;\n    const key = creatureKey(e);\n    sim.selectedCreatureIds = sim.selectedCreatureIds.filter((selectedKey) => {\n      const selected = creatureByKey(selectedKey);\n      return selected && selected.alive && selectedKey !== key;\n    });\n    sim.selectedCreatureIds.push(key);\n    sim._selectedKeysCache = null;\n    sim.selectedCreatureId = key;\n    sim.selectedTrails.set(key\x2C createTrail(e.x\x2C e.y));\n    updateInspectors();\n    const panel = document.querySelector(`.inspect-panel[data-inspect-uid="${key}"]`);\n    if (panel) placeInspectorPanel(panel\x2C screenX\x2C screenY\x2C sim.selectedCreatureIds.length - 1);\n  }\n\n  function centerOnCreature(key\x2C toggleFollow = false) {\n    const e = creatureByKey(key);\n    if (!e || !e.alive) return;\n    camera.x = e.x;\n    camera.y = e.y;\n    if (toggleFollow) {\n      if (sim.followCreatureId === key) setFollowCreature(key\x2C false);\n      else if (sim.lastCenteredCreatureId === key) setFollowCreature(key\x2C true);\n      else {\n        sim.lastCenteredCreatureId = key;\n        updateFollowButtons();\n      }\n    }\n    clampCamera();\n  }\n\n  function updateCameraFollow() {\n    if (sim.followCreatureId == null || camera.dragging) return;\n    const e = creatureByKey(sim.followCreatureId);\n    if (!e || !e.alive) {\n      setFollowCreature(sim.followCreatureId\x2C false);\n      return;\n    }\n    camera.x = e.x;\n    camera.y = e.y;\n  }\n\n  function inspectorHtml(e) {\n    let rows = [infoRow('tipo'\x2C typeName(e))\x2C infoRow('energ\xeda'\x2C e.energy\x2C 'energy')];\n    if (e.type === TYPE.PRODUCER && isMobileProducer(e)) {\n      rows = rows.concat([\n        infoRow('energ\xeda m\xe1x.'\x2C e.maxEnergy\x2C 'maxEnergy')\x2C\n        infoRow('percepci\xf3n'\x2C e.perception\x2C 'perception')\x2C\n        infoRow('quimiosens.'\x2C e.chemosense\x2C 'chemosense')\x2C\n        infoRow('reproducci\xf3n'\x2C e.fertility\x2C 'fertility')\x2C\n        infoRow('cooldown'\x2C e.cooldown)\x2C\n        infoRow('movimiento'\x2C movementNames(e)\x2C 'movement')\n      ]);\n    } else if (e.type === TYPE.PRODUCER && isColonyProducer(e)) {\n      rows = rows.concat([\n        infoRow('energ\xeda m\xe1x.'\x2C e.maxEnergy\x2C 'maxEnergy')\x2C\n        infoRow('energ\xeda hojas'\x2C e.leafEnergy\x2C 'leafEnergy')\x2C\n        infoRow('reproducci\xf3n'\x2C e.fertility\x2C 'fertility')\x2C\n        infoRow('cooldown'\x2C e.cooldown)\n      ]);\n    } else {\n      rows = rows.concat([\n        infoRow('energ\xeda m\xe1x.'\x2C e.maxEnergy\x2C 'maxEnergy')\x2C\n        infoRow('metabolismo'\x2C e.metabolism\x2C 'metabolism')\x2C\n        infoRow('percepci\xf3n'\x2C e.perception\x2C 'perception')\x2C\n        infoRow('reproducci\xf3n'\x2C e.fertility\x2C 'fertility')\x2C\n        infoRow('cooldown'\x2C e.cooldown)\x2C\n        infoRow('movimiento'\x2C movementNames(e)\x2C 'movement')\x2C\n        infoRow('quimiosens.'\x2C e.chemosense\x2C 'chemosense')\x2C\n        infoRow('alimentaci\xf3n'\x2C FEEDING[e.feeding] ?? e.feeding\x2C 'feeding')\n      ]);\n    }\n    const values = rows\n      .filter(({ value }) => value !== undefined && value !== null && value !== '' && !(typeof value === 'number' && Number.isNaN(value)))\n      .map(({ label\x2C value\x2C geneKey }) => `<span>${geneLabelHtml(geneKey\x2C label)}</span><b>${escapeHtml(formatValue(value))}</b>`)\n      .join('');\n    return `<div class="inspect-preview">${previewHtml(e)}</div><div class="inspect-values">${values}</div>`;\n  }\n\n  function updateInspectors() {\n    sim.selectedCreatureIds = sim.selectedCreatureIds.filter((key) => {\n      const e = creatureByKey(key);\n      return e && e.alive;\n    });\n    sim._selectedKeysCache = null;\n    sim.selectedCreatureId = sim.selectedCreatureIds[sim.selectedCreatureIds.length - 1] ?? null;\n    const primaryId = sim.selectedCreatureIds[0];\n    document.querySelectorAll('.inspect-panel[data-inspect-uid]').forEach((panel) => {\n      const id = Number(panel.dataset.inspectUid);\n      if (!sim.selectedCreatureIds.includes(id) || (panel !== els.inspectPanel && id === primaryId)) {\n        if (panel === els.inspectPanel) panel.classList.add('hidden');\n        else panel.remove();\n      }\n    });\n    if (!sim.selectedCreatureIds.length) {\n      els.inspectPanel.classList.add('hidden');\n      updateFollowButtons();\n      return;\n    }\n    for (let i = 0; i < sim.selectedCreatureIds.length; i += 1) {\n      const key = sim.selectedCreatureIds[i];\n      const e = creatureByKey(key);\n      if (!e) continue;\n      const panel = ensureInspectorPanel(key\x2C i);\n      panel.querySelector('h2').innerHTML = `${escapeHtml(typeName(e))} <b class="inspect-id" style="color:${colorForCreature(e)}">#${creatureKey(e)}</b>`;\n      panel.querySelector('.inspect-body').innerHTML = inspectorHtml(e);\n    }\n    updateFollowButtons();\n  }\n\n  function findCreatureAt(screenX\x2C screenY) {\n    const raw = screenToWorld(screenX\x2C screenY);\n    const pos = { x: mod(raw.x\x2C WORLD.w)\x2C y: mod(raw.y\x2C WORLD.h) };\n    const worldRadius = clamp(22 / camera.zoom\x2C 18\x2C 360);\n    updateClickOffset(raw.x\x2C raw.y);\n    let best = null;\n    let bestScreenD2 = Infinity;\n    // Single grid scan: iterate all 3 type lists per cell in one pass\n    const grid = sim.grid;\n    const minX = Math.floor((pos.x - worldRadius) / CELL);\n    const maxX = Math.floor((pos.x + worldRadius) / CELL);\n    const minY = Math.floor((pos.y - worldRadius) / CELL);\n    const maxY = Math.floor((pos.y + worldRadius) / CELL);\n    const r2 = worldRadius * worldRadius;\n    for (let cy = minY; cy <= maxY; cy += 1) {\n      let wy = cy;\n      if (wy < 0) wy += GRID_ROWS; else if (wy >= GRID_ROWS) wy -= GRID_ROWS;\n      const rowBase = wy * GRID_COLS;\n      for (let cx = minX; cx <= maxX; cx += 1) {\n        let wx = cx;\n        if (wx < 0) wx += GRID_COLS; else if (wx >= GRID_COLS) wx -= GRID_COLS;\n        const bucket = grid[rowBase + wx];\n        for (let type = 0; type <= 2; type += 1) {\n          const list = bucket[type];\n          for (let i = 0; i < list.length; i += 1) {\n            const e = list[i];\n            const ddx = torusDelta(e.x - pos.x\x2C WORLD.w);\n            const ddy = torusDelta(e.y - pos.y\x2C WORLD.h);\n            if (ddx * ddx + ddy * ddy > r2) continue;\n            const p = nearestScreenPosition(e.x\x2C e.y\x2C screenX\x2C screenY);\n            const dx = p.x - screenX;\n            const dy = p.y - screenY;\n            const hit = Math.max(8\x2C e.radius * camera.zoom + 6);\n            const d2 = dx * dx + dy * dy;\n            if (d2 <= hit * hit && d2 < bestScreenD2) {\n              best = e;\n              bestScreenD2 = d2;\n            }\n          }\n        }\n      }\n    }\n    return best;\n  }\n\n  function resize() {\n    const dpr = Math.min(2\x2C window.devicePixelRatio || 1);\n    const w = Math.floor(window.innerWidth * dpr);\n    const h = Math.floor(window.innerHeight * dpr);\n    if (canvas.width !== w || canvas.height !== h) {\n      canvas.width = w;\n      canvas.height = h;\n    }\n    mainCanvasDpr = dpr;\n    ctx.setTransform(mainCanvasDpr\x2C 0\x2C 0\x2C mainCanvasDpr\x2C 0\x2C 0);\n  }\n\n  function minCameraZoom() {\n    return Math.max(window.innerWidth / (WORLD.w * 1.5)\x2C window.innerHeight / (WORLD.h * 1.5)\x2C 0.028);\n  }\n\n  function fitWorldZoom() {\n    return clamp(Math.min(window.innerWidth / WORLD.w\x2C window.innerHeight / WORLD.h) * 0.82\x2C minCameraZoom()\x2C 2.2);\n  }\n\n  function centerCamera({ fit = false } = {}) {\n    camera.x = WORLD.w * 0.5;\n    camera.y = WORLD.h * 0.5;\n    if (fit) camera.zoom = fitWorldZoom();\n  }\n\n  const _scrW2S = { x: 0\x2C y: 0 };\n  const _scrS2W = { x: 0\x2C y: 0 };\n\n  function screenToWorld(x\x2C y) {\n    const cx = window.innerWidth * 0.5;\n    const cy = window.innerHeight * 0.5;\n    _scrS2W.x = camera.x + (x - cx) / camera.zoom;\n    _scrS2W.y = camera.y + (y - cy) / camera.zoom;\n    return _scrS2W;\n  }\n\n  function worldToScreen(x\x2C y) {\n    _scrW2S.x = (x - camera.x) * camera.zoom + window.innerWidth * 0.5;\n    _scrW2S.y = (y - camera.y) * camera.zoom + window.innerHeight * 0.5;\n    return _scrW2S;\n  }\n\n  // Pre-computed tile offset for click hit-testing (avoids 3x3 loop per creature)\n  let _clickOx = 0\x2C _clickOy = 0;\n  function updateClickOffset(clickWorldX\x2C clickWorldY) {\n    _clickOx = Math.round(clickWorldX / WORLD.w) * WORLD.w;\n    _clickOy = Math.round(clickWorldY / WORLD.h) * WORLD.h;\n  }\n\n  function nearestScreenPosition(x\x2C y\x2C screenX\x2C screenY) {\n    const p = worldToScreen(x + _clickOx\x2C y + _clickOy);\n    _scrW2S.x = p.x; _scrW2S.y = p.y;\n    return _scrW2S;\n  }\n\n  function clampCamera() {\n    camera.zoom = clamp(camera.zoom\x2C minCameraZoom()\x2C 2.2);\n    camera.x = mod(camera.x\x2C WORLD.w);\n    camera.y = mod(camera.y\x2C WORLD.h);\n  }\n\n  // Scratch pool for visibleTileOffsets: reuses objects across calls (zero alloc)\n  const _tileOffsetsScratch = [];\n  for (let i = 0; i < 25; i += 1) _tileOffsetsScratch.push({ ox: 0\x2C oy: 0 });\n  const _tileOffsetsResult = [];\n\n  function visibleTileOffsets(extraWorld = 0) {\n    const halfW = window.innerWidth / (camera.zoom * 2) + extraWorld;\n    const halfH = window.innerHeight / (camera.zoom * 2) + extraWorld;\n    const minTileX = Math.max(-2\x2C Math.floor((camera.x - halfW) / WORLD.w));\n    const maxTileX = Math.min(2\x2C Math.floor((camera.x + halfW) / WORLD.w));\n    const minTileY = Math.max(-2\x2C Math.floor((camera.y - halfH) / WORLD.h));\n    const maxTileY = Math.min(2\x2C Math.floor((camera.y + halfH) / WORLD.h));\n    _tileOffsetsResult.length = 0;\n    let si = 0;\n    for (let ty = minTileY; ty <= maxTileY; ty += 1) {\n      for (let tx = minTileX; tx <= maxTileX; tx += 1) {\n        const s = _tileOffsetsScratch[si++];\n        s.ox = tx * WORLD.w;\n        s.oy = ty * WORLD.h;\n        _tileOffsetsResult.push(s);\n      }\n    }\n    if (!_tileOffsetsResult.length) {\n      _tileOffsetsScratch[0].ox = 0;\n      _tileOffsetsScratch[0].oy = 0;\n      _tileOffsetsResult.push(_tileOffsetsScratch[0]);\n    }\n    return _tileOffsetsResult;\n  }\n\n  function isCreatureVisible(e\x2C ox = 0\x2C oy = 0\x2C margin = 32) {\n    const p = worldToScreen(e.x + ox\x2C e.y + oy);\n    const r = Math.max(2\x2C e.radius * camera.zoom);\n    return p.x >= -margin - r && p.y >= -margin - r && p.x <= window.innerWidth + margin + r && p.y <= window.innerHeight + margin + r;\n  }\n\n  function drawBackground(offsets) {\n    ctx.setTransform(mainCanvasDpr\x2C 0\x2C 0\x2C mainCanvasDpr\x2C 0\x2C 0);\n    ctx.fillStyle = '#0a1010';\n    ctx.fillRect(0\x2C 0\x2C window.innerWidth\x2C window.innerHeight);\n\n    // offsets passed from render() (cached)\n    for (let i = 0; i < offsets.length; i += 1) {\n      const { ox\x2C oy } = offsets[i];\n      const topLeft = worldToScreen(ox\x2C oy);\n      const tlx = topLeft.x\x2C tly = topLeft.y;\n      const bottomRight = worldToScreen(WORLD.w + ox\x2C WORLD.h + oy);\n      const w = bottomRight.x - tlx;\n      const h = bottomRight.y - tly;\n      ctx.fillStyle = '#0b1413';\n      ctx.fillRect(tlx\x2C tly\x2C w + 1\x2C h + 1);\n    }\n  }\n\n  // LUT precomputed para drawProducerField: elimina string concat por celda por frame\n  const _PFIELD_LUT_SIZE = 256;\n  const _PFIELD_ALPHA_MIN = 0.035;\n  const _PFIELD_ALPHA_MAX = 0.24;\n  const _PFIELD_ALPHA_RANGE = _PFIELD_ALPHA_MAX - _PFIELD_ALPHA_MIN;\n  const _PFIELD_MASS_TO_LUT = 0.16 / _PFIELD_ALPHA_RANGE * (_PFIELD_LUT_SIZE - 1);\n  const producerFieldFillLUT = (() => {\n    const lut = new Array(_PFIELD_LUT_SIZE);\n    for (let i = 0; i < _PFIELD_LUT_SIZE; i++) {\n      const a = _PFIELD_ALPHA_MIN + (i / (_PFIELD_LUT_SIZE - 1)) * _PFIELD_ALPHA_RANGE;\n      lut[i] = `rgba(118\x2C 210\x2C 93\x2C ${a})`;\n    }\n    return lut;\n  })();\n\n  // Offscreen canvas for cached producer field rendering.\n  // The field changes every ~0.45s but is drawn every frame.\n  // Instead of fillRect per visible cell per frame\x2C we render the full field\n  // to a tiny offscreen canvas (cols\xd7rows pixels) only when dirty\x2C\n  // then drawImage it scaled to the viewport.\n  let _fieldCanvas = null;\n  let _fieldImageData = null;\n  let _fieldPrevCols = 0;\n  let _fieldPrevRows = 0;\n\n  function ensureFieldCanvas(cols\x2C rows) {\n    if (_fieldCanvas && _fieldPrevCols === cols && _fieldPrevRows === rows) return;\n    _fieldCanvas = document.createElement('canvas');\n    _fieldCanvas.width = cols;\n    _fieldCanvas.height = rows;\n    _fieldImageData = new ImageData(cols\x2C rows);\n    _fieldPrevCols = cols;\n    _fieldPrevRows = rows;\n  }\n\n  function updateFieldCanvas() {\n    const field = sim.producerField;\n    const cols = field.cols;\n    const rows = field.rows;\n    if (!cols || !rows) return;\n    ensureFieldCanvas(cols\x2C rows);\n    const data = _fieldImageData.data;\n    const mass = field.mass;\n\n    // Determine update region. If dirty rect is null (global) or covers >80% of field\x2C full scan.\n    let x0 = 0\x2C y0 = 0\x2C x1 = cols - 1\x2C y1 = rows - 1;\n    let partial = false;\n    if (field.dirtyMinX !== null) {\n      const dw = field.dirtyMaxX - field.dirtyMinX + 1;\n      const dh = field.dirtyMaxY - field.dirtyMinY + 1;\n      const coverage = (dw * dh) / (cols * rows);\n      if (coverage < 0.8) {\n        // Clamp dirty rect to field bounds and add 1-cell diffusion margin\n        x0 = Math.max(0\x2C field.dirtyMinX - 1);\n        y0 = Math.max(0\x2C field.dirtyMinY - 1);\n        x1 = Math.min(cols - 1\x2C field.dirtyMaxX + 1);\n        y1 = Math.min(rows - 1\x2C field.dirtyMaxY + 1);\n        partial = true;\n      }\n    }\n\n    for (let y = y0; y <= y1; y += 1) {\n      const rowBase = y * cols;\n      for (let x = x0; x <= x1; x += 1) {\n        const i = rowBase + x;\n        const m = mass[i];\n        if (m < 0.035) {\n          data[i * 4 + 3] = 0; // transparent\n        } else {\n          let a = _PFIELD_ALPHA_MIN + m * 0.16;\n          if (a > _PFIELD_ALPHA_MAX) a = _PFIELD_ALPHA_MAX;\n          const a255 = (a * 255) | 0;\n          data[i * 4]     = 118; // R\n          data[i * 4 + 1] = 210; // G\n          data[i * 4 + 2] = 93;  // B\n          data[i * 4 + 3] = a255;\n        }\n      }\n    }\n\n    _fieldCanvas.getContext('2d').putImageData(_fieldImageData\x2C 0\x2C 0);\n    field.dirty = false;\n    field.dirtyMinX = null; field.dirtyMinY = null;\n    field.dirtyMaxX = null; field.dirtyMaxY = null;\n  }\n\n  function drawProducerField(offsets) {\n    const field = sim.producerField;\n    if (!field.mass.length) return;\n    if (field.dirty) updateFieldCanvas();\n    if (!_fieldCanvas) return;\n\n    const cellW = field.cellW;\n    const cellH = field.cellH;\n    const cols = field.cols;\n    const rows = field.rows;\n    const worldW = cols * cellW;\n    const worldH = rows * cellH;\n\n    // Enable smoothing for nice gradient-like appearance when zoomed in\n    const prevSmoothing = ctx.imageSmoothingEnabled;\n    ctx.imageSmoothingEnabled = true;\n\n    for (let o = 0; o < offsets.length; o += 1) {\n      const { ox\x2C oy } = offsets[o];\n      const p0 = worldToScreen(ox\x2C oy);\n      const sw = worldW * camera.zoom;\n      const sh = worldH * camera.zoom;\n      // Cull tiles entirely off-screen\n      if (p0.x + sw < 0 || p0.y + sh < 0 || p0.x > window.innerWidth || p0.y > window.innerHeight) continue;\n      ctx.drawImage(_fieldCanvas\x2C 0\x2C 0\x2C _fieldCanvas.width\x2C _fieldCanvas.height\x2C p0.x\x2C p0.y\x2C sw\x2C sh);\n    }\n\n    ctx.imageSmoothingEnabled = prevSmoothing;\n  }\n\n  function drawDebugRange(e\x2C ox = 0\x2C oy = 0) {\n    if (!sim.debug) return;\n    const p = worldToScreen(e.x + ox\x2C e.y + oy);\n    const range = e.type === TYPE.PRODUCER\n      ? isColonyProducer(e)\n        ? Math.max(e.radius + (e.leafCount || 0) * 1.8\x2C 60)\n        : e.perception || e.radius * 8\n      : e.perception;\n    const r = range * camera.zoom;\n    if (r < 2) return;\n    ctx.beginPath();\n    ctx.arc(p.x\x2C p.y\x2C r\x2C 0\x2C Math.PI * 2);\n    ctx.strokeStyle = e.type === TYPE.PREDATOR\n      ? 'rgba(240\x2C91\x2C80\x2C0.16)'\n      : e.type === TYPE.CONSUMER\n        ? 'rgba(84\x2C183\x2C241\x2C0.14)'\n        : 'rgba(118\x2C210\x2C93\x2C0.16)';\n    ctx.lineWidth = 1;\n    ctx.stroke();\n    if (e.type === TYPE.PRODUCER && isColonyProducer(e)) {\n      ctx.beginPath();\n      ctx.arc(p.x\x2C p.y\x2C 900 * camera.zoom\x2C 0\x2C Math.PI * 2);\n      ctx.strokeStyle = 'rgba(166\x2C221\x2C120\x2C0.08)';\n      ctx.stroke();\n    }\n  }\n\n  function drawCreature(e\x2C ox = 0\x2C oy = 0) {\n    const p = worldToScreen(e.x + ox\x2C e.y + oy);\n    // Minimum visible size: mobile creatures need to be visible at any zoom\n    const minR = e.type === TYPE.CONSUMER || e.type === TYPE.PREDATOR ? 3 : 1;\n    const r = Math.max(minR\x2C e.radius * camera.zoom);\n    ctx.fillStyle = e.color;\n    if (e.starved === 2) ctx.fillStyle = '#e8d44a';\n    else if (e.starved === 1) ctx.fillStyle = '#b8a842';\n    if (r <= 2.2) {\n      ctx.fillRect(p.x - r\x2C p.y - r\x2C r * 2\x2C r * 2);\n      if (e._selected) {\n        drawSelectionRing(p\x2C r\x2C e.type === TYPE.PREDATOR ? '#f05b50' : e.type === TYPE.PRODUCER ? colorForCreature(e) : '#54b7f1');\n        drawMapEnergyBar(p\x2C r\x2C e);\n      }\n      return;\n    }\n\n    if (e.type === TYPE.PRODUCER && isColonyProducer(e)) {\n      const leaves = Math.min(14\x2C Math.max(0\x2C e.leafCount || 0));\n      ctx.fillStyle = '#7fd867';\n      const wobble = lutSin(sim.time * 0.12 + e.id) * 0.18;\n      const invLeaves = 1 / Math.max(1\x2C leaves);\n      ctx.beginPath();\n      for (let i = 0; i < leaves; i += 1) {\n        const a = e.angle + i * invLeaves * Math.PI * 2 + wobble;\n        const leafR = Math.max(1\x2C r * 0.34);\n        const lx = p.x + lutCos(a) * r * 1.18;\n        const ly = p.y + lutSin(a) * r * 1.18;\n        ctx.ellipse(lx\x2C ly\x2C leafR * 1.45\x2C leafR * 0.72\x2C a\x2C 0\x2C Math.PI * 2);\n      }\n      ctx.fill();\n      ctx.fillStyle = e.color;\n      ctx.beginPath();\n      ctx.arc(p.x\x2C p.y\x2C r\x2C 0\x2C Math.PI * 2);\n      ctx.fill();\n      ctx.fillStyle = 'rgba(225\x2C 255\x2C 190\x2C 0.28)';\n      ctx.beginPath();\n      ctx.arc(p.x - r * 0.25\x2C p.y - r * 0.25\x2C r * 0.42\x2C 0\x2C Math.PI * 2);\n      ctx.fill();\n      if (e._selected) {\n        drawSelectionRing(p\x2C r\x2C colorForCreature(e));\n        drawMapEnergyBar(p\x2C r\x2C e);\n      }\n      return;\n    }\n\n    if (e.type === TYPE.PREDATOR) {\n      ctx.beginPath();\n      ctx.moveTo(p.x + lutCos(e.angle) * r * 1.8\x2C p.y + lutSin(e.angle) * r * 1.8);\n      ctx.lineTo(p.x + lutCos(e.angle + 2.45) * r * 1.35\x2C p.y + lutSin(e.angle + 2.45) * r * 1.35);\n      ctx.lineTo(p.x + lutCos(e.angle - 2.45) * r * 1.35\x2C p.y + lutSin(e.angle - 2.45) * r * 1.35);\n      ctx.closePath();\n      ctx.fill();\n      if (e._selected) {\n        drawSelectionRing(p\x2C r\x2C '#f05b50');\n        drawMapEnergyBar(p\x2C r\x2C e);\n      }\n      return;\n    }\n\n    ctx.beginPath();\n    ctx.arc(p.x\x2C p.y\x2C r\x2C 0\x2C Math.PI * 2);\n    ctx.fill();\n\n    // Flagella drawn in batch by drawFlagellaBatch for performance\n    if (e._selected) {\n      drawSelectionRing(p\x2C r\x2C e.type === TYPE.PRODUCER ? colorForCreature(e) : '#54b7f1');\n      drawMapEnergyBar(p\x2C r\x2C e);\n    }\n  }\n\n  function drawSelectionRing(p\x2C r\x2C color) {\n    const ringR = Math.max(r + 5\x2C 14);\n    const lw = r < 4 ? 3 : 2;\n    ctx.strokeStyle = color;\n    ctx.lineWidth = lw;\n    ctx.beginPath();\n    ctx.arc(p.x\x2C p.y\x2C ringR\x2C 0\x2C Math.PI * 2);\n    ctx.stroke();\n    // At very low zoom\x2C add center dot so selection is always visible\n    if (r < 3) {\n      ctx.fillStyle = color;\n      ctx.beginPath();\n      ctx.arc(p.x\x2C p.y\x2C 2\x2C 0\x2C Math.PI * 2);\n      ctx.fill();\n    }\n  }\n\n  function drawMapEnergyBar(p\x2C r\x2C e) {\n    if (!Number.isFinite(Number(e.energy)) || !Number.isFinite(Number(e.maxEnergy)) || e.maxEnergy <= 0) return;\n    const w = clamp(r * 3.4\x2C 28\x2C 64);\n    const h = 5;\n    const x = Math.round(p.x - w * 0.5);\n    const y = Math.round(p.y - r - 13);\n    ctx.fillStyle = 'rgba(0\x2C 0\x2C 0\x2C 0.52)';\n    ctx.fillRect(x\x2C y\x2C w\x2C h);\n    ctx.fillStyle = ENERGY_COLOR;\n    ctx.fillRect(x\x2C y\x2C Math.max(1\x2C w * energyRatio(e))\x2C h);\n    ctx.strokeStyle = 'rgba(255\x2C255\x2C255\x2C0.26)';\n    ctx.lineWidth = 1;\n    ctx.strokeRect(x + 0.5\x2C y + 0.5\x2C w - 1\x2C h - 1);\n  }\n\n  // Pre-allocated scratch array for batched flagella rendering (x\x2C y\x2C angle\x2C r\x2C flagella per segment)\n  const _flagellaBatch = [];\n\n  // Bucket arrays for batched carcass rendering (8 alpha levels)\n  // Elimina cientos de globalAlpha + strokeStyle changes por frame\n  const _carcBuckets = [];\n  for (let i = 0; i < 8; i++) _carcBuckets.push({ fill: []\x2C stroke: [] });\n\n  function drawCarcasses(offsets) {\n    if (!sim.carcasses.length) return;\n    // World-space viewport bounds (same pattern as render)\n    const wEps = 50 / camera.zoom;\n    const vwMinX = camera.x - window.innerWidth / (2 * camera.zoom) - wEps;\n    const vwMaxX = camera.x + window.innerWidth / (2 * camera.zoom) + wEps;\n    const vwMinY = camera.y - window.innerHeight / (2 * camera.zoom) - wEps;\n    const vwMaxY = camera.y + window.innerHeight / (2 * camera.zoom) + wEps;\n\n    // Reset buckets\n    for (let b = 0; b < 8; b++) { _carcBuckets[b].fill.length = 0; _carcBuckets[b].stroke.length = 0; }\n\n    // Sort visible carcasses into alpha buckets\n    for (let c = 0; c < sim.carcasses.length; c += 1) {\n      const car = sim.carcasses[c];\n      const t = car.life / car.maxLife;\n      if (t > 0.92) continue;\n      const carR = car.radius || 2;\n      const r = Math.max(1\x2C carR * (1 + t * 0.5) * camera.zoom);\n      for (let o = 0; o < offsets.length; o += 1) {\n        const ox = offsets[o].ox;\n        const oy = offsets[o].oy;\n        const wx = car.x + ox;\n        const wy = car.y + oy;\n        if (wx - carR > vwMaxX || wx + carR < vwMinX) continue;\n        if (wy - carR > vwMaxY || wy + carR < vwMinY) continue;\n        const p = worldToScreen(wx\x2C wy);\n        const alpha = (1 - t) * 0.6;\n        const bucketIdx = Math.min(7\x2C (alpha * 13.33) | 0); // 8 buckets\x2C step ~0.075\n        const bucket = _carcBuckets[bucketIdx];\n        bucket.fill.push(p.x\x2C p.y\x2C r);\n        bucket.stroke.push(p.x\x2C p.y\x2C r * 1.4\x2C car.color || '#444');\n      }\n    }\n\n    // Render fills batched (1 style change per bucket instead of per carcass)\n    ctx.fillStyle = '#1a1a1a';\n    for (let b = 0; b < 8; b++) {\n      const fill = _carcBuckets[b].fill;\n      if (!fill.length) continue;\n      ctx.globalAlpha = (b + 0.5) / 8 * 0.6;\n      ctx.beginPath();\n      for (let i = 0; i < fill.length; i += 3) {\n        ctx.moveTo(fill[i]\x2C fill[i + 1]);\n        ctx.arc(fill[i]\x2C fill[i + 1]\x2C fill[i + 2]\x2C 0\x2C Math.PI * 2);\n      }\n      ctx.fill();\n    }\n\n    // Render strokes batched\x2C sub-grouped by color within each alpha bucket\n    ctx.lineWidth = 1;\n    for (let b = 0; b < 8; b++) {\n      const stroke = _carcBuckets[b].stroke;\n      if (!stroke.length) continue;\n      ctx.globalAlpha = (b + 0.5) / 8 * 0.3;\n      let curColor = null;\n      ctx.beginPath();\n      for (let i = 0; i < stroke.length; i += 4) {\n        const col = stroke[i + 3];\n        if (col !== curColor) {\n          if (curColor !== null) { ctx.stroke(); ctx.beginPath(); }\n          curColor = col;\n          ctx.strokeStyle = col;\n        }\n        ctx.moveTo(stroke[i]\x2C stroke[i + 1]);\n        ctx.arc(stroke[i]\x2C stroke[i + 1]\x2C stroke[i + 2]\x2C 0\x2C Math.PI * 2);\n      }\n      if (curColor !== null) ctx.stroke();\n    }\n\n    ctx.globalAlpha = 1;\n  }\n\n  function drawSelectedTrails(offsets) {\n    if (!sim.selectedTrails.size) return;\n    ctx.save();\n    ctx.lineWidth = 1.6;\n    ctx.lineJoin = 'round';\n    ctx.lineCap = 'round';\n    for (const [key\x2C trail] of sim.selectedTrails) {\n      if (!trail || trail.count < 2) continue;\n      const e = creatureByKey(key);\n      const color = e ? colorForCreature(e) : '#9fda69';\n      ctx.strokeStyle = color;\n      ctx.globalAlpha = 0.48;\n      const start = (trail.head - trail.count + TRAIL_MAX_POINTS) % TRAIL_MAX_POINTS;\n      for (let o = 0; o < offsets.length; o += 1) {\n        const { ox\x2C oy } = offsets[o];\n        ctx.beginPath();\n        for (let i = 0; i < trail.count; i += 1) {\n          const idx = (start + i) % TRAIL_MAX_POINTS;\n          const p = worldToScreen(trail.xs[idx] + ox\x2C trail.ys[idx] + oy);\n          if (i === 0) ctx.moveTo(p.x\x2C p.y);\n          else ctx.lineTo(p.x\x2C p.y);\n        }\n        ctx.stroke();\n      }\n    }\n    ctx.restore();\n  }\n\n  function render() {\n    resize();\n    clampCamera();\n    // Single visibleTileOffsets call per frame - margin 180 covers largest creatures (radius ~34px)\n    const offsets = visibleTileOffsets(180);\n    drawBackground(offsets);\n    drawProducerField(offsets);\n    drawCarcasses(offsets);\n    drawSelectedTrails(offsets);\n\n    let debugDrawn = 0;\n    // Pre-compute viewport bounds in world-space (avoids per-creature worldToScreen call)\n    const wEps = 50 / camera.zoom;\n    const vwMinX = camera.x - window.innerWidth / (2 * camera.zoom) - wEps;\n    const vwMaxX = camera.x + window.innerWidth / (2 * camera.zoom) + wEps;\n    const vwMinY = camera.y - window.innerHeight / (2 * camera.zoom) - wEps;\n    const vwMaxY = camera.y + window.innerHeight / (2 * camera.zoom) + wEps;\n    // Cached selected set: only rebuild when selection changes (invalidates _selectedKeysCache)\n    if (!sim._selectedKeysCache) sim._selectedKeysCache = new Set(sim.selectedCreatureIds);\n    const _selectedKeys = sim._selectedKeysCache;\n    // Flagella batch: acumular segmentos durante el loop principal para un unico stroke\n    _flagellaBatch.length = 0;\n    const canDrawFlagella = camera.zoom > 0.05;\n    for (let i = 0; i < sim.creatures.length; i += 1) {\n      const e = sim.creatures[i];\n      if (!e || !e.alive) continue;\n      const er = e.radius || 2;\n      e._selected = _selectedKeys.has(creatureKey(e));\n      for (let o = 0; o < offsets.length; o += 1) {\n        const ox = offsets[o].ox;\n        const oy = offsets[o].oy;\n        const wx = e.x + ox;\n        const wy = e.y + oy;\n        if (wx - er > vwMaxX || wx + er < vwMinX) continue;\n        if (wy - er > vwMaxY || wy + er < vwMinY) continue;\n        if (sim.debug && debugDrawn < MAX_DEBUG_RANGES) {\n          drawDebugRange(e\x2C ox\x2C oy);\n          debugDrawn += 1;\n        }\n        drawCreature(e\x2C ox\x2C oy);\n        // Acumular flagella segmentos para consumers visibles\n        if (canDrawFlagella && e.type === TYPE.CONSUMER) {\n          const p = worldToScreen(wx\x2C wy);\n          const fr = Math.max(3\x2C er * camera.zoom);\n          if (fr > 2.2) {\n            _flagellaBatch.push(p.x\x2C p.y\x2C e.angle\x2C fr\x2C e.flagella);\n          }\n        }\n      }\n    }\n\n    // Batch flagella: un solo beginPath+stroke para todos los consumers visibles\n    if (_flagellaBatch.length) {\n      ctx.strokeStyle = 'rgba(255\x2C255\x2C255\x2C0.35)';\n      ctx.lineWidth = 1;\n      ctx.beginPath();\n      for (let fi = 0; fi < _flagellaBatch.length; fi += 5) {\n        const fpx = _flagellaBatch[fi]\x2C fpy = _flagellaBatch[fi + 1]\x2C fang = _flagellaBatch[fi + 2]\x2C frr = _flagellaBatch[fi + 3]\x2C ffl = _flagellaBatch[fi + 4];\n        ctx.moveTo(fpx\x2C fpy);\n        ctx.lineTo(fpx - lutCos(fang) * frr * (1.6 + ffl * 0.5)\x2C fpy - lutSin(fang) * frr * (1.6 + ffl * 0.5));\n      }\n      ctx.stroke();\n    }\n\n    // Overlay dia/noche: tinta oscuro cuando solarEnergy < base (noche)\n    if (sim.dayNightEnabled) {\n      const sinPhase = Math.sin(sim.dayNightPhase);\n      if (sinPhase < 0) {\n        const darkness = (-sinPhase) * 0.35; // 0 a 0.35\n        ctx.setTransform(mainCanvasDpr\x2C 0\x2C 0\x2C mainCanvasDpr\x2C 0\x2C 0);\n        ctx.globalAlpha = darkness;\n        ctx.fillStyle = '#050814';\n        ctx.fillRect(0\x2C 0\x2C window.innerWidth\x2C window.innerHeight);\n        ctx.globalAlpha = 1;\n      }\n    }\n  }\n\n  function updateStats(force = false) {\n    if (!force && sim.time - sim.lastStatsAt < 0.35) return;\n    const dtStats = sim.time - sim.lastStatsAt;\n    sim.lastStatsAt = sim.time;\n    // Energy flow rate: calcular delta de acumuladores desde ultima muestra\n    if (dtStats > 0) {\n      const fa = sim.flowAccum\x2C fp = sim.flowAccumPrev;\n      const dGraze = fa.graze - fp.graze;\n      const dColony = fa.colonyFeed - fp.colonyFeed;\n      const dProdC = fa.prodCGraze - fp.prodCGraze;\n      const dPred = fa.predation - fp.predation;\n      const dCarcassEat = fa.carcassEat - fp.carcassEat;\n      const dCarcassField = fa.carcassToField - fp.carcassToField;\n      const dMetab = fa.metabolism - fp.metabolism;\n      const dRepro = fa.reproduction - fp.reproduction;\n      const dExcret = fa.excretion - fp.excretion;\n      const dThermal = fa.thermal - fp.thermal;\n      const dCarcassExp = fa.carcassExpire - fp.carcassExpire;\n      const energyIn = dGraze + dColony + dProdC + dPred + dCarcassEat + dExcret;\n      const energyOut = dMetab + dRepro + dThermal + dCarcassExp;\n      sim.flowRate.in = energyIn / dtStats;\n      sim.flowRate.out = energyOut / dtStats;\n      sim.flowRate.balance = (energyIn - energyOut) / dtStats;\n      Object.assign(fp\x2C fa);\n    }\n    // Re-sync mobileEnergySum cada ~60s para corregir drift acumulado\n    sim.energyResyncAccum = (sim.energyResyncAccum || 0) + dtStats;\n    if (sim.energyResyncAccum >= 60) {\n      sim.energyResyncAccum = 0;\n      let rs = 0;\n      for (let i = 0; i < sim.creatures.length; i += 1) {\n        const e = sim.creatures[i];\n        if (!e || !e.alive) continue;\n        if (e.type === TYPE.CONSUMER || e.type === TYPE.PREDATOR) rs += e.energy;\n      }\n      sim.mobileEnergySum = rs;\n    }\n    const c = counts();\n    // Thermal entropy check cada ~5s\n    sim.thermalAccumulator += dtStats;\n    if (sim.thermalAccumulator >= 5) {\n      sim.thermalAccumulator = 0;\n      applyThermalDecay();\n    }\n    els.statProducerA.textContent = c.producerDensity.toFixed(3);\n    els.statProducerB.textContent = fmt.format(c.producerB);\n    els.statProducerC.textContent = fmt.format(c.producerC);\n    els.statConsumers.textContent = fmt.format(c.consumers);\n    els.statPredators.textContent = fmt.format(c.predators);\n    els.statEnergy.textContent = c.energyAvg.toFixed(1) + (sim.thermalDecayRate > 0 ? ` \u26a1${(sim.thermalDecayRate * 100).toFixed(1)}%` : '');\n    if (sim.dayNightEnabled) {\n      const sinP = Math.sin(sim.dayNightPhase);\n      const phaseLabel = sinP > 0.5 ? 'D\xeda' : sinP > -0.5 ? 'Atardecer' : 'Noche';\n      els.statSun.textContent = `x${sim.solarEnergy.toFixed(sim.solarEnergy < 2 ? 1 : 0)} (${phaseLabel})`;\n    } else {\n      els.statSun.textContent = `x${sim.solarEnergy.toFixed(sim.solarEnergy < 2 ? 1 : 0)}`;\n    }\n    els.statBirths.textContent = fmt.format(sim.births);\n    els.statDeaths.textContent = fmt.format(sim.deaths);\n    els.statTime.textContent = `${String(Math.floor(sim.time / 60)).padStart(3\x2C '0')}m ${String(Math.floor(sim.time % 60)).padStart(2\x2C '0')}s`;\n    els.statFps.textContent = String(Math.round(sim.fps));\n    // Energy flow balance: verde si positivo\x2C rojo si negativo\n    const fr = sim.flowRate;\n    els.statFlow.textContent = `${fr.balance >= 0 ? '+' : ''}${fr.balance.toFixed(1)}`;\n    els.statFlow.style.color = fr.balance >= 0 ? '#5fd97a' : '#ff6b6b';\n    els.legendProducerA.textContent = c.producerDensity.toFixed(3);\n    els.legendProducerB.textContent = fmt.format(c.producerB);\n    els.legendProducerC.textContent = fmt.format(c.producerC);\n    els.legendConsumers.textContent = fmt.format(c.consumers);\n    els.legendPredators.textContent = fmt.format(c.predators);\n\n    if (force || sim.time - sim.lastGraphAt >= 1) {\n      sim.lastGraphAt = sim.time;\n      sim.graph.push({ t: sim.time\x2C ...c });\n      drawGraph();\n      if (!els.genePanel.classList.contains('hidden')) recordGeneHistory();\n    }\n    if (sim.selectedCreatureIds.length) {\n      sim._inspectThrottle = (sim._inspectThrottle || 0) + 1;\n      if (force || sim._inspectThrottle >= 3) {\n        sim._inspectThrottle = 0;\n        updateInspectors();\n      }\n    }\n  }\n\n  function drawTimeAxis(context\x2C w\x2C h\x2C pxPerSecond) {\n    const maxSeconds = Math.floor((w - 10) / pxPerSecond);\n    if (maxSeconds < 5) return;\n    const candidates = [10\x2C 15\x2C 30\x2C 60\x2C 120\x2C 300\x2C 600];\n    const step = candidates.find((s) => s * pxPerSecond >= 54) || 900;\n    context.save();\n    context.strokeStyle = 'rgba(255\x2C255\x2C255\x2C0.16)';\n    context.fillStyle = 'rgba(220\x2C232\x2C226\x2C0.62)';\n    context.lineWidth = 1;\n    context.font = '10px system-ui\x2C sans-serif';\n    context.textAlign = 'center';\n    context.textBaseline = 'bottom';\n    for (let seconds = 0; seconds <= maxSeconds; seconds += step) {\n      const x = Math.round(w - 5 - seconds * pxPerSecond) + 0.5;\n      context.beginPath();\n      context.moveTo(x\x2C h - 14);\n      context.lineTo(x\x2C h - 4);\n      context.stroke();\n      context.fillText(seconds === 0 ? 'ahora' : `-${seconds}s`\x2C x\x2C h - 16);\n    }\n    context.restore();\n  }\n\n  function drawGraph() {\n    if (els.graphPanel.classList.contains('hidden')) return;\n    const { w\x2C h } = resizeCanvasToDisplay(graphCanvas\x2C graphCtx\x2C 420\x2C 160);\n    graphCtx.clearRect(0\x2C 0\x2C w\x2C h);\n    graphCtx.fillStyle = 'rgba(255\x2C255\x2C255\x2C0.035)';\n    graphCtx.fillRect(0\x2C 0\x2C w\x2C h);\n    graphCtx.strokeStyle = 'rgba(255\x2C255\x2C255\x2C0.10)';\n    graphCtx.lineWidth = 1;\n    for (let y = 20; y < h; y += 35) {\n      graphCtx.beginPath();\n      graphCtx.moveTo(0\x2C y);\n      graphCtx.lineTo(w\x2C y);\n      graphCtx.stroke();\n    }\n    const pxPerSecond = sim.populationPxPerSecond;\n    const visibleSeconds = Math.max(8\x2C Math.floor((w - 10) / pxPerSecond));\n    const minT = Math.max(0\x2C sim.time - visibleSeconds);\n    const range = sim.graph.rangeFrom(minT);\n    if (!range.count) return;\n    const visible = sim.populationSeriesVisible;\n    let max = 10;\n    for (let i = range.head\x2C n = range.head + range.count; i < n; i += 1) {\n      const p = sim.graph.atRaw(i);\n      if (visible.producerDensity) { const v = p.producerDensity * 1000; if (v > max) max = v; }\n      if (visible.producerB) { if (p.producerB > max) max = p.producerB; }\n      if (visible.producerC) { if (p.producerC > max) max = p.producerC; }\n      if (visible.consumers) { if (p.consumers > max) max = p.consumers; }\n      if (visible.predators) { if (p.predators > max) max = p.predators; }\n    }\n    const yForGraphPoint = (p\x2C key) => {\n      const raw = key === 'producerDensity' ? p[key] * 1000 : p[key];\n      return h - 20 - (raw / max) * (h - 34);\n    };\n    const xForGraphPoint = (p) => w - (sim.time - p.t) * pxPerSecond - 5;\n    const drawDensityArea = () => {\n      graphCtx.beginPath();\n      for (let i = range.head\x2C n = range.head + range.count; i < n; i += 1) {\n        const p = sim.graph.atRaw(i);\n        const x = xForGraphPoint(p);\n        const y = yForGraphPoint(p\x2C 'producerDensity');\n        if (i === range.head) graphCtx.moveTo(x\x2C h - 20);\n        graphCtx.lineTo(x\x2C y);\n      }\n      const lastP = sim.graph.atRaw(range.head + range.count - 1);\n      const lastX = xForGraphPoint(lastP);\n      graphCtx.lineTo(lastX\x2C h - 20);\n      graphCtx.closePath();\n      let peak = 0;\n      for (let i = range.head\x2C n = range.head + range.count; i < n; i += 1) {\n        const v = sim.graph.atRaw(i).producerDensity * 1000;\n        if (v > peak) peak = v;\n      }\n      graphCtx.fillStyle = `rgba(118\x2C 210\x2C 93\x2C ${clamp(0.055 + (peak / max) * 0.12\x2C 0.06\x2C 0.18)})`;\n      graphCtx.fill();\n    };\n    const drawLine = (key\x2C color) => {\n      graphCtx.beginPath();\n      graphCtx.strokeStyle = color;\n      graphCtx.lineWidth = 2;\n      let lastX = 0;\n      let lastY = 0;\n      for (let i = range.head\x2C n = range.head + range.count; i < n; i += 1) {\n        const p = sim.graph.atRaw(i);\n        const x = xForGraphPoint(p);\n        const y = yForGraphPoint(p\x2C key);\n        lastX = x;\n        lastY = y;\n        if (i === range.head) graphCtx.moveTo(x\x2C y);\n        else graphCtx.lineTo(x\x2C y);\n      }\n      graphCtx.stroke();\n      if (range.count === 1) {\n        graphCtx.fillStyle = color;\n        graphCtx.beginPath();\n        graphCtx.arc(lastX\x2C lastY\x2C 2.5\x2C 0\x2C Math.PI * 2);\n        graphCtx.fill();\n      }\n    };\n    if (visible.producerDensity) drawDensityArea();\n    if (visible.producerB) drawLine('producerB'\x2C GROUP_COLORS['producer-b']);\n    if (visible.producerC) drawLine('producerC'\x2C GROUP_COLORS['producer-c']);\n    if (visible.consumers) drawLine('consumers'\x2C '#54b7f1');\n    if (visible.predators) drawLine('predators'\x2C '#f05b50');\n    drawTimeAxis(graphCtx\x2C w\x2C h\x2C pxPerSecond);\n  }\n\n  function drawGeneHistory() {\n    if (els.genePanel.classList.contains('hidden')) return;\n    const { w\x2C h } = resizeCanvasToDisplay(geneCanvas\x2C geneCtx\x2C 520\x2C 180);\n    geneCtx.clearRect(0\x2C 0\x2C w\x2C h);\n    geneCtx.fillStyle = 'rgba(255\x2C255\x2C255\x2C0.035)';\n    geneCtx.fillRect(0\x2C 0\x2C w\x2C h);\n    geneCtx.strokeStyle = 'rgba(255\x2C255\x2C255\x2C0.10)';\n    geneCtx.lineWidth = 1;\n    for (let y = 24; y < h; y += 42) {\n      geneCtx.beginPath();\n      geneCtx.moveTo(0\x2C y);\n      geneCtx.lineTo(w\x2C y);\n      geneCtx.stroke();\n    }\n\n    const group = sim.geneHistoryGroup;\n    const allKeys = GROUP_KEYS[group].slice(0\x2C 8);\n    const hidden = geneHiddenSet(group);\n    const keys = allKeys.filter((key) => !hidden.has(key));\n    const pxPerSecond = sim.genePxPerSecond;\n    const visibleSeconds = Math.max(8\x2C Math.floor((w - 10) / pxPerSecond));\n    const minT = Math.max(0\x2C sim.time - visibleSeconds);\n    const range = sim.geneHistory.rangeFrom(minT);\n    let pointCount = 0;\n    for (let i = range.head\x2C n = range.head + range.count; i < n; i += 1) {\n      const p = sim.geneHistory.atRaw(i);\n      if (p[group] && p[group].n > 0) pointCount++;\n    }\n    if (!pointCount) {\n      els.geneSummary.textContent = 'Sin hist\xf3rico todav\xeda.';\n      return;\n    }\n\n    let max = 1;\n    for (let i = range.head\x2C n = range.head + range.count; i < n; i += 1) {\n      const p = sim.geneHistory.atRaw(i);\n      if (!p[group] || p[group].n <= 0) continue;\n      const avg = p[group].avg;\n      for (let j = 0; j < keys.length; j += 1) {\n        const v = avg[keys[j]] || 0;\n        if (v > max) max = v;\n      }\n    }\n    keys.forEach((key\x2C idx) => {\n      const colorIndex = allKeys.indexOf(key);\n      geneCtx.beginPath();\n      geneCtx.strokeStyle = GENE_COLORS[colorIndex % GENE_COLORS.length];\n      geneCtx.lineWidth = 1.8;\n      let lastX = 0;\n      let lastY = 0;\n      let first = true;\n      for (let i = range.head\x2C n = range.head + range.count; i < n; i += 1) {\n        const p = sim.geneHistory.atRaw(i);\n        if (!p[group] || p[group].n <= 0) continue;\n        const x = w - (sim.time - p.t) * pxPerSecond - 5;\n        const y = h - 22 - ((p[group].avg[key] || 0) / max) * (h - 38);\n        lastX = x;\n        lastY = y;\n        if (first) { geneCtx.moveTo(x\x2C y); first = false; }\n        else geneCtx.lineTo(x\x2C y);\n      }\n      geneCtx.stroke();\n      if (pointCount === 1) {\n        geneCtx.fillStyle = GENE_COLORS[colorIndex % GENE_COLORS.length];\n        geneCtx.beginPath();\n        geneCtx.arc(lastX\x2C lastY\x2C 2.3\x2C 0\x2C Math.PI * 2);\n        geneCtx.fill();\n      }\n    });\n\n    drawTimeAxis(geneCtx\x2C w\x2C h\x2C pxPerSecond);\n    let latest = null;\n    for (let i = range.head + range.count - 1; i >= range.head; i -= 1) {\n      const p = sim.geneHistory.atRaw(i);\n      if (p[group] && p[group].n > 0) { latest = p[group]; break; }\n    }\n    if (!latest) { els.geneSummary.textContent = 'Sin hist\xf3rico.'; return; }\n    // Perf: solo reconstruir innerHTML cuando cambia grupo\x2C hidden set o count.\n    // En updates normales (~1s)\x2C solo actualizar los valores <b> y el header count.\n    const hiddenKey = hidden.size ? Array.from(hidden).sort().join('|') : '';\n    const structKey = group + ':' + hiddenKey;\n    if (els._geneLastStruct !== structKey) {\n      els._geneLastStruct = structKey;\n      const labels = allKeys.map((key\x2C idx) => {\n        const disabled = hidden.has(key) ? ' disabled' : '';\n        return `<button class="gene-toggle${disabled}" type="button" data-gene-key="${escapeHtml(key)}" style="--gene-color:${GENE_COLORS[idx % GENE_COLORS.length]}">${escapeHtml(key)} <b>${formatValue(latest.avg[key])}</b></button>`;\n      });\n      els.geneSummary.innerHTML = `<strong>${GROUP_LABELS[group]}: <b style="color:${GROUP_COLORS[group]}">${fmt.format(latest.n)}</b></strong>${labels.join('')}`;\n    } else {\n      // Update solo valores: header count + cada boton <b>\n      const strong = els.geneSummary.querySelector('strong > b');\n      if (strong) strong.textContent = fmt.format(latest.n);\n      const btns = els.geneSummary.querySelectorAll('[data-gene-key]');\n      for (let bi = 0; bi < btns.length; bi += 1) {\n        const b = btns[bi];\n        const valEl = b.querySelector('b');\n        if (valEl) valEl.textContent = formatValue(latest.avg[b.dataset.geneKey]);\n      }\n    }\n  }\n\n  function animationLoop(ts) {\n    sim.frameCounter += 1;\n    if (ts - sim.fpsAt >= 700) {\n      sim.fps = sim.frameCounter * 1000 / (ts - sim.fpsAt);\n      sim.frameCounter = 0;\n      sim.fpsAt = ts;\n    }\n\n    if (!sim.lastFrame) sim.lastFrame = ts;\n    const elapsed = Math.min(0.08\x2C (ts - sim.lastFrame) / 1000);\n    sim.lastFrame = ts;\n\n    if (!sim.paused) {\n      // Fixed timestep accumulator: desacopla sim de framerate del monitor.\n      // En 144Hz\x2C la mitad de frames solo renderizan (sin rebuildGrid/simulate).\n      // SIM_FRAME = 1/60s; sim corre a ~60Hz fijo independientemente del refresh rate.\n      const SIM_FRAME = 1 / 60;\n      if (sim.simAccum == null) sim.simAccum = 0;\n      sim.simAccum += elapsed * sim.speed;\n      // Cap anti-spiral: si acumula demasiado (tab inactivo\x2C lag)\x2C descargar exceso\n      // Permite hasta MAX_SIM_CHUNKS steps por frame para no perder velocidad de sim\n      const SIM_ACCUM_CAP = SIM_FRAME * MAX_SIM_CHUNKS;\n      if (sim.simAccum > SIM_ACCUM_CAP) sim.simAccum = SIM_ACCUM_CAP;\n      while (sim.simAccum >= SIM_FRAME) {\n        const scaled = SIM_FRAME;\n        const chunks = Math.max(1\x2C Math.min(MAX_SIM_CHUNKS\x2C Math.ceil(scaled / MAX_DT)));\n        const dt = Math.min(scaled / chunks\x2C MAX_DT);\n        const simTime = chunks * dt;\n        const remainder = scaled - simTime;\n        compactIfNeeded();\n        rebuildGrid();\n        for (let i = 0; i < chunks; i += 1) {\n          simulate(dt);\n          if ((i + 1) % GRID_REFRESH_INTERVAL === 0 && i + 1 < chunks) rebuildGrid();\n        }\n        if (remainder > 0 && chunks < MAX_SIM_CHUNKS) simulate(Math.min(remainder\x2C MAX_DT));\n        sim.simAccum -= scaled;\n      }\n    }\n\n    updateCameraFollow();\n    render();\n    updateStats();\n    requestAnimationFrame(animationLoop);\n  }\n\n  function speedFromSlider(value) {\n    const t = Number(value) / 100;\n    if (t < 0.34) return 0.2 + (t / 0.34) * 0.8;\n    const u = (t - 0.34) / 0.66;\n    return 1 + Math.pow(u\x2C 2.15) * 99;\n  }\n\n  function setSpeed() {\n    sim.speed = speedFromSlider(els.speed.value);\n    els.speedLabel.textContent = sim.speed < 1 ? `/${Math.round(1 / sim.speed)}` : `x${sim.speed.toFixed(sim.speed < 10 ? 1 : 0)}`;\n  }\n\n  function energyFromSlider(value) {\n    const t = Number(value) / 100;\n    if (t < 0.5) return 0.1 + (t / 0.5) * 0.9;\n    return 1 + Math.pow((t - 0.5) / 0.5\x2C 1.65) * 5;\n  }\n\n  function setSystemEnergy() {\n    sim.solarEnergyBase = energyFromSlider(els.systemEnergy.value);\n    if (!sim.dayNightEnabled) sim.solarEnergy = sim.solarEnergyBase;\n    els.systemEnergyLabel.textContent = `x${sim.solarEnergyBase.toFixed(sim.solarEnergyBase < 2 ? 1 : 0)}`;\n    updateStats(true);\n  }\n\n  function toggleDayNight() {\n    sim.dayNightEnabled = !sim.dayNightEnabled;\n    els.dayNightToggle.classList.toggle('active'\x2C sim.dayNightEnabled);\n    if (!sim.dayNightEnabled) sim.solarEnergy = sim.solarEnergyBase;\n    updateStats(true);\n  }\n\n  function stepSlider(input\x2C amount\x2C onChange) {\n    const min = Number(input.min || 0);\n    const max = Number(input.max || 100);\n    input.value = String(clamp(Number(input.value || 0) + amount\x2C min\x2C max));\n    onChange();\n  }\n\n  function setPaused(paused) {\n    sim.paused = paused;\n    els.playPause.innerHTML = paused ? '<span class="btn-icon">\u25b6</span><span>Play</span>' : '<span class="btn-icon">\u23f8</span><span>Pausa</span>';\n    els.playPause.classList.toggle('active'\x2C paused);\n  }\n\n  function setSeed(seed) {\n    sim.seed = seed >>> 0;\n    _rng = mulberry32(sim.seed);\n  }\n\n  function resetWorld() {\n    // Inicializar PRNG con seed aleatorio si no hay seed explicito\n    if (!sim.seed) sim.seed = (Math.random() * 4294967296) >>> 0;\n    setSeed(sim.seed);\n    sim.creatures = [];\n    sim.creatureIndex.clear();\n    sim.freeIds = [];\n    initGrid();\n    initProducerField();\n    sim.time = 0;\n    sim.births = 0;\n    sim.deaths = 0;\n    sim.predatorCount = 0;\n    sim.liveConsumerCount = 0;\n    sim.liveProducerBCount = 0;\n    sim.liveProducerCCount = 0;\n    sim.mobileEnergySum = 0;\n    sim.carcasses.length = 0;\n    sim.migrationTimer = 0;\n    sim.graph.clear();\n    sim.geneHistory.clear();\n    sim.lastGraphAt = -Infinity;\n    sim.lastStatsAt = -Infinity;\n    sim.selectedCreatureId = null;\n    sim.selectedCreatureIds = [];\n    sim._selectedKeysCache = null;\n    sim.selectedTrails.clear();\n    sim.followCreatureId = null;\n    sim.lastCenteredCreatureId = null;\n    sim.nextCreatureUid = 1;\n    document.querySelectorAll('.inspect-panel[data-inspect-uid]').forEach((panel) => {\n      if (panel === els.inspectPanel) {\n        panel.classList.add('hidden');\n        panel.removeAttribute('data-inspect-uid');\n      } else {\n        panel.remove();\n      }\n    });\n    seedWorld();\n    recordGeneHistory();\n    if (LOG_EVENTS) logEvent('Ecosistema reiniciado'\x2C 'info');\n    updateStats(true);\n  }\n\n  function seedWorld() {\n    const areaFactor = clamp((WORLD.w * WORLD.h) / (4000 * 2250)\x2C 0.35\x2C 6);\n    for (let i = 0; i < Math.round(12 * areaFactor); i += 1) spawnProducer(lightningProducerOptions(PRODUCER.B\x2C i));\n    for (let i = 0; i < Math.round(38 * areaFactor); i += 1) spawnProducer(lightningProducerOptions(PRODUCER.C\x2C i));\n    for (let i = 0; i < Math.round(120 * areaFactor); i += 1) spawnConsumer(lightningMobileOptions('consumer'\x2C i));\n    for (let i = 0; i < Math.round(5 * areaFactor); i += 1) spawnPredator(lightningMobileOptions('predator'\x2C i));\n    if (LOG_EVENTS) logEvent('Seed inicial: biomasa base\x2C consumidores y depredadores');\n  }\n\n  function vary(value\x2C ratio = 0.18\x2C min = -Infinity\x2C max = Infinity) {\n    return clamp(value * rand(1 - ratio\x2C 1 + ratio)\x2C min\x2C max);\n  }\n\n  function averageExisting(group\x2C minCount = 6) {\n    const keys = GROUP_KEYS[group] || [];\n    const sums = Object.fromEntries(keys.map((key) => [key\x2C 0]));\n    let n = 0;\n    for (let i = 0; i < sim.creatures.length; i += 1) {\n      const e = sim.creatures[i];\n      if (!e || !e.alive || groupForCreature(e) !== group) continue;\n      n += 1;\n      for (let k = 0; k < keys.length; k += 1) sums[keys[k]] += Number(e[keys[k]] || 0);\n    }\n    if (n < minCount) return null;\n    const avg = {};\n    for (let k = 0; k < keys.length; k += 1) avg[keys[k]] = sums[keys[k]] / n;\n    return avg;\n  }\n\n  function adaptiveBase(kind\x2C sub = null) {\n    if (kind === 'producer') {\n      const group = sub === PRODUCER.B ? 'producer-b' : 'producer-c';\n      return { ...defaultAddValues(kind\x2C sub)\x2C ...(averageExisting(group\x2C isColonyProducer(sub) ? 5 : 12) || {}) };\n    }\n    return { ...defaultAddValues(kind)\x2C ...(averageExisting(kind\x2C kind === 'predator' ? 4 : 12) || {}) };\n  }\n\n  function balancedMovementMask(i) {\n    const primary = i % MOVE.length;\n    let mask = 1 << primary;\n    if (chance(0.34)) mask |= 1 << ((primary + 1 + Math.floor(rand(0\x2C MOVE.length - 1))) % MOVE.length);\n    return mask;\n  }\n\n  function lightningProducerOptions(sub\x2C i) {\n    const base = adaptiveBase('producer'\x2C sub);\n    if (isColonyProducer(sub)) {\n      return {\n        sub\x2C\n        radius: vary(base.radius\x2C 0.22\x2C 12\x2C 34)\x2C\n        armor: vary(base.armor\x2C 0.18\x2C 2.4\x2C 7)\x2C\n        fertility: vary(base.fertility\x2C 0.18\x2C 0.012\x2C 0.075)\x2C\n        maxAge: vary(base.maxAge\x2C 0.28\x2C 8500\x2C 22000)\n      };\n    }\n    return {\n      sub\x2C\n      radius: vary(base.radius\x2C 0.22\x2C 3\x2C 8)\x2C\n      armor: vary(base.armor\x2C 0.20\x2C 1.8\x2C 4.6)\x2C\n      fertility: vary(base.fertility\x2C 0.18\x2C 0.010\x2C 0.050)\x2C\n      speed: vary(base.speed\x2C 0.24\x2C 14\x2C 50)\x2C\n      perception: DEFAULT_INITIAL_PERCEPTION\x2C\n      chemosense: vary(base.chemosense\x2C 0.18\x2C 1.4\x2C 4.2)\x2C\n      maxAge: vary(base.maxAge\x2C 0.24\x2C 4200\x2C 12500)\x2C\n      movementMask: balancedMovementMask(i)\n    };\n  }\n\n  function lightningMobileOptions(kind\x2C i) {\n    const pred = kind === 'predator';\n    const base = adaptiveBase(kind);\n    return {\n      size: vary(base.size\x2C 0.28\x2C pred ? 2.2 : 0.8\x2C pred ? 9 : 6)\x2C\n      reserves: vary(base.reserves\x2C 0.28\x2C pred ? 5 : 1\x2C pred ? 20 : 8)\x2C\n      flagella: clamp(Math.round(vary(base.flagella + (i % 3) - 1\x2C 0.18\x2C 0\x2C pred ? 6 : 5))\x2C 0\x2C pred ? 6 : 5)\x2C\n      cilia: clamp(Math.round(vary(base.cilia + ((i + 1) % 3) - 1\x2C 0.18\x2C 0\x2C 6))\x2C 0\x2C 6)\x2C\n      chemosense: vary(base.chemosense\x2C 0.28\x2C pred ? 1.1 : 0.4\x2C pred ? 4.4 : 3.4)\x2C\n      pseudopodia: vary(base.pseudopodia\x2C 0.32\x2C 0\x2C pred ? 3.2 : 3.8)\x2C\n      armor: vary(base.armor\x2C 0.30\x2C pred ? 0.8 : 0\x2C pred ? 4 : 2.8)\x2C\n      vacuole: vary(base.vacuole\x2C 0.24\x2C 0.3\x2C 3.2)\x2C\n      maxAge: vary(base.maxAge ?? (pred ? 9200 : 3600)\x2C 0.24\x2C pred ? 6200 : 2400\x2C pred ? 14000 : 6200)\x2C\n      feeding: i % FEEDING.length\x2C\n      movementMask: balancedMovementMask(i)\x2C\n      fertility: vary(base.fertility\x2C 0.20\x2C 0.45\x2C 2.2)\n    };\n  }\n\n  function spawnLightningBatch(kind\x2C sub = null\x2C amount = null) {\n    let created = 0;\n    if (kind === 'producer') {\n      const producerSub = sub ?? PRODUCER.B;\n      const total = amount ?? (isMobileProducer(producerSub) ? 36 : 14);\n      for (let i = 0; i < total; i += 1) {\n        spawnProducer(lightningProducerOptions(producerSub\x2C i));\n        created += 1;\n      }\n    } else if (kind === 'consumer') {\n      const total = amount ?? 48;\n      for (let i = 0; i < total; i += 1) {\n        spawnConsumer(lightningMobileOptions(kind\x2C i));\n        created += 1;\n      }\n    } else {\n      const total = amount ?? 16;\n      for (let i = 0; i < total; i += 1) {\n        spawnPredator(lightningMobileOptions(kind\x2C i));\n        created += 1;\n      }\n    }\n    sim.births += created;\n    updateStats(true);\n  }\n\n  function addLightningMix() {\n    const form = new FormData(els.addForm);\n    if (sim.selectedAddKind === 'producer') {\n      spawnLightningBatch('producer'\x2C Number(form.get('sub') ?? PRODUCER.B));\n    } else if (sim.selectedAddKind === 'consumer') {\n      spawnLightningBatch('consumer');\n    } else {\n      spawnLightningBatch('predator');\n    }\n  }\n\n  function defaultAddValues(kind\x2C sub = PRODUCER.B) {\n    if (kind === 'producer') {\n      return {\n        amount: ADD_AMOUNT_DEFAULT\x2C\n        sub\x2C\n        radius: isColonyProducer(sub) ? 18 : 5\x2C\n        armor: isColonyProducer(sub) ? 3.8 : 3.0\x2C\n        fertility: isMobileProducer(sub) ? PRODUCER_C_DEFAULT_FERTILITY : 0.024\x2C\n        speed: 24\x2C\n        perception: DEFAULT_INITIAL_PERCEPTION\x2C\n        chemosense: 2.7\x2C\n        movementMask: 2\x2C\n        maxAge: isColonyProducer(sub) ? 12000 : 6800\n      };\n    }\n    return {\n      amount: ADD_AMOUNT_DEFAULT\x2C\n      size: kind === 'predator' ? 5 : 2.4\x2C\n      flagella: kind === 'predator' ? 3 : 1\x2C\n      cilia: kind === 'predator' ? 1 : 2\x2C\n      reserves: kind === 'predator' ? 12 : 5\x2C\n      pseudopodia: kind === 'predator' ? 0.8 : 1.2\x2C\n      armor: kind === 'predator' ? 2 : 0.6\x2C\n      chemosense: kind === 'predator' ? 2.4 : 1.6\x2C\n      vacuole: 1.2\x2C\n      feeding: 0\x2C\n      movementMask: 2\x2C\n      fertility: 1\x2C\n      maxAge: kind === 'predator' ? 9200 : 3600\n    };\n  }\n\n  function savedAddValues(kind\x2C sub = null\x2C forceDefaults = false) {\n    const saved = forceDefaults ? null : sim.lastAddValues[kind];\n    if (kind === 'producer') {\n      const wantedSub = sub ?? Number(saved?.sub ?? PRODUCER.B);\n      return { ...defaultAddValues(kind\x2C wantedSub)\x2C ...(saved && Number(saved.sub) === wantedSub ? saved : {})\x2C sub: wantedSub };\n    }\n    return { ...defaultAddValues(kind)\x2C ...(saved || {}) };\n  }\n\n  function cloneAddValues(e) {\n    const amount = ADD_AMOUNT_DEFAULT;\n    if (e.type === TYPE.PRODUCER) {\n      return {\n        amount\x2C\n        sub: e.sub\x2C\n        radius: Number(e.radius || defaultAddValues('producer'\x2C e.sub).radius)\x2C\n        armor: Number(e.armor || 0)\x2C\n        fertility: Number(e.fertility || defaultAddValues('producer'\x2C e.sub).fertility)\x2C\n        speed: Number(e.speed || defaultAddValues('producer'\x2C e.sub).speed)\x2C\n        perception: Number(e.perception || defaultAddValues('producer'\x2C e.sub).perception)\x2C\n        chemosense: Number(e.chemosense || defaultAddValues('producer'\x2C e.sub).chemosense)\x2C\n        movementMask: movementMaskFromLegacy(e)\x2C\n        maxAge: Number.isFinite(Number(e.maxAge)) ? Number(e.maxAge) : defaultAddValues('producer'\x2C e.sub).maxAge\n      };\n    }\n    const kind = e.type === TYPE.PREDATOR ? 'predator' : 'consumer';\n    return {\n      amount\x2C\n      size: Number(e.size || defaultAddValues(kind).size)\x2C\n      flagella: Number(e.flagella || 0)\x2C\n      cilia: Number(e.cilia || 0)\x2C\n      reserves: Number(e.reserves || defaultAddValues(kind).reserves)\x2C\n      pseudopodia: Number(e.pseudopodia || 0)\x2C\n      armor: Number(e.armor || 0)\x2C\n      chemosense: Number(e.chemosense || defaultAddValues(kind).chemosense)\x2C\n      vacuole: Number(e.vacuole || defaultAddValues(kind).vacuole)\x2C\n      feeding: Number(e.feeding || 0)\x2C\n      movementMask: movementMaskFromLegacy(e)\x2C\n      maxAge: Number.isFinite(Number(e.maxAge)) ? Number(e.maxAge) : defaultAddValues(kind).maxAge\x2C\n      fertility: Number(e.fertility || defaultAddValues(kind).fertility)\n    };\n  }\n\n  function openCloneDialog(key) {\n    const e = creatureByKey(key);\n    if (!e || !e.alive || e.sub === PRODUCER.A) return;\n    const kind = e.type === TYPE.PRODUCER ? 'producer' : e.type === TYPE.PREDATOR ? 'predator' : 'consumer';\n    sim.lastAddValues[kind] = cloneAddValues(e);\n    renderAddDialog(kind);\n    els.addDialog.showModal();\n  }\n\n  function collectAddValues(form) {\n    const values = {};\n    for (const [key\x2C value] of form.entries()) {\n      if (key !== 'movementBits') values[key] = Number(value);\n    }\n    const movementBits = form.getAll('movementBits');\n    if (movementBits.length) values.movementMask = movementMaskFromValue(movementBits);\n    return values;\n  }\n\n  function numberField(name\x2C label\x2C value\x2C min\x2C max\x2C step = 1\x2C hint = '') {\n    return `\n      <div class="field">\n        <label for="${name}">${labelWithTip(name\x2C label\x2C hint)}</label>\n        <input id="${name}" name="${name}" type="number" value="${value}" min="${min}" max="${max}" step="${step}">\n      </div>\n    `;\n  }\n\n  function rangeField(name\x2C label\x2C value\x2C min\x2C max\x2C step = 1\x2C hint = '') {\n    return `\n      <div class="field range-field">\n        <label for="${name}">${labelWithTip(name\x2C label\x2C hint)}</label>\n        <div class="range-row">\n          <input id="${name}" name="${name}" type="range" value="${value}" min="${min}" max="${max}" step="${step}" data-range-output="${name}Out">\n          <output id="${name}Out" for="${name}">${value}</output>\n        </div>\n      </div>\n    `;\n  }\n\n  function segmentedField(name\x2C label\x2C value\x2C options\x2C hint = '') {\n    const opts = options.map((opt\x2C idx) => {\n      const val = Array.isArray(opt) ? opt[0] : idx;\n      const text = Array.isArray(opt) ? opt[1] : opt;\n      const tip = Array.isArray(opt) ? opt[2] : '';\n      return `<label class="segment" title="${escapeHtml(tip || text)}"><input type="radio" name="${name}" value="${val}" ${String(val) === String(value) ? 'checked' : ''}><span>${escapeHtml(text)}</span></label>`;\n    }).join('');\n    return `\n      <div class="field wide">\n        <label>${labelWithTip(name\x2C label\x2C hint)}</label>\n        <div class="segments">${opts}</div>\n      </div>\n    `;\n  }\n\n  function selectField(name\x2C label\x2C value\x2C options\x2C hint = '') {\n    const opts = options.map((opt\x2C idx) => {\n      const val = Array.isArray(opt) ? opt[0] : idx;\n      const text = Array.isArray(opt) ? opt[1] : opt;\n      return `<option value="${val}" ${String(val) === String(value) ? 'selected' : ''}>${escapeHtml(text)}</option>`;\n    }).join('');\n    return `\n      <div class="field">\n        <label for="${name}">${labelWithTip(name\x2C label\x2C hint)}</label>\n        <select id="${name}" name="${name}">${opts}</select>\n      </div>\n    `;\n  }\n\n  function movementField(name\x2C label\x2C selectedMask\x2C hint = '') {\n    const opts = MOVE_INFO.map(([move\x2C text]\x2C idx) => {\n      const bit = 1 << idx;\n      return `<label class="segment" title="${escapeHtml(text)}"><input type="checkbox" name="${name}" value="${idx}" ${(selectedMask & bit) ? 'checked' : ''}><span>${escapeHtml(move)}</span></label>`;\n    }).join('');\n    return `\n      <div class="field wide">\n        <label>${labelWithTip(name\x2C label\x2C hint)}</label>\n        <div class="segments multi">${opts}</div>\n      </div>\n    `;\n  }\n\n  function previewField(visualFields = '') {\n    return `<div class="field wide preview-field visual-config"><div id="addPreview"></div><div class="visual-fields">${visualFields}</div></div>`;\n  }\n\n  function collectAddPreviewData() {\n    const form = new FormData(els.addForm);\n    const data = {};\n    for (const [key\x2C value] of form.entries()) {\n      if (key !== 'movementBits') data[key] = Number(value);\n    }\n    if (sim.selectedAddKind === 'producer') {\n      data.type = TYPE.PRODUCER;\n      data.kind = 'producer';\n      data.sub = Number(data.sub ?? PRODUCER.B);\n      if (isColonyProducer(data.sub) && data.leafCount == null) data.leafCount = Math.max(2\x2C Math.floor(2 + Number(data.radius || 18) / 8));\n    } else {\n      data.kind = sim.selectedAddKind;\n      data.type = sim.selectedAddKind === 'predator' ? TYPE.PREDATOR : TYPE.CONSUMER;\n      data.radius = 3.5 + Number(data.size || 1) * 1.72 + Number(data.reserves || 0) * 0.34;\n    }\n    return data;\n  }\n\n  function updateAddPreview() {\n    const target = document.getElementById('addPreview');\n    if (!target) return;\n    target.innerHTML = previewHtml(collectAddPreviewData());\n  }\n\n  function bindDynamicFields() {\n    els.dynamicFields.querySelectorAll('input[type="range"][data-range-output]').forEach((input) => {\n      const out = document.getElementById(input.dataset.rangeOutput);\n      const update = () => {\n        if (out) out.textContent = input.value;\n        updateAddPreview();\n      };\n      input.addEventListener('input'\x2C update);\n      update();\n    });\n    els.dynamicFields.querySelectorAll('input\x2C select').forEach((input) => {\n      input.addEventListener('input'\x2C updateAddPreview);\n      input.addEventListener('change'\x2C updateAddPreview);\n    });\n    updateAddPreview();\n  }\n\n  function renderAddDialog(kind\x2C forceDefaults = false) {\n    sim.selectedAddKind = kind;\n    els.quickMix.hidden = false;\n    els.defaultsAdd.hidden = false;\n    const title = kind === 'producer' ? 'A\xf1adir productores' : kind === 'consumer' ? 'A\xf1adir consumidores' : 'A\xf1adir depredadores';\n    els.dialogKindLabel.textContent = 'Configuraci\xf3n inicial';\n    els.dialogTitle.textContent = title;\n    const initial = savedAddValues(kind\x2C null\x2C forceDefaults);\n    const common = rangeField('amount'\x2C 'Cantidad'\x2C initial.amount ?? ADD_AMOUNT_DEFAULT\x2C 1\x2C ADD_AMOUNT_MAX\x2C 1\x2C 'N\xfamero de entidades a crear repartidas por todo el ecosistema. Valores altos pueden afectar al rendimiento.');\n    if (kind === 'producer') {\n      const renderProducerForm = (sub = PRODUCER.B\x2C producerForceDefaults = false) => {\n        const values = savedAddValues(kind\x2C sub\x2C forceDefaults || producerForceDefaults);\n        const amountField = rangeField('amount'\x2C 'Cantidad'\x2C values.amount ?? ADD_AMOUNT_DEFAULT\x2C 1\x2C ADD_AMOUNT_MAX\x2C 1\x2C 'N\xfamero de entidades a crear repartidas por todo el ecosistema. Valores altos pueden afectar al rendimiento.');\n        const visualFields = rangeField('radius'\x2C 'Tama\xf1o base'\x2C values.radius\x2C 2\x2C 40\x2C 0.5\x2C 'Radio inicial. En Tipo B aumenta con el sol hasta su radio m\xe1ximo; en Tipo C afecta a contacto y visibilidad.')\n          + rangeField('armor'\x2C 'Armadura'\x2C values.armor\x2C 0\x2C 7\x2C 0.1\x2C 'Resistencia f\xedsica: consumidores y depredadores necesitan alimentaci\xf3n y fenotipo suficientes para atravesarla.');\n        els.dynamicFields.innerHTML = amountField\n          + segmentedField('sub'\x2C 'Modelo productor'\x2C sub\x2C [[1\x2C 'Tipo B'\x2C 'Colonia fija grande: crece\x2C genera hojas comestibles y muere por edad.']\x2C [2\x2C 'Tipo C'\x2C 'Productor m\xf3vil: detecta consumidores y depredadores y huye.']]\x2C 'Tipo A queda como densidad agregada del campo y crece con la energ\xeda del sistema; B y C s\xed entran en la rejilla espacial.')\n          + previewField(visualFields)\n          + rangeField('fertility'\x2C 'Reproducci\xf3n'\x2C values.fertility\x2C 0.004\x2C 0.18\x2C 0.001\x2C 'Multiplica la velocidad del cooldown reproductivo; tambi\xe9n escala con la energ\xeda solar. En productores entidad conviene mantenerlo bajo.')\n          + (isMobileProducer(sub)\n            ? rangeField('speed'\x2C 'Velocidad Tipo C'\x2C values.speed\x2C 0\x2C 80\x2C 1\x2C 'Velocidad de productores m\xf3viles. M\xe1s velocidad ayuda a huir\x2C pero captar sol en movimiento es lento y reproducirse cuesta m\xe1s.')\n              + rangeField('perception'\x2C 'Percepci\xf3n Tipo C'\x2C values.perception\x2C 40\x2C PRODUCER_C_MAX_PERCEPTION\x2C 5\x2C 'Rango para detectar consumidores y depredadores cercanos. Arranca igual que consumidores y depredadores; subirlo mucho rompe el equilibrio.')\n              + rangeField('chemosense'\x2C 'Quimiosensibilidad Tipo C'\x2C values.chemosense\x2C 0\x2C 5\x2C 0.1\x2C 'Aumenta orientaci\xf3n y percepci\xf3n efectiva\x2C pero encarece mantener rangos altos.')\n              + movementField('movementBits'\x2C 'Movimientos Tipo C'\x2C values.movementMask\x2C 'Puede tener varios algoritmos simult\xe1neos. En reproducci\xf3n asexual mutan muy poco.')\n            : '')\n          + (isColonyProducer(sub)\n            ? rangeField('maxAge'\x2C 'Vida m\xe1xima'\x2C values.maxAge\x2C 3000\x2C 24000\x2C 50\x2C 'Tiempo medio antes de morir por senescencia. Se hereda con margen controlado.')\n            : '');\n        bindDynamicFields();\n        els.dynamicFields.querySelectorAll('input[name="sub"]').forEach((input) => {\n          input.addEventListener('change'\x2C () => renderProducerForm(Number(input.value)));\n        });\n      };\n      renderProducerForm(Number(initial.sub ?? PRODUCER.B));\n    } else {\n      const values = initial;\n      const visualFields = rangeField('size'\x2C 'Tama\xf1o'\x2C values.size\x2C 0.5\x2C 12\x2C 0.1\x2C 'Aumenta radio\x2C energ\xeda m\xe1xima y capacidad de pastar hojas blindadas\x2C pero sube masa\x2C coste basal y reduce velocidad.')\n        + rangeField('flagella'\x2C 'Flagelos'\x2C values.flagella\x2C 0\x2C 7\x2C 1\x2C 'Aumentan impulso\x2C pero ahora tienen coste no lineal: muchos flagelos a\xf1aden rozamiento\x2C masa funcional y gasto energ\xe9tico alto.')\n        + rangeField('cilia'\x2C 'Cilios'\x2C values.cilia\x2C 0\x2C 6\x2C 1\x2C 'Aumentan micropropulsi\xf3n\x2C percepci\xf3n cercana y alcance de filtrado\x2C con coste moderado.')\n        + rangeField('reserves'\x2C 'Reservas'\x2C values.reserves\x2C 0\x2C kind === 'predator' ? 24 : 14\x2C 0.1\x2C 'Ampl\xedan energ\xeda m\xe1xima y supervivencia\x2C pero a\xf1aden masa y hacen al ser m\xe1s lento.')\n        + rangeField('pseudopodia'\x2C 'Pseud\xf3podos'\x2C values.pseudopodia\x2C 0\x2C 4\x2C 0.1\x2C 'Mejoran mordida y consumo de hojas/presas\x2C pero aportan coste y rozamiento.')\n        + rangeField('armor'\x2C 'Pel\xedcula / armadura'\x2C values.armor\x2C 0\x2C 5\x2C 0.1\x2C 'Aumenta masa y coste; queda preparada para ventajas defensivas futuras.');\n      els.dynamicFields.innerHTML = common\n        + previewField(visualFields)\n        + rangeField('chemosense'\x2C 'Quimiosensibilidad'\x2C values.chemosense\x2C 0\x2C 5\x2C 0.1\x2C 'Mejora atracci\xf3n hacia alimento/presa y orientaci\xf3n si tiene movimiento quimiot\xe1ctico.')\n        + rangeField('vacuole'\x2C 'Vacuola contr\xe1ctil'\x2C values.vacuole\x2C 0\x2C 4\x2C 0.1\x2C 'Reduce parcialmente el metabolismo efectivo\x2C compensando algo el coste de tama\xf1o y movilidad.')\n        + segmentedField('feeding'\x2C 'Alimentaci\xf3n'\x2C values.feeding\x2C FEEDING_INFO.map((item\x2C idx) => [idx\x2C item[0]\x2C item[1]])\x2C 'Modo de alimentaci\xf3n: modifica alcance\x2C mordida y eficiencia al comer biomasa\x2C hojas o presas.')\n        + movementField('movementBits'\x2C 'Movimientos'\x2C values.movementMask\x2C 'Puede combinar varios algoritmos. La reproducci\xf3n mezcla los algoritmos activos de ambos padres.')\n        + rangeField('maxAge'\x2C 'Vida m\xe1xima'\x2C values.maxAge\x2C kind === 'predator' ? 5000 : 1800\x2C kind === 'predator' ? 15000 : 8000\x2C 50\x2C 'Tiempo medio antes de morir por senescencia. M\xe1s vida permite que fenotipos lentos tengan opciones.')\n        + rangeField('fertility'\x2C 'Fertilidad'\x2C values.fertility\x2C 0.2\x2C 3\x2C 0.1\x2C 'Reduce cooldown reproductivo cuando hay energ\xeda suficiente. Los hijos heredan cerca del rango parental con poca variaci\xf3n.');\n      bindDynamicFields();\n    }\n  }\n\n  function openAddDialog(kind) {\n    renderAddDialog(kind);\n    els.addDialog.showModal();\n  }\n\n  function openWorldDialog() {\n    sim.selectedAddKind = 'world';\n    els.quickMix.hidden = true;\n    els.defaultsAdd.hidden = true;\n    els.dialogKindLabel.textContent = 'Tama\xf1o del ecosistema';\n    els.dialogTitle.textContent = 'Configurar mundo 16:9';\n    els.dynamicFields.innerHTML =\n      selectField('preset'\x2C 'Preset'\x2C 'custom'\x2C [\n        ['4000x2250'\x2C '1/4 \xb7 4.000 x 2.250']\x2C\n        ['8000x4500'\x2C '1/2 \xb7 8.000 x 4.500']\x2C\n        ['16000x9000'\x2C 'Completo por defecto \xb7 16.000 x 9.000']\x2C\n        ['custom'\x2C 'Personalizado']\n      ]\x2C 'Cambiar el tama\xf1o reinicia el ecosistema.')\n      + numberField('width'\x2C 'Ancho'\x2C WORLD.w\x2C 1000\x2C 32000\x2C 1)\n      + numberField('height'\x2C 'Alto'\x2C WORLD.h\x2C 563\x2C 18000\x2C 1\x2C 'Se fuerza proporci\xf3n 16:9 al aplicar.');\n    const preset = document.getElementById('preset');\n    const width = document.getElementById('width');\n    const height = document.getElementById('height');\n    preset.addEventListener('change'\x2C () => {\n      if (preset.value === 'custom') return;\n      const [w\x2C h] = preset.value.split('x').map(Number);\n      width.value = w;\n      height.value = h;\n    });\n    width.addEventListener('input'\x2C () => {\n      preset.value = 'custom';\n      height.value = Math.round(Number(width.value || WORLD.w) * 9 / 16);\n    });\n    height.addEventListener('input'\x2C () => {\n      preset.value = 'custom';\n      width.value = Math.round(Number(height.value || WORLD.h) * 16 / 9);\n    });\n    els.addDialog.showModal();\n  }\n\n  function applyWorldSizeFromForm(form) {\n    const width = clamp(Math.round(Number(form.get('width') || WORLD.w))\x2C 1000\x2C 32000);\n    WORLD.w = width;\n    WORLD.h = Math.round(width * 9 / 16);\n    recomputeGridDimensions();\n    updateWorldReadout();\n    centerCamera({ fit: true });\n    resetWorld();\n    if (LOG_EVENTS) logEvent(`Tama\xf1o del ecosistema: ${fmt.format(WORLD.w)} x ${fmt.format(WORLD.h)}`);\n  }\n\n  function addFromForm() {\n    const form = new FormData(els.addForm);\n    if (sim.selectedAddKind === 'world') {\n      applyWorldSizeFromForm(form);\n      return;\n    }\n    const amount = clamp(Number(form.get('amount') || 1)\x2C 1\x2C ADD_AMOUNT_MAX);\n    const opts = collectAddValues(form);\n    delete opts.amount;\n    sim.lastAddValues[sim.selectedAddKind] = collectAddValues(form);\n    let lastCreated = null;\n    let created = 0;\n    for (let i = 0; i < amount; i += 1) {\n      const local = {\n        ...opts\x2C\n        x: rand(0\x2C WORLD.w)\x2C\n        y: rand(0\x2C WORLD.h)\n      };\n      if (sim.selectedAddKind === 'producer') lastCreated = spawnProducer(local) || lastCreated;\n      else if (sim.selectedAddKind === 'consumer') lastCreated = spawnConsumer(local);\n      else lastCreated = spawnPredator(local);\n      if (lastCreated) created += 1;\n    }\n    if (created) {\n      sim.births += created;\n      const label = sim.selectedAddKind === 'consumer' ? 'consumidores' : 'depredadores';\n      const producerLabel = sim.selectedAddKind === 'producer' ? 'productores' : label;\n      if (LOG_EVENTS) logEvent(`A\xf1adidos ${fmt.format(created)} ${producerLabel} desde el popup`\x2C 'birth');\n    }\n    if (amount === 1 && lastCreated) selectCreature(lastCreated);\n    updateStats(true);\n  }\n\n  function togglePanel(button\x2C panel) {\n    panel.classList.toggle('hidden');\n    button.classList.toggle('active'\x2C !panel.classList.contains('hidden'));\n    requestAnimationFrame(() => {\n      drawGraph();\n      drawGeneHistory();\n    });\n  }\n\n  function makePanelDraggable(panel) {\n    const handle = panel.querySelector('.drag-handle') || panel;\n    handle.addEventListener('pointerdown'\x2C (ev) => {\n      if (ev.target.closest('button\x2C input\x2C select')) return;\n      const rect = panel.getBoundingClientRect();\n      const startX = ev.clientX;\n      const startY = ev.clientY;\n      const offsetX = startX - rect.left;\n      const offsetY = startY - rect.top;\n      panel.style.left = `${rect.left}px`;\n      panel.style.top = `${rect.top}px`;\n      panel.style.right = 'auto';\n      panel.style.bottom = 'auto';\n      panel.style.zIndex = '32';\n      panel.setPointerCapture(ev.pointerId);\n      const move = (moveEv) => {\n        const x = clamp(moveEv.clientX - offsetX\x2C 0\x2C window.innerWidth - Math.min(96\x2C rect.width));\n        const y = clamp(moveEv.clientY - offsetY\x2C 0\x2C window.innerHeight - 38);\n        panel.style.left = `${x}px`;\n        panel.style.top = `${y}px`;\n      };\n      const up = () => {\n        panel.releasePointerCapture(ev.pointerId);\n        panel.removeEventListener('pointermove'\x2C move);\n        panel.removeEventListener('pointerup'\x2C up);\n        panel.removeEventListener('pointercancel'\x2C up);\n      };\n      panel.addEventListener('pointermove'\x2C move);\n      panel.addEventListener('pointerup'\x2C up);\n      panel.addEventListener('pointercancel'\x2C up);\n    });\n  }\n\n  function stretchTimeAxis(ev) {\n    ev.preventDefault();\n    const isGeneGraph = ev.currentTarget === geneCanvas;\n    const current = isGeneGraph ? sim.genePxPerSecond : sim.populationPxPerSecond;\n    const next = ev.deltaY > 0 ? current / 1.22 : current * 1.22;\n    if (isGeneGraph) sim.genePxPerSecond = clamp(next\x2C 0.09\x2C 24);\n    else sim.populationPxPerSecond = clamp(next\x2C 0.09\x2C 24);\n    drawGraph();\n    drawGeneHistory();\n  }\n\n  function togglePopulationSeries(key) {\n    if (!(key in sim.populationSeriesVisible)) return;\n    sim.populationSeriesVisible[key] = !sim.populationSeriesVisible[key];\n    document.querySelectorAll(`[data-pop-series="${key}"]`).forEach((el) => el.classList.toggle('disabled'\x2C !sim.populationSeriesVisible[key]));\n    drawGraph();\n  }\n\n  function toggleGeneSeries(key) {\n    if (!key) return;\n    const hidden = geneHiddenSet(sim.geneHistoryGroup);\n    if (hidden.has(key)) hidden.delete(key);\n    else hidden.add(key);\n    els._geneLastStruct = null; // forzar reconstruccion estructural\n    drawGeneHistory();\n  }\n\n  function handleToggleKey(ev\x2C callback) {\n    if (ev.key !== 'Enter' && ev.key !== ' ') return;\n    ev.preventDefault();\n    callback();\n  }\n\n  function bindEvents() {\n    document.addEventListener('visibilitychange'\x2C () => {\n      if (document.hidden) {\n        sim._wasPausedByUser = sim.paused;\n        if (!sim.paused) setPaused(true);\n      } else if (sim._wasPausedByUser === false) {\n        sim._wasPausedByUser = undefined;\n        setPaused(false);\n        sim.lastFrame = 0;\n      } else {\n        sim._wasPausedByUser = undefined;\n        sim.lastFrame = 0;\n      }\n    });\n    // Debounced resize: un solo listener con rAF evita 60-120 layouts durante drag-resize\n    let _resizeRaf = 0;\n    window.addEventListener('resize'\x2C () => {\n      if (_resizeRaf) return;\n      _resizeRaf = requestAnimationFrame(() => {\n        _resizeRaf = 0;\n        resize();\n        drawGraph();\n        drawGeneHistory();\n      });\n    });\n    els.speed.addEventListener('input'\x2C setSpeed);\n    els.systemEnergy.addEventListener('input'\x2C setSystemEnergy);\n    els.dayNightToggle.addEventListener('click'\x2C toggleDayNight);\n    els.playPause.addEventListener('click'\x2C () => setPaused(!sim.paused));\n    document.getElementById('toggleStats').addEventListener('click'\x2C (ev) => {\n      els.statsPanel.classList.toggle('hidden');\n      ev.currentTarget.classList.toggle('active'\x2C !els.statsPanel.classList.contains('hidden'));\n    });\n    document.getElementById('toggleGraphs').addEventListener('click'\x2C (ev) => togglePanel(ev.currentTarget\x2C els.graphPanel));\n    document.getElementById('toggleGenes').addEventListener('click'\x2C (ev) => {\n      recordGeneHistory();\n      togglePanel(ev.currentTarget\x2C els.genePanel);\n    });\n    document.querySelectorAll('[data-gene-tab]').forEach((btn) => {\n      btn.addEventListener('click'\x2C () => {\n        sim.geneHistoryGroup = btn.dataset.geneTab;\n        els._geneLastStruct = null; // forzar reconstruccion al cambiar grupo\n        document.querySelectorAll('[data-gene-tab]').forEach((tab) => tab.classList.toggle('active'\x2C tab === btn));\n        drawGeneHistory();\n      });\n    });\n    document.querySelectorAll('[data-pop-series]').forEach((el) => {\n      const toggle = () => togglePopulationSeries(el.dataset.popSeries);\n      el.addEventListener('click'\x2C toggle);\n      el.addEventListener('keydown'\x2C (ev) => handleToggleKey(ev\x2C toggle));\n    });\n    els.geneSummary.addEventListener('pointerdown'\x2C (ev) => {\n      const item = ev.target.closest('[data-gene-key]');\n      if (!item) return;\n      ev.preventDefault();\n      ev.stopPropagation();\n      toggleGeneSeries(item.dataset.geneKey);\n    });\n    els.geneSummary.addEventListener('keydown'\x2C (ev) => {\n      const item = ev.target.closest('[data-gene-key]');\n      if (!item) return;\n      handleToggleKey(ev\x2C () => toggleGeneSeries(item.dataset.geneKey));\n    });\n    document.getElementById('toggleDebug').addEventListener('click'\x2C (ev) => {\n      sim.debug = !sim.debug;\n      ev.currentTarget.classList.toggle('active'\x2C sim.debug);\n      ev.currentTarget.title = sim.debug ? `Rangos activos (m\xe1x. ${MAX_DEBUG_RANGES})` : 'Visualizar rangos';\n    });\n    document.getElementById('resetWorld').addEventListener('click'\x2C () => {\n      if (!window.confirm('\xbfReiniciar el ecosistema y perder la simulaci\xf3n actual?')) return;\n      resetWorld();\n    });\n    els.worldReadout.addEventListener('click'\x2C openWorldDialog);\n    window.addEventListener('keydown'\x2C (ev) => {\n      const editable = ev.target?.closest?.('input\x2C textarea\x2C select\x2C dialog');\n      if (ev.key === 'Escape' && sim.selectedCreatureIds.length && !els.addDialog.open) closeInspector();\n      if (editable || ev.altKey || ev.ctrlKey || ev.metaKey) return;\n      if (ev.code === 'Space') {\n        ev.preventDefault();\n        setPaused(!sim.paused);\n      } else if (ev.key === '1') {\n        ev.preventDefault();\n        openAddDialog('producer');\n      } else if (ev.key === '2') {\n        ev.preventDefault();\n        openAddDialog('consumer');\n      } else if (ev.key === '3') {\n        ev.preventDefault();\n        openAddDialog('predator');\n      } else if (ev.key === '+' || ev.key === '=') {\n        ev.preventDefault();\n        stepSlider(els.speed\x2C 4\x2C setSpeed);\n      } else if (ev.key === '-') {\n        ev.preventDefault();\n        stepSlider(els.speed\x2C -4\x2C setSpeed);\n      } else if (ev.key === '*') {\n        ev.preventDefault();\n        stepSlider(els.systemEnergy\x2C 4\x2C setSystemEnergy);\n      } else if (ev.key === '/') {\n        ev.preventDefault();\n        stepSlider(els.systemEnergy\x2C -4\x2C setSystemEnergy);\n      }\n    });\n    makePanelDraggable(els.graphPanel);\n    makePanelDraggable(els.genePanel);\n    makePanelDraggable(els.inspectPanel);\n    makePanelDraggable(els.statsPanel);\n    graphCanvas.addEventListener('wheel'\x2C stretchTimeAxis\x2C { passive: false });\n    geneCanvas.addEventListener('wheel'\x2C stretchTimeAxis\x2C { passive: false });\n    if (!els._graphRO) {\n      els._graphRO = new ResizeObserver(() => {\n        if (!els.graphPanel.classList.contains('hidden')) drawGraph();\n        if (!els.genePanel.classList.contains('hidden')) drawGeneHistory();\n      });\n      els._graphRO.observe(els.graphPanel);\n    }\n    if (!els._geneRO) {\n      els._geneRO = new ResizeObserver(() => {\n        if (!els.genePanel.classList.contains('hidden')) drawGeneHistory();\n      });\n      els._geneRO.observe(els.genePanel);\n    }\n\n    document.querySelectorAll('[data-add]').forEach((btn) => {\n      btn.addEventListener('click'\x2C () => openAddDialog(btn.dataset.add));\n    });\n    document.querySelectorAll('[data-quick-add]').forEach((btn) => {\n      btn.addEventListener('click'\x2C () => {\n        const kind = btn.dataset.quickAdd;\n        if (kind === 'producer-b') spawnLightningBatch('producer'\x2C PRODUCER.B);\n        else if (kind === 'producer-c') spawnLightningBatch('producer'\x2C PRODUCER.C);\n        else spawnLightningBatch(kind);\n      });\n    });\n\n    document.getElementById('quickMix').addEventListener('click'\x2C () => {\n      addLightningMix();\n      els.addDialog.close();\n    });\n    els.defaultsAdd.addEventListener('click'\x2C () => {\n      if (sim.selectedAddKind !== 'world') renderAddDialog(sim.selectedAddKind\x2C true);\n    });\n\n    els.addForm.addEventListener('submit'\x2C (ev) => {\n      if (ev.submitter?.value === 'cancel') return;\n      ev.preventDefault();\n      addFromForm();\n      els.addDialog.close();\n    });\n\n    // === Help dialog ===\n    const helpDialog = document.getElementById('helpDialog');\n    document.getElementById('helpButton').addEventListener('click'\x2C () => {\n      helpDialog.showModal();\n    });\n    helpDialog.addEventListener('click'\x2C (ev) => {\n      if (ev.target.matches('[data-help-close]')) helpDialog.close();\n    });\n    document.querySelectorAll('.help-tab').forEach((tab) => {\n      tab.addEventListener('click'\x2C () => {\n        const target = tab.dataset.helpTab;\n        document.querySelectorAll('.help-tab').forEach((t) => t.classList.toggle('active'\x2C t === tab));\n        document.querySelectorAll('.help-section').forEach((s) => s.classList.toggle('active'\x2C s.dataset.helpSection === target));\n      });\n    });\n\n    canvas.addEventListener('pointerdown'\x2C (ev) => {\n      if (sim.followCreatureId != null) setFollowCreature(sim.followCreatureId\x2C false);\n      camera.dragging = true;\n      camera.moved = false;\n      camera.lastX = ev.clientX;\n      camera.lastY = ev.clientY;\n      canvas.classList.add('dragging');\n      canvas.setPointerCapture(ev.pointerId);\n    });\n    canvas.addEventListener('pointermove'\x2C (ev) => {\n      if (!camera.dragging) return;\n      const dx = ev.clientX - camera.lastX;\n      const dy = ev.clientY - camera.lastY;\n      if (Math.abs(dx) + Math.abs(dy) > 3) camera.moved = true;\n      camera.x -= dx / camera.zoom;\n      camera.y -= dy / camera.zoom;\n      camera.lastX = ev.clientX;\n      camera.lastY = ev.clientY;\n      clampCamera();\n    });\n    canvas.addEventListener('pointerup'\x2C () => {\n      camera.dragging = false;\n      canvas.classList.remove('dragging');\n    });\n    canvas.addEventListener('pointercancel'\x2C () => {\n      camera.dragging = false;\n      canvas.classList.remove('dragging');\n    });\n    canvas.addEventListener('dblclick'\x2C () => {\n      if (sim.followCreatureId != null) setFollowCreature(sim.followCreatureId\x2C false);\n      centerCamera({ fit: true });\n    });\n    canvas.addEventListener('click'\x2C (ev) => {\n      if (camera.moved || ev.detail > 1) return;\n      const selected = findCreatureAt(ev.clientX\x2C ev.clientY);\n      if (!selected) return;\n      selectCreature(selected\x2C ev.clientX\x2C ev.clientY);\n    });\n    canvas.addEventListener('wheel'\x2C (ev) => {\n      ev.preventDefault();\n      const following = sim.followCreatureId != null;\n      const before = following ? null : screenToWorld(ev.clientX\x2C ev.clientY);\n      const bX = before ? before.x : 0\x2C bY = before ? before.y : 0;\n      const factor = Math.exp(-ev.deltaY * 0.0012);\n      camera.zoom = clamp(camera.zoom * factor\x2C minCameraZoom()\x2C 2.2);\n      if (following) {\n        updateCameraFollow();\n      } else {\n        const after = screenToWorld(ev.clientX\x2C ev.clientY);\n        camera.x += bX - after.x;\n        camera.y += bY - after.y;\n      }\n      clampCamera();\n    }\x2C { passive: false });\n  }\n\n  // \u2500\u2500\u2500 Save/Load snapshot (task_060) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n  const SNAPSHOT_VERSION = 1;\n  const CREATURE_KEYS = [\n    'id'\x2C 'uid'\x2C 'alive'\x2C 'type'\x2C 'sub'\x2C 'x'\x2C 'y'\x2C 'angle'\x2C 'radius'\x2C 'speed'\x2C\n    'energy'\x2C 'age'\x2C 'cooldown'\x2C 'color'\x2C 'size'\x2C 'reserves'\x2C 'flagella'\x2C 'cilia'\x2C\n    'chemosense'\x2C 'pseudopodia'\x2C 'armor'\x2C 'vacuole'\x2C 'feeding'\x2C 'movement'\x2C\n    'movementMask'\x2C 'perception'\x2C 'fertility'\x2C 'maxEnergy'\x2C 'metabolism'\x2C\n    'restUntil'\x2C 'restCooldown'\x2C 'burstCooldown'\x2C 'leafEnergy'\x2C 'leafCount'\x2C\n    'maxRadius'\x2C 'maxAge'\x2C 'competitionAt'\x2C 'starved'\x2C 'grazeCooldown'\x2C\n    'huntCooldown'\x2C 'oxidativeDamage'\x2C 'feedHotspotX'\x2C 'feedHotspotY'\x2C\n    'feedHotspotTTL'\x2C '_birthStep'\x2C 'vx'\x2C 'vy'\x2C 'fearFactor'\x2C 'digestTimer'\n  ];\n\n  function saveSnapshot() {\n    const field = sim.producerField;\n    const aliveCreatures = sim.creatures.filter(e => e && e.alive);\n    const snapshot = {\n      version: SNAPSHOT_VERSION\x2C\n      timestamp: Date.now()\x2C\n      sim: {\n        time: sim.time\x2C\n        births: sim.births\x2C\n        deaths: sim.deaths\x2C\n        seed: sim.seed || 0\x2C\n        solarEnergy: sim.solarEnergy\x2C\n        solarEnergyBase: sim.solarEnergyBase\x2C\n        dayNightEnabled: sim.dayNightEnabled\x2C\n        dayNightPeriod: sim.dayNightPeriod\x2C\n        dayNightPhase: sim.dayNightPhase\x2C\n        predatorCount: sim.predatorCount\x2C\n        liveConsumerCount: sim.liveConsumerCount\x2C\n        liveProducerBCount: sim.liveProducerBCount\x2C\n        liveProducerCCount: sim.liveProducerCCount\x2C\n        mobileEnergySum: sim.mobileEnergySum\x2C\n        nextCreatureUid: sim.nextCreatureUid\x2C\n        migrationTimer: sim.migrationTimer\n      }\x2C\n      world: { w: WORLD.w\x2C h: WORLD.h }\x2C\n      field: {\n        cols: field.cols\x2C\n        rows: field.rows\x2C\n        cellW: field.cellW\x2C\n        cellH: field.cellH\x2C\n        total: field.total\x2C\n        mass: Array.from(field.mass)\n      }\x2C\n      creatures: aliveCreatures.map(e => {\n        const o = {};\n        for (const k of CREATURE_KEYS) if (k in e) o[k] = e[k];\n        return o;\n      })\x2C\n      carcasses: sim.carcasses.map(c => ({ x: c.x\x2C y: c.y\x2C energy: c.energy\x2C age: c.age\x2C radius: c.radius }))\n    };\n    return snapshot;\n  }\n\n  function saveSnapshotJSON() {\n    return JSON.stringify(saveSnapshot());\n  }\n\n  function loadSnapshot(snap) {\n    if (!snap || snap.version !== SNAPSHOT_VERSION) return false;\n    // Restaurar mundo si cambia de tamano\n    if (snap.world && (snap.world.w !== WORLD.w || snap.world.h !== WORLD.h)) {\n      applyWorldSizeFromForm(snap.world.w\x2C snap.world.h);\n    }\n    // Limpiar estado\n    sim.creatures = [];\n    sim.creatureIndex.clear();\n    sim.freeIds = [];\n    sim.carcasses.length = 0;\n    initGrid();\n    initProducerField();\n    // Restaurar PRNG seed\n    sim.seed = snap.sim.seed >>> 0;\n    setSeed(sim.seed);\n    // Restaurar producerField\n    if (snap.field) {\n      const f = snap.field;\n      sim.producerField.total = f.total;\n      if (f.mass && f.mass.length === sim.producerField.mass.length) {\n        sim.producerField.mass.set(f.mass);\n      }\n      sim.producerField.dirty = true;\n    }\n    // Restaurar sim state\n    sim.time = snap.sim.time || 0;\n    sim.births = snap.sim.births || 0;\n    sim.deaths = snap.sim.deaths || 0;\n    sim.solarEnergy = snap.sim.solarEnergy ?? 1;\n    sim.solarEnergyBase = snap.sim.solarEnergyBase ?? 1;\n    sim.dayNightEnabled = snap.sim.dayNightEnabled ?? false;\n    sim.dayNightPeriod = snap.sim.dayNightPeriod ?? 600;\n    sim.dayNightPhase = snap.sim.dayNightPhase ?? 0;\n    sim.predatorCount = snap.sim.predatorCount || 0;\n    sim.liveConsumerCount = snap.sim.liveConsumerCount || 0;\n    sim.liveProducerBCount = snap.sim.liveProducerBCount || 0;\n    sim.liveProducerCCount = snap.sim.liveProducerCCount || 0;\n    sim.mobileEnergySum = snap.sim.mobileEnergySum || 0;\n    sim.nextCreatureUid = snap.sim.nextCreatureUid || 1;\n    sim.migrationTimer = snap.sim.migrationTimer || 0;\n    // Restaurar criaturas\n    for (const c of snap.creatures) {\n      const e = Object.assign({}\x2C c);\n      sim.creatures[e.id] = e;\n      sim.creatureIndex.set(e.uid\x2C e);\n    }\n    // Restaurar carcasses\n    if (snap.carcasses) {\n      for (const c of snap.carcasses) sim.carcasses.push(Object.assign({}\x2C c));\n    }\n    // Refrescar grid\x2C graficas y UI\n    rebuildGrid();\n    sim.graph.clear();\n    sim.geneHistory.clear();\n    sim.lastGraphAt = -Infinity;\n    sim.lastStatsAt = -Infinity;\n    recordGeneHistory();\n    updateStats(true);\n    if (LOG_EVENTS) logEvent('Snapshot cargado: ' + snap.creatures.length + ' criaturas');\n    return true;\n  }\n\n  function loadSnapshotJSON(jsonStr) {\n    try {\n      const snap = JSON.parse(jsonStr);\n      return loadSnapshot(snap);\n    } catch (e) {\n      console.error('loadSnapshotJSON:'\x2C e);\n      return false;\n    }\n  }\n\n  function init() {\n    setSpeed();\n    setSystemEnergy();\n    bindEvents();\n    resize();\n    updateWorldReadout();\n    centerCamera({ fit: true });\n    initGrid();\n    initProducerField();\n    seedWorld();\n    recordGeneHistory();\n    updateStats(true);\n    requestAnimationFrame(animationLoop);\n  }\n\n\n    globalThis.__sim = {\n      simulate\x2C counts\x2C sim\x2C stepProducer\x2C stepMobile\x2C stepProducerField\x2C\n      seedWorld\x2C resetWorld\x2C initProducerField\x2C initGrid\x2C\n      recordGeneHistory\x2C spawnProducer\x2C spawnConsumer\x2C spawnPredator\x2C\n      kill\x2C GROUPS\x2C GROUP_KEYS\x2C GROUP_LABELS\x2C TYPE\x2C PRODUCER\x2C WORLD\x2C\n      setSeed\x2C applyThermalDecay\x2C\n      rebuildGrid\x2C compactIfNeeded\x2C\n      MAX_DT\x2C BASE_DT\x2C GRID_REFRESH_INTERVAL\x2C\n    };\n  \n})();\n
