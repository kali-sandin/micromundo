script-source,109,app.js,(() => {\n  'use strict';\n\n  const WORLD = { w: 16000\x2C h: 9000 };\n  const CELL = 190;\n  const FIELD_CELL = 90;\n  let GRID_COLS = Math.max(1\x2C Math.ceil(WORLD.w / CELL));\n  let GRID_ROWS = Math.max(1\x2C Math.ceil(WORLD.h / CELL));\n\n  function recomputeGridDimensions() {\n    GRID_COLS = Math.max(1\x2C Math.ceil(WORLD.w / CELL));\n    GRID_ROWS = Math.max(1\x2C Math.ceil(WORLD.h / CELL));\n    initGrid();\n  }\n\n  function initGrid() {\n    const n = GRID_COLS * GRID_ROWS;\n    const pool = sim.gridBucketPool;\n    // Vaciar pool existente al grid\n    const oldGrid = sim.grid;\n    // Reciclar buckets existentes al pool\n    for (let i = 0; i < oldGrid.length; i += 1) {\n      const b = oldGrid[i];\n      if (b) {\n        // Trim arrays que crecieron demasiado durante boom: liberar backing array\n        for (let t = 0; t < GB_COUNT; t += 1) {\n          if (b[t] && b[t].length > 64) b[t] = [];\n          else if (b[t]) b[t].length = 0;\n        }\n        pool.push(b);\n      }\n    }\n    sim.grid = new Array(n);\n    for (let i = 0; i < n; i += 1) {\n      const b = pool.pop() || [[]\x2C []\x2C []\x2C []\x2C []];\n      for (let t = 0; t < GB_COUNT; t += 1) { if (!b[t]) b[t] = []; else b[t].length = 0; }\n      sim.grid[i] = b;\n    }\n    sim.gridDirtyCells = [];\n    sim.gridDirtySeen = new Uint8Array(n);\n  }\n  const MAX_DEBUG_RANGES = 700;\n  const BASE_DT = 1 / 30;\n  const MAX_SIM_CHUNKS = 60;\n  const MAX_DT = BASE_DT * 3; // 0.1s - clamp anti-inestabilidad a alta velocidad\n  const GRID_REFRESH_INTERVAL = 5; // rebuild grid cada N chunks para reducir stale queries\n  // Cap efectivo: MAX_SIM_CHUNKS * MAX_DT = 6.0s simulados por frame maximo.\n  // A speed=100 y 60fps reales (elapsed=0.016): scaled=1.6\x2C sin perdida.\n  // Solo hay perdida en lag spikes (elapsed alto + speed alto)\x2C donde es\n  // preferible mantener dt estable que simular tiempo extra con dt inestable.\n\n  const TYPE = { PRODUCER: 0\x2C CONSUMER: 1\x2C PREDATOR: 2\x2C CARCASS: 3 };\n  // Grid bucket indices: split ProducerB (colony) and ProducerC (mobile) for perf.\n  const GB_COLONY = 0;   // ProducerA (virtual field) + ProducerB (colony) \u2014 entities with e.type===TYPE.PRODUCER && !mobile\n  const GB_CONSUMER = 1; // same as TYPE.CONSUMER\n  const GB_PREDATOR = 2; // same as TYPE.PREDATOR\n  const GB_CARCASS = 3;  // same as TYPE.CARCASS\n  const GB_MOBILE  = 4;  // ProducerC (mobile) \u2014 separated from colony bucket\n  const GB_COUNT = 5;\n  const PRODUCER = { A: 0\x2C B: 1\x2C C: 2 };\n  const FEEDING = ['grazer'\x2C 'filter'\x2C 'phagocyte'\x2C 'cytostome'];\n  const MOVE = ['run-tumble'\x2C 'chemotaxis'\x2C 'drift'\x2C 'spiral'\x2C 'pause'\x2C 'burst'];\n  const MOVE_INFO = [\n    ['run-tumble'\x2C 'Tramos rectos con giros bruscos. Huye bien y explora r\xe1pido\x2C pero es menos fino siguiendo alimento.']\x2C\n    ['chemotaxis'\x2C 'Gira hacia alimento o lejos de amenazas usando percepci\xf3n qu\xedmica. Favorece persecuci\xf3n y huida dirigida.']\x2C\n    ['drift'\x2C 'Movimiento suave y barato. Consume menos al girar\x2C pero reacciona peor a depredadores o presas.']\x2C\n    ['spiral'\x2C 'B\xfasqueda orbital/ondulante. Cubre \xe1rea local y combina bien con cilios o alta percepci\xf3n.']\x2C\n    ['pause'\x2C 'Permanece quieto intervalos breves para ahorrar energ\xeda cuando no necesita desplazarse.']\x2C\n    ['burst'\x2C 'Muy de vez en cuando hace un impulso largo: gana distancia r\xe1pido\x2C pero gasta mucha energ\xeda.']\n  ];\n  const FEEDING_INFO = [\n    ['grazer'\x2C 'Pastoreo simple sobre biomasa y contacto directo. Barato y estable.']\x2C\n    ['filter'\x2C 'Filtrado cercano: cilios aumentan alcance de comida y coste moderado.']\x2C\n    ['phagocyte'\x2C 'Engullido: pseud\xf3podos mejoran mordida sobre presas/hojas\x2C con m\xe1s coste de movimiento.']\x2C\n    ['cytostome'\x2C 'Boca dirigida: eficiente al contactar\x2C m\xe1s dependiente de persecuci\xf3n y percepci\xf3n.']\n  ];\n  const GROUPS = ['producer-a'\x2C 'producer-b'\x2C 'producer-c'\x2C 'consumer'\x2C 'predator'];\n  const GROUP_LABELS = { 'producer-a': 'Productor Tipo A'\x2C 'producer-b': 'Productor Tipo B'\x2C 'producer-c': 'Productor Tipo C'\x2C consumer: 'Consumidores'\x2C predator: 'Depredadores' };\n  const GROUP_COLORS = { 'producer-a': '#76d25d'\x2C 'producer-b': '#9fda69'\x2C 'producer-c': '#48d28d'\x2C consumer: '#54b7f1'\x2C predator: '#f05b50' };\n  const GROUP_KEYS = {\n    'producer-a': ['densityTotal']\x2C\n    'producer-b': ['radius'\x2C 'armor'\x2C 'fertility'\x2C 'energy'\x2C 'leafEnergy'\x2C 'leafCount'\x2C 'maxAge']\x2C\n    'producer-c': ['radius'\x2C 'armor'\x2C 'fertility'\x2C 'perception'\x2C 'energy'\x2C 'maxAge']\x2C\n    consumer: ['size'\x2C 'reserves'\x2C 'flagella'\x2C 'cilia'\x2C 'chemosense'\x2C 'pseudopodia'\x2C 'armor'\x2C 'vacuole'\x2C 'fertility'\x2C 'perception'\x2C 'metabolism'\x2C 'maxEnergy']\x2C\n    predator: ['size'\x2C 'reserves'\x2C 'flagella'\x2C 'cilia'\x2C 'chemosense'\x2C 'pseudopodia'\x2C 'armor'\x2C 'vacuole'\x2C 'fertility'\x2C 'perception'\x2C 'metabolism'\x2C 'maxEnergy']\n  };\n  const GENE_COLORS = ['#60d7c2'\x2C '#e5bd55'\x2C '#54b7f1'\x2C '#f05b50'\x2C '#a6dd78'\x2C '#c38cff'\x2C '#f08fb0'\x2C '#cfd8dc'];\n  const ENERGY_COLOR = '#e5bd55';\n  const GENE_COLOR_BY_KEY = {\n    densityTotal: '#76d25d'\x2C\n    radius: '#a6dd78'\x2C\n    maxRadius: '#9fda69'\x2C\n    size: '#60d7c2'\x2C\n    reserves: '#e5bd55'\x2C\n    flagella: '#54b7f1'\x2C\n    cilia: '#86d7ff'\x2C\n    chemosense: '#c38cff'\x2C\n    pseudopodia: '#f08fb0'\x2C\n    armor: '#d9e4df'\x2C\n    vacuole: '#7fd8a6'\x2C\n    feeding: '#f6cf6b'\x2C\n    movementBits: '#b2c6ff'\x2C\n    movement: '#b2c6ff'\x2C\n    fertility: '#ffb36b'\x2C\n    perception: '#9bd1ff'\x2C\n    metabolism: '#ff8d8d'\x2C\n    maxEnergy: '#ffd071'\x2C\n    energy: '#ffd071'\x2C\n    leafEnergy: '#a6dd78'\x2C\n    leafCount: '#8bcf62'\x2C\n    maxAge: '#c6d2dd'\n  };\n  class RingBuffer {\n    constructor(cap) {\n      this.cap = cap;\n      this.buf = new Array(cap);\n      this.head = 0;\n      this.count = 0;\n    }\n    push(item) {\n      const idx = (this.head + this.count) % this.cap;\n      this.buf[idx] = item;\n      if (this.count < this.cap) { this.count++; }\n      else { this.head = (this.head + 1) % this.cap; }\n    }\n    get length() { return this.count; }\n    at(i) {\n      if (i < 0 || i >= this.count) return undefined;\n      return this.buf[(this.head + i) % this.cap];\n    }\n    filter(fn) {\n      const result = [];\n      for (let i = 0; i < this.count; i++) {\n        const item = this.buf[(this.head + i) % this.cap];\n        if (fn(item)) result.push(item);\n      }\n      return result;\n    }\n    // Binary search para encontrar primer indice con t >= minT.\n    // Asume orden monotono creciente de 't' en los items.\n    rangeFrom(minT) {\n      let lo = 0\x2C hi = this.count;\n      while (lo < hi) {\n        const mid = (lo + hi) >>> 1;\n        const item = this.buf[(this.head + mid) % this.cap];\n        if (item.t < minT) lo = mid + 1;\n        else hi = mid;\n      }\n      return { head: lo\x2C count: this.count - lo };\n    }\n    atRaw(i) {\n      return this.buf[(this.head + i) % this.cap];\n    }\n    clear() {\n      this.head = 0;\n      this.count = 0;\n      this.buf.fill(null);\n    }\n  }\n\n  const COLONY_MIN_LEAVES_TO_REPRODUCE = 2;\n  const ADD_AMOUNT_DEFAULT = 50;\n  const ADD_AMOUNT_MAX = 1000;\n  const TRAIL_MAX_POINTS = 440;\n  const TRAIL_MIN_STEP = 10;\n  const HISTORY_MAX_POINTS = 21600;\n  const DEFAULT_HISTORY_PX_PER_SECOND = 0.45;\n  const DEFAULT_INITIAL_PERCEPTION = 150;\n  const PRODUCER_C_MAX_PERCEPTION = 180;\n  const PRODUCER_C_DEFAULT_FERTILITY = 0.026;\n  const PRODUCER_C_CROWD_RADIUS = 320;\n  const PRODUCER_C_CROWD_LIMIT = 2;\n  const COLONY_MATE_RANGE = 800;\n\n  const canvas = document.getElementById('world');\n  const ctx = canvas.getContext('2d'\x2C { alpha: false });\n  let mainCanvasDpr = 1;\n  const graphCanvas = document.getElementById('graph');\n  const graphCtx = graphCanvas.getContext('2d');\n  const geneCanvas = document.getElementById('geneGraph');\n  const geneCtx = geneCanvas.getContext('2d');\n\n  const els = {\n    playPause: document.getElementById('playPause')\x2C\n    speed: document.getElementById('speed')\x2C\n    speedLabel: document.getElementById('speedLabel')\x2C\n    systemEnergy: document.getElementById('systemEnergy')\x2C\n    systemEnergyLabel: document.getElementById('systemEnergyLabel')\x2C\n    dayNightToggle: document.getElementById('dayNightToggle')\x2C\n    addDialog: document.getElementById('addDialog')\x2C\n    addForm: document.getElementById('addForm')\x2C\n    dynamicFields: document.getElementById('dynamicFields')\x2C\n    dialogKindLabel: document.getElementById('dialogKindLabel')\x2C\n    dialogTitle: document.getElementById('dialogTitle')\x2C\n    confirmAdd: document.getElementById('confirmAdd')\x2C\n    quickMix: document.getElementById('quickMix')\x2C\n    defaultsAdd: document.getElementById('defaultsAdd')\x2C\n    statsPanel: document.getElementById('statsPanel')\x2C\n    graphPanel: document.getElementById('graphPanel')\x2C\n    genePanel: document.getElementById('genePanel')\x2C\n    geneSummary: document.getElementById('geneSummary')\x2C\n    inspectPanel: document.getElementById('inspectPanel')\x2C\n    inspectTitle: document.getElementById('inspectTitle')\x2C\n    inspectBody: document.getElementById('inspectBody')\x2C\n    closeInspect: document.getElementById('closeInspect')\x2C\n    statProducerA: document.getElementById('statProducerA')\x2C\n    statProducerB: document.getElementById('statProducerB')\x2C\n    statProducerC: document.getElementById('statProducerC')\x2C\n    statConsumers: document.getElementById('statConsumers')\x2C\n    statPredators: document.getElementById('statPredators')\x2C\n    statEnergy: document.getElementById('statEnergy')\x2C\n    statSun: document.getElementById('statSun')\x2C\n    statBirths: document.getElementById('statBirths')\x2C\n    statDeaths: document.getElementById('statDeaths')\x2C\n    statTime: document.getElementById('statTime')\x2C\n    statFps: document.getElementById('statFps')\x2C\n    statFlow: document.getElementById('statFlow')\x2C\n    legendProducerA: document.getElementById('legendProducerA')\x2C\n    legendProducerB: document.getElementById('legendProducerB')\x2C\n    legendProducerC: document.getElementById('legendProducerC')\x2C\n    legendConsumers: document.getElementById('legendConsumers')\x2C\n    legendPredators: document.getElementById('legendPredators')\x2C\n    worldReadout: document.getElementById('worldReadout')\n  };\n\n  const camera = {\n    x: WORLD.w * 0.5\x2C\n    y: WORLD.h * 0.5\x2C\n    zoom: 0.26\x2C\n    dragging: false\x2C\n    moved: false\x2C\n    lastX: 0\x2C\n    lastY: 0\n  };\n\n  const sim = {\n    paused: false\x2C\n    debug: false\x2C\n    time: 0\x2C\n    speed: 1\x2C\n    solarEnergy: 1\x2C\n    solarEnergyBase: 1\x2C\n    dayNightEnabled: false\x2C\n    dayNightPeriod: 600\x2C\n    dayNightPhase: 0\x2C\n    births: 0\x2C\n    deaths: 0\x2C\n    seed: 0\x2C\n    fps: 0\x2C\n    creatures: []\x2C\n    creatureIndex: new Map()\x2C\n    freeIds: []\x2C\n    grid: []\x2C\n    gridBucketPool: []\x2C\n    producerField: {\n      cols: 0\x2C\n      rows: 0\x2C\n      cellW: FIELD_CELL\x2C\n      cellH: FIELD_CELL\x2C\n      mass: new Float32Array(0)\x2C\n      scratch: new Float32Array(0)\x2C\n      total: 0\x2C\n      accumulator: 0\x2C\n      dirty: true\x2C\n      // Dirty rect tracking (cell coords). null = no partial dirty.\n      dirtyMinX: null\x2C dirtyMinY: null\x2C\n      dirtyMaxX: null\x2C dirtyMaxY: null\n    }\x2C\n    graph: new RingBuffer(HISTORY_MAX_POINTS)\x2C\n    geneHistory: new RingBuffer(HISTORY_MAX_POINTS)\x2C\n    geneHistoryGroup: 'producer-a'\x2C\n    populationPxPerSecond: DEFAULT_HISTORY_PX_PER_SECOND\x2C\n    genePxPerSecond: DEFAULT_HISTORY_PX_PER_SECOND\x2C\n    lastGraphAt: 0\x2C\n    lastStatsAt: 0\x2C\n    frameCounter: 0\x2C\n    fpsAt: performance.now()\x2C\n    selectedAddKind: 'producer'\x2C\n    selectedCreatureId: null\x2C\n    selectedCreatureIds: []\x2C\n    _selectedKeysCache: null\x2C\n    selectedTrails: new Map()\x2C\n    followCreatureId: null\x2C\n    lastCenteredCreatureId: null\x2C\n    lastAddValues: {}\x2C\n    nextCreatureUid: 1\x2C\n    populationSeriesVisible: {\n      producerDensity: true\x2C\n      producerB: true\x2C\n      producerC: true\x2C\n      consumers: true\x2C\n      predators: true\n    }\x2C\n    geneSeriesHidden: {}\x2C\n    carcasses: []\x2C\n    predatorCount: 0\x2C\n    migrationTimer: 0\x2C\n    liveConsumerCount: 0\x2C\n    liveProducerBCount: 0\x2C\n    liveProducerCCount: 0\x2C\n    // Thermal entropy: disipacion adaptativa si energia total excede promedio movil\n    thermalAccumulator: 0\x2C\n    thermalEnergyHistory: []\x2C     // ultimas N muestras de energia total\n    thermalDecayRate: 0\x2C           // rate actual de disipacion (0 = inactivo)\n    mobileEnergySum: 0\x2C             // running sum de energy de consumers+predators vivos\n    // Energy flow audit: acumuladores de transferencias energeticas\n    flowAccum: { graze: 0\x2C colonyFeed: 0\x2C prodCGraze: 0\x2C predation: 0\x2C carcassEat: 0\x2C carcassToField: 0\x2C metabolism: 0\x2C reproduction: 0\x2C excretion: 0\x2C thermal: 0\x2C carcassExpire: 0 }\x2C\n    flowAccumPrev: { graze: 0\x2C colonyFeed: 0\x2C prodCGraze: 0\x2C predation: 0\x2C carcassEat: 0\x2C carcassToField: 0\x2C metabolism: 0\x2C reproduction: 0\x2C excretion: 0\x2C thermal: 0\x2C carcassExpire: 0 }\x2C\n    flowRate: { in: 0\x2C out: 0\x2C balance: 0 }\n  };\n\n  const fmt = new Intl.NumberFormat('es-ES'\x2C { maximumFractionDigits: 0 });\n\n  function creatureKey(e) {\n    return e?.uid ?? e?.id;\n  }\n\n  function creatureByKey(key) {\n    if (key == null) return null;\n    const e = sim.creatureIndex.get(Number(key));\n    return e && e.alive ? e : null;\n  }\n\n  function geneHiddenSet(group) {\n    if (!sim.geneSeriesHidden[group]) sim.geneSeriesHidden[group] = new Set();\n    return sim.geneSeriesHidden[group];\n  }\n\n  function typeName(e) {\n    if (!e) return 'Ser';\n    if (e.type === TYPE.PREDATOR) return 'Depredador';\n    if (e.type === TYPE.CONSUMER) return 'Consumidor';\n    if (e.sub === PRODUCER.B) return 'Productor B';\n    if (e.sub === PRODUCER.C) return 'Productor C';\n    return 'Productor A';\n  }\n\n  function groupForType(type) {\n    return type === TYPE.PRODUCER ? 'producer' : type === TYPE.CONSUMER ? 'consumer' : 'predator';\n  }\n\n  function groupForCreature(e) {\n    if (e.type === TYPE.CONSUMER) return 'consumer';\n    if (e.type === TYPE.PREDATOR) return 'predator';\n    if (e.sub === PRODUCER.B) return 'producer-b';\n    if (e.sub === PRODUCER.C) return 'producer-c';\n    return 'producer-a';\n  }\n\n  function isColonyProducer(eOrSub) {\n    const sub = typeof eOrSub === 'number' ? eOrSub : eOrSub?.sub;\n    return sub === PRODUCER.B;\n  }\n\n  function isMobileProducer(eOrSub) {\n    const sub = typeof eOrSub === 'number' ? eOrSub : eOrSub?.sub;\n    return sub === PRODUCER.C;\n  }\n\n  // Maps a creature/carcass to its grid bucket index.\n  // ProducerC (mobile) gets its own bucket to avoid mixing with colonies.\n  function gridType(e) {\n    if (e.type === TYPE.PRODUCER && isMobileProducer(e)) return GB_MOBILE;\n    return e.type; // PRODUCER(0)->colony\x2C CONSUMER(1)\x2C PREDATOR(2)\x2C CARCASS(3)\n  }\n\n  function colorForGroup(group) {\n    return GROUP_COLORS[group] || '#d9e4df';\n  }\n\n  function colorForCreature(e) {\n    return colorForGroup(groupForCreature(e));\n  }\n\n  function formatValue(value) {\n    if (typeof value !== 'number' || !Number.isFinite(value)) return String(value ?? '-');\n    if (Math.abs(value) >= 100) return fmt.format(value);\n    return value.toFixed(Math.abs(value) >= 10 ? 1 : 2);\n  }\n\n  function movementMaskFromValue(value) {\n    if (Array.isArray(value)) {\n      let mask = 0;\n      for (let i = 0; i < value.length; i += 1) mask |= 1 << Number(value[i]);\n      return mask || 2;\n    }\n    const n = Number(value);\n    if (!Number.isFinite(n)) return 2;\n    return n || 2;\n  }\n\n  function movementMaskFromLegacy(e) {\n    if (e._moveMask != null) return e._moveMask;\n    const mask = e.movementMask != null\n      ? movementMaskFromValue(e.movementMask)\n      : 1 << clamp(Math.round(Number(e.movement || 0))\x2C 0\x2C MOVE.length - 1);\n    e._moveMask = mask;\n    return mask;\n  }\n\n  function hasMove(e\x2C idx) {\n    const m = e._moveMask;\n    return m != null ? (m & (1 << idx)) !== 0 : Boolean(movementMaskFromLegacy(e) & (1 << idx));\n  }\n\n  function movementNames(e) {\n    const mask = movementMaskFromLegacy(e);\n    return MOVE.filter((_\x2C idx) => mask & (1 << idx)).join(' + ');\n  }\n\n  function inheritGene(a\x2C b\x2C key\x2C min\x2C max\x2C integer = false\x2C stressFactor = 1) {\n    const av = Number(a[key] ?? 0);\n    const bv = Number(b[key] ?? av);\n    const low = Math.min(av\x2C bv);\n    const high = Math.max(av\x2C bv);\n    const mid = Math.abs((av + bv) * 0.5);\n    const span = Math.max(high - low\x2C Math.max(mid * 0.33\x2C 0.02));\n    const value = rand(low - span * 0.18 * stressFactor\x2C high + span * 0.18 * stressFactor);\n    const out = clamp(value\x2C min\x2C max);\n    return integer ? Math.round(out) : out;\n  }\n\n  function inheritMovementMask(a\x2C b) {\n    const ma = movementMaskFromLegacy(a);\n    const mb = movementMaskFromLegacy(b);\n    const union = ma | mb;\n    let child = 0;\n    for (let i = 0; i < MOVE.length; i += 1) {\n      const bit = 1 << i;\n      if (union & bit && chance((ma & bit) && (mb & bit) ? 0.68 : 0.42)) child |= bit;\n    }\n    if (chance(0.08)) child ^= 1 << Math.floor(rand(0\x2C MOVE.length));\n    return child || (chance(0.5) ? ma : mb) || 2;\n  }\n\n  function inheritAsexual(e\x2C key\x2C min\x2C max\x2C integer = false\x2C stressFactor = 1) {\n    const value = Number(e[key] ?? 0);\n    const baseMargin = Math.max(Math.abs(value) * 0.06\x2C Math.abs(min) * 0.08);\n    const margin = baseMargin * stressFactor;\n    const out = clamp(rand(value - margin\x2C value + margin)\x2C min\x2C max);\n    return integer ? Math.round(out) : out;\n  }\n\n  // \u2500\u2500\u2500 PRNG: mulberry32 para reproducibilidad \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n  // Reemplaza Math.random en toda la l\xf3gica de simulaci\xf3n.\n  // Permite reproducir simulaciones con seed conocido (task_061).\n  let _prngState = 0;\n  function mulberry32(a) {\n    return function () {\n      a |= 0; a = (a + 0x6D2B79F5) | 0;\n      let t = Math.imul(a ^ (a >>> 15)\x2C 1 | a);\n      t = (t + Math.imul(t ^ (t >>> 7)\x2C 61 | t)) ^ t;\n      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;\n    };\n  }\n  let _rng = mulberry32((Date.now() ^ 0x9E3779B9) >>> 0);\n\n  function rand(min\x2C max) {\n    return min + _rng() * (max - min);\n  }\n\n  function clamp(v\x2C min\x2C max) {\n    return Math.max(min\x2C Math.min(max\x2C v));\n  }\n\n  function mod(v\x2C max) {\n    return ((v % max) + max) % max;\n  }\n\n  function torusDelta(delta\x2C size) {\n    if (delta > size * 0.5) return delta - size;\n    if (delta < -size * 0.5) return delta + size;\n    return delta;\n  }\n\n  function torusDistance2(a\x2C b) {\n    const dx = torusDelta(b.x - a.x\x2C WORLD.w);\n    const dy = torusDelta(b.y - a.y\x2C WORLD.h);\n    return dx * dx + dy * dy;\n  }\n\n  // --- Trig LUT: 4096-entry sin/cos tables\x2C error < 0.0016 rad ---\n  const TRIG_LUT_SIZE = 4096;\n  const TRIG_LUT_MASK = TRIG_LUT_SIZE - 1;\n  const TRIG_LUT_FACTOR = TRIG_LUT_SIZE / (Math.PI * 2);\n  const _sinLUT = new Float64Array(TRIG_LUT_SIZE);\n  const _cosLUT = new Float64Array(TRIG_LUT_SIZE);\n  for (let i = 0; i < TRIG_LUT_SIZE; i++) {\n    const a = (i / TRIG_LUT_SIZE) * Math.PI * 2;\n    _sinLUT[i] = Math.sin(a);\n    _cosLUT[i] = Math.cos(a);\n  }\n  function lutSin(angle) {\n    return _sinLUT[Math.floor(angle * TRIG_LUT_FACTOR) & TRIG_LUT_MASK];\n  }\n  function lutCos(angle) {\n    return _cosLUT[Math.floor(angle * TRIG_LUT_FACTOR) & TRIG_LUT_MASK];\n  }\n\n  const _scrTV = { dx: 0\x2C dy: 0 };\n  const _scratchFieldFood = { virtualA: true\x2C alive: true\x2C sub: 0\x2C radius: 0\x2C x: 0\x2C y: 0\x2C density: 0 };\n  function torusVector(from\x2C to) {\n    _scrTV.dx = torusDelta(to.x - from.x\x2C WORLD.w);\n    _scrTV.dy = torusDelta(to.y - from.y\x2C WORLD.h);\n    return _scrTV;\n  }\n\n  function chance(p) {\n    return _rng() < p;\n  }\n\n  function nowText() {\n    const mins = Math.floor(sim.time / 60);\n    const secs = Math.floor(sim.time % 60);\n    return `${String(mins).padStart(2\x2C '0')}:${String(secs).padStart(2\x2C '0')}`;\n  }\n\n  const LOG_EVENTS = false;\n  function logEvent() {\n    // El log visual se retir\xf3: mantener esta funci\xf3n como no-op evita ramas calientes extra.\n  }\n\n  const _ESC_MAP = { '&': '&amp;'\x2C '<': '&lt;'\x2C '>': '&gt;'\x2C '"': '&quot;'\x2C "'": '&#39;' };\n  function escapeHtml(value) {\n    return String(value).replace(/[&<>"']/g\x2C (c) => _ESC_MAP[c]);\n  }\n\n  function geneLabelHtml(key\x2C label) {\n    const color = GENE_COLOR_BY_KEY[key];\n    if (!color) return escapeHtml(label);\n    return `<span class="gene-label" style="--gene-color:${color}"><i></i>${escapeHtml(label)}</span>`;\n  }\n\n  function labelWithTip(key\x2C label\x2C hint = '') {\n    return `${geneLabelHtml(key\x2C label)}${hint ? `<span class="tip" tabindex="0" data-tip="${escapeHtml(hint)}">?</span>` : ''}`;\n  }\n\n  function infoRow(label\x2C value\x2C geneKey = '') {\n    return { label\x2C value\x2C geneKey };\n  }\n\n  function previewKind(data) {\n    if (data.type === TYPE.PREDATOR || data.kind === 'predator') return 'predator';\n    if (data.type === TYPE.CONSUMER || data.kind === 'consumer') return 'consumer';\n    const sub = Number(data.sub ?? PRODUCER.A);\n    if (sub === PRODUCER.B) return 'producer-b';\n    if (sub === PRODUCER.C) return 'producer-c';\n    return 'producer-a';\n  }\n\n  function smallAppendages(count\x2C className) {\n    const multiplier = className === 'preview-cilium' ? 7 : 1;\n    const maxCount = className === 'preview-cilium' ? 42 : 8;\n    const n = clamp(Math.round(Number(count || 0) * multiplier)\x2C 0\x2C maxCount);\n    let html = '';\n    for (let i = 0; i < n; i += 1) {\n      const angle = className === 'preview-flagellum'\n        ? -30 + (n === 1 ? 0 : 60 * i / (n - 1))\n        : 360 * i / Math.max(1\x2C n);\n      html += `<i class="${className}" style="--i:${i};--n:${Math.max(1\x2C n)};--a:${angle}deg"></i>`;\n    }\n    return html;\n  }\n\n  function energyRatio(e) {\n    const max = Math.max(0.001\x2C Number(e?.maxEnergy || 0));\n    return clamp(Number(e?.energy || 0) / max\x2C 0\x2C 1);\n  }\n\n  function energyBarHtml(e) {\n    if (!e || !Number.isFinite(Number(e.energy)) || !Number.isFinite(Number(e.maxEnergy)) || e.maxEnergy <= 0) return '';\n    return `<div class="energy-bar" title="Energ\xeda ${escapeHtml(formatValue(e.energy))} / ${escapeHtml(formatValue(e.maxEnergy))}"><i style="width:${(energyRatio(e) * 100).toFixed(1)}%"></i></div>`;\n  }\n\n  function lifeBarHtml(e) {\n    if (!e || !Number.isFinite(Number(e.age)) || !Number.isFinite(Number(e.maxAge)) || e.maxAge <= 0) return '';\n    const ox = Math.min(0.5\x2C Number(e.oxidativeDamage || 0));\n    const effMax = e.maxAge * (1 - ox);\n    const ratio = clamp(Number(e.age || 0) / effMax\x2C 0\x2C 1);\n    const tip = ox > 0.01\n      ? `Vida ${escapeHtml(formatValue(e.age))} / ${escapeHtml(formatValue(effMax.toFixed(0)))} (da\xf1o oxidativo ${Math.round(ox*100)}%)`\n      : `Vida ${escapeHtml(formatValue(e.age))} / ${escapeHtml(formatValue(e.maxAge))}`;\n    return `<div class="life-bar" title="${tip}"><i style="width:${(ratio * 100).toFixed(1)}%"></i></div>`;\n  }\n\n  function previewHtml(data) {\n    const kind = previewKind(data);\n    const radius = Number(data.radius ?? (data.size ? 3.5 + Number(data.size) * 1.72 + Number(data.reserves || 0) * 0.34 : 8));\n    const size = Number(data.size ?? radius);\n    const armor = Number(data.armor || 0);\n    const leafCount = Number(data.leafCount ?? (kind === 'producer-b' ? 6 : 0));\n    const body = clamp((kind === 'producer-b' ? radius * 1.45 : size * 6.2 + radius * 0.35)\x2C 18\x2C 74);\n    const isPredator = kind === 'predator';\n    const isMobile = kind === 'consumer' || kind === 'predator';\n    const leaves = smallAppendages(leafCount\x2C 'preview-leaf');\n    const flagella = smallAppendages(data.flagella\x2C 'preview-flagellum');\n    const cilia = smallAppendages(data.cilia\x2C 'preview-cilium');\n    const metrics = [];\n    if (kind === 'producer-a') metrics.push(['Densidad'\x2C data.densityTotal ?? data.fertility ?? 1]);\n    if (kind === 'producer-b' || kind === 'producer-c') {\n      metrics.push(['Radio'\x2C radius]\x2C ['Armadura'\x2C armor]);\n      if (kind === 'producer-b') metrics.push(['Hojas'\x2C leafCount]);\n    }\n    if (isMobile) {\n      metrics.push(['Tama\xf1o'\x2C data.size ?? 0]\x2C ['Flagelos'\x2C data.flagella ?? 0]\x2C ['Cilios'\x2C data.cilia ?? 0]\x2C ['Armadura'\x2C armor]);\n    }\n    const metricHtml = metrics.map(([label\x2C value]) => `<span>${escapeHtml(label)} <b>${escapeHtml(formatValue(value))}</b></span>`).join('');\n    const bodyShape = isPredator ? 'preview-body predator-shape' : 'preview-body';\n    return `\n      <div class="creature-preview ${kind}" style="--body:${body}px;--armor:${clamp(armor\x2C 0\x2C 5)}">\n        ${energyBarHtml(data)}\n        ${lifeBarHtml(data)}\n        <div class="preview-stage">\n          ${kind === 'producer-b' ? leaves : ''}\n          ${isMobile ? flagella : ''}\n          ${isMobile ? cilia : ''}\n          <i class="${bodyShape}"></i>\n        </div>\n        <div class="preview-metrics">${metricHtml}</div>\n      </div>\n    `;\n  }\n\n  function normalizeAngle(a) {\n    while (a > Math.PI) a -= Math.PI * 2;\n    while (a < -Math.PI) a += Math.PI * 2;\n    return a;\n  }\n\n  // Conditional wrap: avoids double-modulo overhead for the common case\n  // where coordinates are already within bounds (movement < world size).\n  function wrapInsideWorld(e) {\n    if (e.x < 0) e.x += WORLD.w;\n    else if (e.x >= WORLD.w) e.x -= WORLD.w;\n    if (e.y < 0) e.y += WORLD.h;\n    else if (e.y >= WORLD.h) e.y -= WORLD.h;\n  }\n\n  function updateWorldReadout() {\n    els.worldReadout.textContent = `${fmt.format(WORLD.w)} x ${fmt.format(WORLD.h)}`;\n  }\n\n  function fieldIndex(cx\x2C cy) {\n    return cy * sim.producerField.cols + cx;\n  }\n\n  function fieldCellX(x) {\n    const field = sim.producerField;\n    return Math.floor(x / field.cellW) % field.cols;\n  }\n\n  function fieldCellY(y) {\n    const field = sim.producerField;\n    return Math.floor(y / field.cellH) % field.rows;\n  }\n\n  function fieldCellRadius(radius) {\n    const field = sim.producerField;\n    return Math.max(1\x2C Math.ceil(radius / Math.max(field.cellW\x2C field.cellH)));\n  }\n\n  function smoothProducerFieldSeed(passes = 5) {\n    const field = sim.producerField;\n    const cols = field.cols;\n    const rows = field.rows;\n    let src = field.mass;\n    let dst = field.scratch;\n    for (let pass = 0; pass < passes; pass += 1) {\n      let total = 0;\n      for (let y = 0; y < rows; y += 1) {\n        const yU = y > 0 ? y - 1 : rows - 1;\n        const yD = y < rows - 1 ? y + 1 : 0;\n        for (let x = 0; x < cols; x += 1) {\n          const idx = y * cols + x;\n          const center = src[idx];\n          const xL = x > 0 ? x - 1 : cols - 1;\n          const xR = x < cols - 1 ? x + 1 : 0;\n          const left = src[y * cols + xL];\n          const right = src[y * cols + xR];\n          const up = src[yU * cols + x];\n          const down = src[yD * cols + x];\n          const next = center * 0.58 + (left + right + up + down) * 0.105;\n          dst[idx] = next;\n          total += next;\n        }\n      }\n      const swap = src;\n      src = dst;\n      dst = swap;\n      field.total = total;\n    }\n    if (src !== field.mass) field.mass.set(src);\n  }\n\n  function initProducerField(seed = 0.30) {\n    const cols = Math.max(4\x2C Math.ceil(WORLD.w / FIELD_CELL));\n    const rows = Math.max(4\x2C Math.ceil(WORLD.h / FIELD_CELL));\n    sim.producerField.cols = cols;\n    sim.producerField.rows = rows;\n    sim.producerField.cellW = WORLD.w / cols;\n    sim.producerField.cellH = WORLD.h / rows;\n    sim.producerField.mass = new Float32Array(cols * rows);\n    sim.producerField.scratch = new Float32Array(cols * rows);\n    sim.producerField.total = 0;\n    sim.producerField.accumulator = 0;\n    sim.producerField.dirtyMinX = null;\n    sim.producerField.dirtyMinY = null;\n    sim.producerField.dirtyMaxX = null;\n    sim.producerField.dirtyMaxY = null;\n\n    for (let i = 0; i < sim.producerField.mass.length; i += 1) {\n      const value = _rng() < seed ? rand(0.14\x2C 0.52) : rand(0.025\x2C 0.10);\n      sim.producerField.mass[i] = value;\n      sim.producerField.total += value;\n    }\n    smoothProducerFieldSeed(7);\n  }\n\n  function markFieldDirty(cx\x2C cy\x2C r) {\n    const f = sim.producerField;\n    const x0 = cx - r\x2C x1 = cx + r\x2C y0 = cy - r\x2C y1 = cy + r;\n    if (f.dirtyMinX === null) {\n      f.dirtyMinX = x0; f.dirtyMaxX = x1;\n      f.dirtyMinY = y0; f.dirtyMaxY = y1;\n    } else {\n      if (x0 < f.dirtyMinX) f.dirtyMinX = x0;\n      if (x1 > f.dirtyMaxX) f.dirtyMaxX = x1;\n      if (y0 < f.dirtyMinY) f.dirtyMinY = y0;\n      if (y1 > f.dirtyMaxY) f.dirtyMaxY = y1;\n    }\n    f.dirty = true;\n  }\n\n  function addProducerDensity(x\x2C y\x2C amount = 1\x2C radius = 90) {\n    const field = sim.producerField;\n    if (!field.mass.length) return;\n    const cx = fieldCellX(x);\n    const cy = fieldCellY(y);\n    const r = fieldCellRadius(radius);\n    markFieldDirty(cx\x2C cy\x2C r);\n    const gain = Math.max(0.05\x2C amount);\n    const r2 = r * r;\n    for (let yy = cy - r; yy <= cy + r; yy += 1) {\n      const wy = yy < 0 ? yy + field.rows : yy >= field.rows ? yy - field.rows : yy;\n      const dy = yy - cy;\n      const dy2 = dy * dy;\n      for (let xx = cx - r; xx <= cx + r; xx += 1) {\n        const dx = xx - cx;\n        const d2 = dx * dx + dy2;\n        if (d2 > r2) continue;\n        const wx = xx < 0 ? xx + field.cols : xx >= field.cols ? xx - field.cols : xx;\n        const idx = wy * field.cols + wx;\n        const before = field.mass[idx];\n        const falloff = 1 - d2 / (r2 + 1);\n        let add = gain * falloff * 0.08; // 0.08 per-cell density factor; ~neutral aggregate (was 0.18 = x2.25 amplification)\n        if (before > 1.2) add *= (1.5 - before) / 0.3;\n        const next = clamp(before + add\x2C 0\x2C 1.5);\n        field.mass[idx] = next;\n        field.total += next - before;\n      }\n    }\n  }\n\n  function stepProducerField(dt) {\n    const field = sim.producerField;\n    if (!field.mass.length) return;\n    field.accumulator += dt;\n    if (field.accumulator < 0.45) return;\n    const t = Math.min(field.accumulator\x2C 2.5);\n    field.accumulator = 0;\n\n    const cols = field.cols;\n    const rows = field.rows;\n    const src = field.mass;\n    const dst = field.scratch;\n    let total = 0;\n    const sunlight = clamp(sim.solarEnergy\x2C 0.1\x2C 6);\n    // Holling II: saturar growth con sunlight para evitar paradoja del enriquecimiento\n    const sunEff = sunlight / (1 + sunlight * 0.15); // sun=1->0.87\x2C sun=3->2.22\x2C sun=6->4.0\n    let growth = 0.020 * sunEff * t;\n    // Resilience boost: cuando el campo esta bajo deficit (avg<0.15)\x2C aumentar growth.\n    // Factor hasta x1.5 cuando avg->0. Previene colapso total\x2C auto-recuperacion.\n    const fieldAvg = field.total / (cols * rows);\n    if (fieldAvg < 0.15) growth *= 1 + 0.5 * (0.15 - fieldAvg) / 0.15;\n    const baselineGrowth = 0.001 * sunEff * t; // evita frontera absorbente en m~0\n    // Diffusion adaptativo: reducir cuando campo critico para proteger patches locales.\n    // Campo sano (avg>0.3): diffusion normal. Campo critico (avg<0.1): diffusion x0.3.\n    // Evita que\u5c11\u91cf biomasa se dispersa y se pierda tras crashes.\n    const diffScale = clamp(fieldAvg / 0.3\x2C 0.3\x2C 1);\n    const diffusion = 0.028 * t * diffScale;\n\n    for (let y = 0; y < rows; y += 1) {\n      const yc = y * cols;\n      const yU = y > 0 ? y - 1 : rows - 1;\n      const yD = y < rows - 1 ? y + 1 : 0;\n      const ycU = yU * cols;\n      const ycD = yD * cols;\n\n      // x == 0 (left wrap border)\n      {\n        const idx = yc;\n        const m = src[idx];\n        const left = src[yc + cols - 1];\n        const right = src[idx + 1];\n        const up = src[ycU];\n        const down = src[ycD];\n        const avg = (left + right + up + down) * 0.25;\n        const grown = m + (m * (1.0 - m) * growth + baselineGrowth);\n        const next = clamp(grown + (avg - m) * diffusion\x2C 0\x2C 1.5);\n        dst[idx] = next;\n        total += next;\n      }\n\n      // 0 < x < cols-1 (fast path\x2C no wrapping)\n      for (let x = 1; x < cols - 1; x += 1) {\n        const idx = yc + x;\n        const m = src[idx];\n        const left = src[idx - 1];\n        const right = src[idx + 1];\n        const up = src[ycU + x];\n        const down = src[ycD + x];\n        const avg = (left + right + up + down) * 0.25;\n        const grown = m + (m * (1.0 - m) * growth + baselineGrowth);\n        const next = clamp(grown + (avg - m) * diffusion\x2C 0\x2C 1.5);\n        dst[idx] = next;\n        total += next;\n      }\n\n      // x == cols-1 (right wrap border)\n      if (cols > 1) {\n        const idx = yc + cols - 1;\n        const m = src[idx];\n        const left = src[idx - 1];\n        const right = src[yc];\n        const up = src[ycU + cols - 1];\n        const down = src[ycD + cols - 1];\n        const avg = (left + right + up + down) * 0.25;\n        const grown = m + (m * (1.0 - m) * growth + baselineGrowth);\n        const next = clamp(grown + (avg - m) * diffusion\x2C 0\x2C 1.5);\n        dst[idx] = next;\n        total += next;\n      }\n    }\n\n    // Swap mass and scratch (avoids full Float32Array copy)\n    const tmp = field.mass;\n    field.mass = field.scratch;\n    field.scratch = tmp;\n    field.total = total;\n    // stepProducerField hace growth+diffusion en todas las celdas: dirty global\n    field.dirtyMinX = null; field.dirtyMinY = null;\n    field.dirtyMaxX = null; field.dirtyMaxY = null;\n    field.dirty = true;\n  }\n\n  function bestProducerDensityTarget(x\x2C y\x2C radius) {\n    const field = sim.producerField;\n    if (!field.mass.length) return null;\n    const cx = fieldCellX(x);\n    const cy = fieldCellY(y);\n    const r = clamp(fieldCellRadius(radius)\x2C 1\x2C 6);\n    let best = 0.035;\n    let bestX = -1;\n    let bestY = -1;\n    const r2 = r * r;\n    for (let yy = cy - r; yy <= cy + r; yy += 1) {\n      const wy = yy < 0 ? yy + field.rows : yy >= field.rows ? yy - field.rows : yy;\n      const dy = yy - cy;\n      const dy2 = dy * dy;\n      for (let xx = cx - r; xx <= cx + r; xx += 1) {\n        const dx = xx - cx;\n        const d2 = dx * dx + dy2;\n        if (d2 > r2) continue;\n        const wx = xx < 0 ? xx + field.cols : xx >= field.cols ? xx - field.cols : xx;\n        const mass = field.mass[wy * field.cols + wx];\n        const score = mass / (1 + d2 * 0.12);\n        if (score > best) {\n          best = score;\n          bestX = wx;\n          bestY = wy;\n        }\n      }\n    }\n    if (bestX < 0) return null;\n    _scratchFieldFood.sub = PRODUCER.A;\n    _scratchFieldFood.radius = Math.max(field.cellW\x2C field.cellH) * 0.45;\n    _scratchFieldFood.x = (bestX + 0.5) * field.cellW;\n    _scratchFieldFood.y = (bestY + 0.5) * field.cellH;\n    _scratchFieldFood.density = field.mass[fieldIndex(bestX\x2C bestY)];\n    return _scratchFieldFood;\n  }\n\n  function grazeProducerDensity(e\x2C dt) {\n    const field = sim.producerField;\n    if (!field.mass.length) return false;\n    // Holling Type II: handling time evita graze continuo. Limita a ~1.5-3 eventos/s.\n    if ((e.grazeCooldown || 0) > 0) return false;\n    const cx = fieldCellX(e.x);\n    const cy = fieldCellY(e.y);\n    const idx = fieldIndex(cx\x2C cy);\n    const mass = field.mass[idx];\n    if (mass < 0.035) return false;\n    // Type III grazing: consumers reducen bite en celdas pobres (refugio de productores).\n    // Similar a Type III de predators: la eficiencia cae cuando el recurso escasea.\n    // mass < 0.4: biteRate se reduce progresivamente hasta x0.35. Protege patches agotados.\n    const grazingEff = mass < 0.4 ? Math.max(0.35\x2C mass / 0.4) : 1;\n    // Bite constante: el cooldown regula la frecuencia en tiempo de sim.\n    // Sin dtScale: throughput independiente de framerate/speed.\n    const feedBonus = e.feeding === 1 ? 0.014 : e.feeding === 0 ? 0.010 : 0;\n    const biteRate = (0.018 + e.size * 0.006 + e.cilia * 0.003 + feedBonus) * (e.fearFactor || 1) * grazingEff;\n    const bite = Math.min(mass\x2C biteRate);\n    field.mass[idx] = mass - bite;\n    markFieldDirty(cx\x2C cy\x2C 1);\n    field.total -= bite;\n    // Density-dependent grazing efficiency: celdas pobres rinden menos energia por bite.\n    // densityFactor: 0.4 (celdas muy pobres) a 1.0 (celdas ricas). mass tipica ~0.5-1.3.\n    // Esto frena overgrazing en zonas degradadas y estabiliza boom-bust.\n    const densityFactor = Math.max(0.4\x2C Math.min(1.0\x2C mass / 0.8));\n    // Mult 18 (antes 55->22->16->18): field genera ~0.015/s por celda. Bite tipico 0.047 cada ~0.55s.\n    // gain=0.047*18*densityFactor ~= 0.85/evento en zona rica\x2C 0.34 en zona pobre.\n    // Ratio gain:metab ~5.2x. Eficiencia trofica ~24%.\n    const gain = bite * 18 * densityFactor;\n    const actualGain = Math.min(gain\x2C e.maxEnergy - e.energy);\n    const newEnergy = e.energy + actualGain;\n    sim.mobileEnergySum += actualGain;\n    e.energy = newEnergy;\n    e.grazeCooldown = rand(0.3\x2C 0.8);\n    sim.flowAccum.graze += actualGain;\n    return true;\n  }\n\n  function returnCarcassEnergyToField(car) {\n    if (!car || !sim.producerField.mass.length || car.energy <= 0) return;\n    // Scale deposit radius with energy so large carcasses spread over more cells\n    // instead of saturating the 1.5 clamp on a few central cells.\n    const energyAmount = Math.max(0.18\x2C car.energy * 0.25);\n    const depositRadius = Math.max(90\x2C Math.min(240\x2C car.radius * 12 + Math.sqrt(car.energy) * 6));\n    addProducerDensity(car.x\x2C car.y\x2C energyAmount\x2C depositRadius);\n    sim.flowAccum.carcassToField += energyAmount;\n    sim.flowAccum.carcassExpire += Math.max(0\x2C car.energy - energyAmount);\n    car.energy = 0;\n    car.alive = false;\n  }\n\n  function nearestCarcassFood(e\x2C radius) {\n    let best = null;\n    let bestD2 = Infinity;\n    const grid = sim.grid;\n    const minX = Math.floor((e.x - radius) / CELL);\n    const maxX = Math.floor((e.x + radius) / CELL);\n    const minY = Math.floor((e.y - radius) / CELL);\n    const maxY = Math.floor((e.y + radius) / CELL);\n    const r2 = radius * radius;\n    for (let cy = minY; cy <= maxY; cy += 1) {\n      let wy = cy;\n      if (wy < 0) wy += GRID_ROWS;\n      else if (wy >= GRID_ROWS) wy -= GRID_ROWS;\n      const rowBase = wy * GRID_COLS;\n      for (let cx = minX; cx <= maxX; cx += 1) {\n        let wx = cx;\n        if (wx < 0) wx += GRID_COLS;\n        else if (wx >= GRID_COLS) wx -= GRID_COLS;\n        const list = grid[rowBase + wx][TYPE.CARCASS];\n        for (let i = 0; i < list.length; i += 1) {\n          const car = list[i];\n          if (!car || !car.alive || car.energy <= 0) continue;\n          const dx = torusDelta(car.x - e.x\x2C WORLD.w);\n          const dy = torusDelta(car.y - e.y\x2C WORLD.h);\n          const d2 = dx * dx + dy * dy;\n          if (d2 <= r2 && d2 < bestD2) {\n            best = car;\n            bestD2 = d2;\n          }\n        }\n      }\n    }\n    return best;\n  }\n\n  function eatCarcass(e\x2C car\x2C dt) {\n    if (!car || !car.alive || car.energy <= 0) return false;\n    if ((e.grazeCooldown || 0) > 0) return false;\n    const dx = torusDelta(car.x - e.x\x2C WORLD.w);\n    const dy = torusDelta(car.y - e.y\x2C WORLD.h);\n    const eatRange = e.radius + car.radius + (e.feeding === 1 ? e.cilia * 2.2 : 3);\n    if (dx * dx + dy * dy > eatRange * eatRange) return false;\n    const bite = Math.min(car.energy\x2C 0.9 + e.size * 0.58 + e.pseudopodia * 0.38 + (e.feeding === 2 ? 0.8 : 0) + (e.feeding === 3 ? 0.6 : 0));\n    car.energy -= bite;\n    const actualGainCar = Math.min(bite\x2C e.maxEnergy - e.energy);\n    const newEng = e.energy + actualGainCar;\n    sim.mobileEnergySum += actualGainCar;\n    e.energy = newEng;\n    sim.flowAccum.carcassEat += actualGainCar;\n    if (car.energy <= 0.2) {\n      car.energy = 0;\n      car.alive = false;\n    }\n    e.grazeCooldown = rand(0.3\x2C 0.8);\n    return true;\n  }\n\n  function stepCarcasses(dt) {\n    for (let ci = sim.carcasses.length - 1; ci >= 0; ci -= 1) {\n      const car = sim.carcasses[ci];\n      car.life += dt;\n      // Gradual decay: en el ultimo 25% de vida\x2C soltar energia al campo poco a poco.\n      // Evita cliff dump y distribuye nutrientes mas uniformemente.\n      const lifeFrac = car.life / car.maxLife;\n      if (lifeFrac > 0.75 && car.energy > 0.5) {\n        const decayRate = car.energy * 0.02 * dt; // ~2%/s de la energia restante\n        const decayed = Math.min(car.energy\x2C decayRate);\n        car.energy -= decayed;\n        addProducerDensity(car.x\x2C car.y\x2C decayed * 0.25\x2C Math.max(90\x2C car.radius * 10));\n        sim.flowAccum.carcassToField += decayed * 0.25;\n        sim.flowAccum.carcassExpire += decayed * 0.75;\n      }\n      if (car.life >= car.maxLife) returnCarcassEnergyToField(car);\n      if (!car.alive || car.energy <= 0) {\n        sim.carcasses[ci] = sim.carcasses[sim.carcasses.length - 1];\n        sim.carcasses.pop();\n        if (ci < sim.carcasses.length) ci += 1; // re-procesa elemento intercambiado\n      }\n    }\n  }\n\n  function createCreature(partial) {\n    const id = sim.freeIds.pop() ?? sim.creatures.length;\n    const base = {\n      id\x2C\n      uid: sim.nextCreatureUid++\x2C\n      alive: true\x2C\n      type: TYPE.PRODUCER\x2C\n      sub: PRODUCER.A\x2C\n      x: rand(0\x2C WORLD.w)\x2C\n      y: rand(0\x2C WORLD.h)\x2C\n      angle: rand(-Math.PI\x2C Math.PI)\x2C\n      radius: 5\x2C\n      speed: 0\x2C\n      energy: 1\x2C\n      age: 0\x2C\n      cooldown: rand(2\x2C 20)\x2C\n      color: '#76d25d'\x2C\n      size: 1\x2C\n      reserves: 1\x2C\n      flagella: 0\x2C\n      cilia: 0\x2C\n      chemosense: 0\x2C\n      pseudopodia: 0\x2C\n      armor: 0\x2C\n      vacuole: 0\x2C\n      feeding: 0\x2C\n      movement: 0\x2C\n      movementMask: 2\x2C\n      perception: DEFAULT_INITIAL_PERCEPTION\x2C\n      fertility: 1\x2C\n      maxEnergy: 1\x2C\n      metabolism: 0\x2C\n      restUntil: 0\x2C\n      restCooldown: 0\x2C\n      burstCooldown: 0\x2C\n      leafEnergy: 0\x2C\n      leafCount: 0\x2C\n      maxRadius: 18\x2C\n      maxAge: Infinity\x2C\n      competitionAt: 0\x2C\n      starved: 0\x2C\n      grazeCooldown: 0\x2C\n      huntCooldown: 0\x2C\n      oxidativeDamage: 0\x2C\n      feedHotspotX: -1\x2C\n      feedHotspotY: -1\x2C\n      feedHotspotTTL: 0\x2C\n      _birthStep: -1\n    };\n    const e = Object.assign(base\x2C partial);\n    e._birthStep = sim.time;\n    sim.creatures[id] = e;\n    sim.creatureIndex.set(e.uid\x2C e);\n    // Insert into spatial grid immediately so other creatures can detect newborns\n    // as food/mate/threat within the same frame (before next rebuildGrid).\n    if (sim.grid) {\n      const key = cellKeyInt(e.x\x2C e.y);\n      const bucket = sim.grid[key];\n      if (bucket) {\n        bucket[gridType(e)].push(e);\n        if (!sim.gridDirtySeen[key]) { sim.gridDirtySeen[key] = 1; sim.gridDirtyCells.push(key); }\n      }\n    }\n    return e;\n  }\n\n  function kill(e\x2C reason) {\n    if (!e || !e.alive) return;\n    if (e.type === TYPE.CONSUMER || e.type === TYPE.PREDATOR) sim.mobileEnergySum -= Math.max(0\x2C e.energy);\n    e.alive = false;\n    sim.creatureIndex.delete(e.uid);\n    sim.selectedTrails.delete(creatureKey(e));\n    sim.freeIds.push(e.id);\n    sim.deaths += 1;\n\n    // Live counters\n    if (e.type === TYPE.PRODUCER) {\n      if (e.sub === PRODUCER.B) sim.liveProducerBCount--;\n      else if (e.sub === PRODUCER.C) sim.liveProducerCCount--;\n    } else if (e.type === TYPE.CONSUMER) {\n      sim.liveConsumerCount--;\n    } else if (e.type === TYPE.PREDATOR) {\n      sim.predatorCount--;\n    }\n\n    // El retorno al campo ocurre al descomponerse; mientras tanto el cadaver se puede comer.\n    // Sin floor: criatura con energy=0 no genera carcass con energia fantasma.\n    const storedEnergy = Math.max(0\x2C Number(e.energy || 0) * 0.55);\n    e.energy = 0;\n    if (storedEnergy > 0.5 && sim.carcasses.length < 400) {\n\n      sim.carcasses.push({\n        alive: true\x2C\n        virtualCarcass: true\x2C\n        x: e.x\x2C\n        y: e.y\x2C\n        radius: Math.max(2\x2C e.radius * 0.9)\x2C\n        sourceType: e.type\x2C\n        color: e.color || (e.type === TYPE.PREDATOR ? '#f05b50' : e.type === TYPE.CONSUMER ? '#54b7f1' : '#76d25d')\x2C\n        energy: storedEnergy\x2C\n        maxEnergy: storedEnergy\x2C\n        life: 0\x2C\n        maxLife: 20\n      });\n    } else if (storedEnergy > 0.5) {\n      // Cap lleno: redirigir energia al producerField directamente (no deletarla)\n      addProducerDensity(e.x\x2C e.y\x2C Math.max(0.18\x2C storedEnergy * 0.25)\x2C Math.max(90\x2C Math.min(240\x2C Math.max(2\x2C (e.radius||5) * 0.9) * 12 + Math.sqrt(storedEnergy) * 6)));\n    }\n\n    if (LOG_EVENTS && reason && sim.deaths % 20 === 0) logEvent(`${reason}. Muertes acumuladas: ${fmt.format(sim.deaths)}`\x2C 'death');\n  }\n\n  function spawnProducer(opts = {}) {\n    const sub = opts.sub ?? PRODUCER.A;\n    if (sub === PRODUCER.A) {\n      addProducerDensity(opts.x ?? rand(0\x2C WORLD.w)\x2C opts.y ?? rand(0\x2C WORLD.h)\x2C Number(opts.fertility ?? 1)\x2C Math.max(60\x2C Number(opts.radius ?? 90)));\n      return null;\n    }\n    const colony = isColonyProducer(sub);\n    const mobile = isMobileProducer(sub);\n    const radius = colony ? Number(opts.radius ?? 18) : Number(opts.radius ?? (mobile ? 5 : 5));\n    const maxRadius = colony ? Math.max(radius + 8\x2C Number(opts.maxRadius ?? radius * 1.9 + 10)) : radius;\n    const chemosense = mobile ? Number(opts.chemosense ?? rand(2.2\x2C 3.4)) : 0;\n    const movement = Number(opts.movement ?? Math.floor(rand(0\x2C MOVE.length)));\n    const e = createCreature({\n      type: TYPE.PRODUCER\x2C\n      sub\x2C\n      x: opts.x ?? rand(0\x2C WORLD.w)\x2C\n      y: opts.y ?? rand(0\x2C WORLD.h)\x2C\n      radius\x2C\n      maxRadius\x2C\n      speed: mobile ? Number(opts.speed ?? 24) : 0\x2C\n      energy: colony ? Number(opts.energy ?? 18) : Number(opts.energy ?? 8)\x2C\n      maxEnergy: colony ? 92 : 24\x2C\n      armor: Number(opts.armor ?? (colony ? rand(3.1\x2C 5.4) : mobile ? rand(2.2\x2C 4.0) : rand(1.2\x2C 2.6)))\x2C\n      chemosense\x2C\n      perception: mobile ? clamp(Number(opts.perception ?? DEFAULT_INITIAL_PERCEPTION)\x2C 40\x2C PRODUCER_C_MAX_PERCEPTION) : 40\x2C\n      movement\x2C\n      movementMask: opts.movementMask != null ? movementMaskFromValue(opts.movementMask) : (1 << movement)\x2C\n      leafEnergy: colony ? Number(opts.leafEnergy ?? rand(8\x2C 18)) : 0\x2C\n      leafCount: colony ? (opts.leafCount != null ? Math.floor(Number(opts.leafCount)) : Math.floor(rand(3\x2C 7))) : 0\x2C\n      fertility: Number(opts.fertility ?? (mobile ? PRODUCER_C_DEFAULT_FERTILITY : 0.024))\x2C\n      cooldown: rand(mobile ? 30 : 15\x2C colony ? 80 : 60)\x2C\n      maxAge: colony ? Number(opts.maxAge ?? rand(9000\x2C 16500)) : mobile ? Number(opts.maxAge ?? rand(5200\x2C 9000)) : Infinity\x2C\n      competitionAt: sim.time + rand(0.5\x2C 3.5)\x2C\n      color: sub === PRODUCER.A ? GROUP_COLORS['producer-a'] : sub === PRODUCER.B ? GROUP_COLORS['producer-b'] : GROUP_COLORS['producer-c']\n    });\n    if (sub === PRODUCER.B) sim.liveProducerBCount++;\n    else if (sub === PRODUCER.C) sim.liveProducerCCount++;\n    return e;\n  }\n\n  function derivedConsumerStats(e) {\n    const bodyMass = e.size * 1.15 + e.reserves * 0.48 + e.armor * 0.64 + e.vacuole * 0.18;\n    const flagellaLoad = Math.pow(Math.max(0\x2C e.flagella)\x2C 1.35);\n    const locomotion = 16 + e.flagella * 22 + e.cilia * 7 + e.pseudopodia * 4;\n    const massDrag = 1 + bodyMass * 0.2 + e.reserves * 0.08 + flagellaLoad * 0.055;\n    e.radius = clamp(3.5 + e.size * 1.72 + e.reserves * 0.34\x2C 3\x2C 19);\n    e.speed = locomotion / massDrag;\n    const speedCost = Math.pow(Math.max(0\x2C e.speed) / 42\x2C 1.65) * 0.022;\n    // Kleiber's law: metabolism scales as bodyMass^0.75 instead of linear sum.\n    // kJ coefficient calibrated so typical consumer (mass~5.8) gets basal ~0.05.\n    const kleiberBase = 0.013 * Math.pow(Math.max(0.5\x2C bodyMass)\x2C 0.75);\n    const appendageCost = flagellaLoad * 0.014 + e.cilia * 0.004 + e.pseudopodia * 0.006;\n    if (!Number.isFinite(Number(e.perception)) || e.perception <= 0) e.perception = DEFAULT_INITIAL_PERCEPTION;\n    const sensoryCost = e.chemosense * 0.010 + Math.max(0\x2C e.perception - DEFAULT_INITIAL_PERCEPTION) * 0.000075;\n    const motionCost = (hasMove(e\x2C 4) ? -0.004 : 0) + (hasMove(e\x2C 5) ? 0.010 : 0);\n    const vacuoleEfficiency = Math.max(0.82\x2C 1 - e.vacuole * 0.035);\n    e.metabolism = (kleiberBase + speedCost + appendageCost + sensoryCost + motionCost) * vacuoleEfficiency;\n    e.maxEnergy = 30 + e.reserves * 16 + e.size * 6.5 + e.vacuole * 3.5;\n    return e;\n  }\n\n  function spawnConsumer(opts = {}) {\n    const movement = Number(opts.movement ?? Math.floor(rand(0\x2C MOVE.length)));\n    const e = createCreature({\n      type: TYPE.CONSUMER\x2C\n      x: opts.x ?? rand(0\x2C WORLD.w)\x2C\n      y: opts.y ?? rand(0\x2C WORLD.h)\x2C\n      angle: rand(-Math.PI\x2C Math.PI)\x2C\n      color: '#54b7f1'\x2C\n      size: Number(opts.size ?? rand(1\x2C 4))\x2C\n      reserves: Number(opts.reserves ?? rand(2.5\x2C 6))\x2C\n      flagella: Number(opts.flagella ?? Math.floor(rand(0\x2C 3.99)))\x2C\n      cilia: Number(opts.cilia ?? Math.floor(rand(0\x2C 3.99)))\x2C\n      chemosense: Number(opts.chemosense ?? rand(0.6\x2C 2.4))\x2C\n      pseudopodia: Number(opts.pseudopodia ?? rand(0\x2C 2))\x2C\n      armor: Number(opts.armor ?? rand(0\x2C 2))\x2C\n      vacuole: Number(opts.vacuole ?? rand(0.5\x2C 2.2))\x2C\n      feeding: Number(opts.feeding ?? Math.floor(rand(0\x2C FEEDING.length)))\x2C\n      movement\x2C\n      movementMask: opts.movementMask != null ? movementMaskFromValue(opts.movementMask) : (1 << movement)\x2C\n      perception: Number(opts.perception ?? DEFAULT_INITIAL_PERCEPTION)\x2C\n      fertility: Number(opts.fertility ?? 1)\x2C\n      energy: Number(opts.energy ?? rand(32\x2C 58))\x2C\n      maxAge: Number(opts.maxAge ?? rand(2800\x2C 4600))\x2C\n      cooldown: rand(8\x2C 35)\n    });\n    const out = derivedConsumerStats(e);\n    if (!opts.keepConsumerSpeed) {\n      // Recalcular speedCost con la velocidad reducida para que metabolism sea consistente\n      const oldSpeedCost = Math.pow(Math.max(0\x2C out.speed) / 42\x2C 1.65) * 0.022;\n      out.speed *= 0.88;\n      const newSpeedCost = Math.pow(Math.max(0\x2C out.speed) / 42\x2C 1.65) * 0.022;\n      out.metabolism += (newSpeedCost - oldSpeedCost);\n    }\n    if (!opts.keepConsumerMetabolism) out.metabolism *= 0.9;\n    sim.liveConsumerCount++;\n    sim.mobileEnergySum += e.energy;\n    return out;\n  }\n\n  function spawnPredator(opts = {}) {\n    const e = spawnConsumer({\n      ...opts\x2C\n      size: opts.size ?? rand(3\x2C 7)\x2C\n      reserves: opts.reserves ?? rand(7\x2C 15)\x2C\n      flagella: opts.flagella ?? Math.floor(rand(2\x2C 4.99))\x2C\n      cilia: opts.cilia ?? Math.floor(rand(1\x2C 3))\x2C\n      chemosense: opts.chemosense ?? rand(1.8\x2C 3.6)\x2C\n      armor: opts.armor ?? rand(1\x2C 3)\x2C\n      energy: opts.energy ?? rand(120\x2C 190)\x2C\n      keepConsumerSpeed: true\x2C\n      keepConsumerMetabolism: true\n    });\n    e.type = TYPE.PREDATOR;\n    e.color = '#f05b50';\n    // Recalcular derived stats con atributos finales de predator\n    // para que speedCost y metabolism reflejen la masa y velocidad reales\n    derivedConsumerStats(e);\n    e.radius += 1.5;\n    // maxEnergy ya refleja genes de predator (size alto + reserves alto).\n    // El *= 1.5 anterior inflaba reservas ~50% y amplificaba boom-bust.\n    const oldEnergy = e.energy;\n    if (opts.energy == null) e.energy = rand(e.maxEnergy * 0.38\x2C e.maxEnergy * 0.62);\n    else e.energy = clamp(opts.energy\x2C 1\x2C e.maxEnergy);\n    e.maxAge = Number(opts.maxAge ?? rand(7200\x2C 11700));\n    sim.mobileEnergySum += e.energy - oldEnergy;\n    sim.liveConsumerCount--;\n    sim.predatorCount++;\n    return e;\n  }\n\n  function mutate(value\x2C spread\x2C min\x2C max) {\n    return clamp(value + rand(-spread\x2C spread)\x2C min\x2C max);\n  }\n\n  function childFrom(a\x2C b\x2C type) {\n    const pick = (key) => chance(0.5) ? a[key] : b[key];\n    // Stress-induced mutagenesis (SOS response): parents con baja energia producen\n    // offspring con mayor diversidad fenotipica. Triplica mutation spread cuando\n    // parent mas estresado esta bajo 30% maxEnergy. Anti-extincion evolutivo.\n    const minParentEnergy = Math.min(a.energy / a.maxEnergy\x2C b.energy / b.maxEnergy);\n    const stressFactor = minParentEnergy < 0.3 ? 2.5 : 1;\n    const opts = {\n      x: mod(a.x + torusDelta(b.x - a.x\x2C WORLD.w) * 0.5 + rand(-24\x2C 24)\x2C WORLD.w)\x2C\n      y: mod(a.y + torusDelta(b.y - a.y\x2C WORLD.h) * 0.5 + rand(-24\x2C 24)\x2C WORLD.h)\x2C\n      size: inheritGene(a\x2C b\x2C 'size'\x2C 0.5\x2C type === TYPE.PREDATOR ? 12 : 9\x2C false\x2C stressFactor)\x2C\n      reserves: inheritGene(a\x2C b\x2C 'reserves'\x2C 0\x2C type === TYPE.PREDATOR ? 24 : 14\x2C false\x2C stressFactor)\x2C\n      flagella: inheritGene(a\x2C b\x2C 'flagella'\x2C 0\x2C 7\x2C true\x2C stressFactor)\x2C\n      cilia: inheritGene(a\x2C b\x2C 'cilia'\x2C 0\x2C 6\x2C true\x2C stressFactor)\x2C\n      chemosense: inheritGene(a\x2C b\x2C 'chemosense'\x2C 0\x2C 5\x2C false\x2C stressFactor)\x2C\n      pseudopodia: inheritGene(a\x2C b\x2C 'pseudopodia'\x2C 0\x2C 4\x2C false\x2C stressFactor)\x2C\n      armor: inheritGene(a\x2C b\x2C 'armor'\x2C 0\x2C 5\x2C false\x2C stressFactor)\x2C\n      vacuole: inheritGene(a\x2C b\x2C 'vacuole'\x2C 0\x2C 4\x2C false\x2C stressFactor)\x2C\n      feeding: chance(0.08) ? Math.floor(rand(0\x2C FEEDING.length)) : pick('feeding')\x2C\n      movementMask: inheritMovementMask(a\x2C b)\x2C\n      fertility: inheritGene(a\x2C b\x2C 'fertility'\x2C 0.2\x2C 3\x2C false\x2C stressFactor)\x2C\n      maxAge: inheritGene(a\x2C b\x2C 'maxAge'\x2C type === TYPE.PREDATOR ? 5000 : 1800\x2C type === TYPE.PREDATOR ? 15000 : 8000\x2C false\x2C stressFactor)\x2C\n      // childEnergy derivado de parents para ambos tipos: previene creacion energetica\n      // Predator: parents pierden 42%+38%\x2C child recibe 55% de esa perdida\n      // Consumer: parents pierden 42%+38%\x2C child recibe 45% de esa perdida (mas coste reproductivo)\n      energy: type === TYPE.PREDATOR\n        ? (a.energy * 0.42 + b.energy * 0.38) * 0.55\n        : (a.energy * 0.42 + b.energy * 0.38) * 0.45\n    };\n    const child = type === TYPE.PREDATOR ? spawnPredator(opts) : spawnConsumer(opts);\n    // Clamp child energy a maxEnergy: previene empezar por encima del maximo\n    if (child.energy > child.maxEnergy) {\n      const excess = child.energy - child.maxEnergy;\n      child.energy = child.maxEnergy;\n      sim.mobileEnergySum -= excess;\n    }\n    // growthCost: el crecimiento de size encima de la media parental tiene coste energetico inmediato\n    const parentAvgSize = (a.size + b.size) * 0.5;\n    if (child.size > parentAvgSize) {\n      const growthCost = (child.size - parentAvgSize) * 4;\n      const actualCost = Math.min(growthCost\x2C child.energy - 1);\n      child.energy -= actualCost;\n      sim.mobileEnergySum -= actualCost;\n    }\n    sim.births += 1;\n    return child;\n  }\n\n  function cellKeyInt(x\x2C y) {\n    let col = Math.floor(x / CELL);\n    let row = Math.floor(y / CELL);\n    if (col < 0) col = 0; else if (col >= GRID_COLS) col = GRID_COLS - 1;\n    if (row < 0) row = 0; else if (row >= GRID_ROWS) row = GRID_ROWS - 1;\n    return row * GRID_COLS + col;\n  }\n\n  function rebuildGrid() {\n    const grid = sim.grid;\n    // Dirty-cell tracking: only clear cells that had creatures last frame\n    const dirty = sim.gridDirtyCells;\n    for (let d = 0; d < dirty.length; d += 1) {\n      const bucket = grid[dirty[d]];\n      for (let t = 0; t < GB_COUNT; t += 1) bucket[t].length = 0;\n    }\n    dirty.length = 0;\n    const seen = sim.gridDirtySeen;\n    seen.fill(0);\n    for (let i = 0; i < sim.creatures.length; i += 1) {\n      const e = sim.creatures[i];\n      if (!e || !e.alive) continue;\n      const key = cellKeyInt(e.x\x2C e.y);\n      grid[key][gridType(e)].push(e);\n      if (!seen[key]) { seen[key] = 1; dirty.push(key); }\n    }\n    // Insert carcasses into spatial grid (bucket[GB_CARCASS])\n    for (let i = 0; i < sim.carcasses.length; i += 1) {\n      const car = sim.carcasses[i];\n      if (!car || !car.alive || car.energy <= 0) continue;\n      const key = cellKeyInt(car.x\x2C car.y);\n      grid[key][GB_CARCASS].push(car);\n      if (!seen[key]) { seen[key] = 1; dirty.push(key); }\n    }\n  }\n\n  function queryNearby(x\x2C y\x2C radius\x2C type\x2C out) {\n    out.length = 0;\n    const grid = sim.grid;\n    const minX = Math.floor((x - radius) / CELL);\n    const maxX = Math.floor((x + radius) / CELL);\n    const minY = Math.floor((y - radius) / CELL);\n    const maxY = Math.floor((y + radius) / CELL);\n    const r2 = radius * radius;\n    // Fast path: query area fully inside world bounds \u2014 skip per-cell wrapping\n    if (minX >= 0 && maxX < GRID_COLS && minY >= 0 && maxY < GRID_ROWS) {\n      for (let cy = minY; cy <= maxY; cy += 1) {\n        const rowBase = cy * GRID_COLS;\n        for (let cx = minX; cx <= maxX; cx += 1) {\n          const bucket = grid[rowBase + cx];\n          const list = bucket[type];\n          for (let i = 0; i < list.length; i += 1) {\n            const e = list[i];\n            const dx = torusDelta(e.x - x\x2C WORLD.w);\n            const dy = torusDelta(e.y - y\x2C WORLD.h);\n            if (dx * dx + dy * dy <= r2) out.push(e);\n          }\n        }\n      }\n      return out;\n    }\n    // Slow path: query area crosses world bounds \u2014 wrap coordinates\n    for (let cy = minY; cy <= maxY; cy += 1) {\n      for (let cx = minX; cx <= maxX; cx += 1) {\n        let wy = cy;\n        if (wy < 0) wy += GRID_ROWS;\n        else if (wy >= GRID_ROWS) wy -= GRID_ROWS;\n        let wx = cx;\n        if (wx < 0) wx += GRID_COLS;\n        else if (wx >= GRID_COLS) wx -= GRID_COLS;\n        const bucket = grid[wy * GRID_COLS + wx];\n        const list = bucket[type];\n        for (let i = 0; i < list.length; i += 1) {\n          const e = list[i];\n          const dx = torusDelta(e.x - x\x2C WORLD.w);\n          const dy = torusDelta(e.y - y\x2C WORLD.h);\n          if (dx * dx + dy * dy <= r2) out.push(e);\n        }\n      }\n    }\n    return out;\n  }\n\n  // Scans grid cells once\x2C distributes creatures into outA/outB by type.\n  // Equivalent to two