script-source,78,/home/kali/.openclaw/workspace/projects/micromundo/sim-harness.js,#!/usr/bin/env node\n/**\n * sim-harness.js \u2014 Multi-seed reproducible simulation harness for Micromundo\n *\n * Replaces debug-sim.js for serious ecological analysis.\n *\n * Key improvements over debug-sim.js:\n *   - Seed control: reproducible runs via mulberry32 PRNG (already in app.js)\n *   - Proper dt: uses BASE_DT (1/30s) instead of lossy 0.5s chunks\n *   - Multi-seed: runs N seeds and aggregates mean \xb1 stdev\n *   - Full metrics: populations\x2C energy by trophic level\x2C gene drift\x2C\n *     birth/death rates\x2C extinctions\x2C trophic flow\x2C performance\n *\n * Usage:\n *   node sim-harness.js [options]\n *\n * Options:\n *   --duration=N        Simulation duration in minutes (default: 5)\n *   --seeds=N           Number of seeds to run (default: 3)\n *   --seed=N            Fixed seed (single run or all runs use variations)\n *   --interval=N        Metrics recording interval in seconds (default: 10)\n *   --dt=N              Simulation timestep override (default: 1/30)\n *   --out=FILE          Write JSON output to file (default: stdout)\n *   --quiet             Suppress human-readable stderr summary\n *\n * Output: JSON report on stdout\x2C human-readable summary on stderr.\n *\n * @author Bruce Lee \u2014 Principal Software Engineer\x2C TheOffice\n */\n\n'use strict';\n\nconst { execSync } = require('child_process');\nconst fs = require('fs');\nconst path = require('path');\nconst vm = require('vm');\n\n// \u2500\u2500\u2500 CLI Parsing \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nfunction parseArgs() {\n  const opts = {\n    durationMin: 5\x2C\n    seeds: 3\x2C\n    seed: null\x2C\n    intervalSec: 10\x2C\n    dt: 1 / 30\x2C\n    outFile: null\x2C\n    quiet: false\x2C\n    migration: true\x2C\n  };\n  for (const arg of process.argv.slice(2)) {\n    if (arg === '--no-migration') { opts.migration = false; continue; }\n    const m = arg.match(/^--(\\w+)=(.*)$/);\n    if (!m) continue;\n    const [\x2C key\x2C val] = m;\n    switch (key) {\n      case 'duration': opts.durationMin = parseFloat(val); break;\n      case 'seeds': opts.seeds = parseInt(val\x2C 10); break;\n      case 'seed': opts.seed = parseInt(val\x2C 10); break;\n      case 'interval': opts.intervalSec = parseFloat(val); break;\n      case 'dt': opts.dt = parseFloat(val); break;\n      case 'out': opts.outFile = val; break;\n      case 'quiet': opts.quiet = true; break;\n    }\n  }\n  return opts;\n}\n\n// \u2500\u2500\u2500 Config \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nconst OPTS = parseArgs();\nconst PROJ_DIR = path.resolve(__dirname);\nconst DURATION_SEC = OPTS.durationMin * 60;\nconst DT = OPTS.dt;\n// Run multiple seeds: if --seed given\x2C derive variations; else random\nconst SEEDS = [];\nif (OPTS.seed !== null) {\n  // Use base seed + variations for multi-seed\n  for (let i = 0; i < OPTS.seeds; i++) {\n    SEEDS.push((OPTS.seed + i * 7919) >>> 0); // prime-step variations\n  }\n} else {\n  // Random seeds\n  for (let i = 0; i < OPTS.seeds; i++) {\n    SEEDS.push((Math.random() * 4294967296) >>> 0);\n  }\n}\n\n// \u2500\u2500\u2500 Git hash for traceability \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nfunction getGitHash() {\n  try {\n    return execSync('git rev-parse --short HEAD'\x2C { cwd: PROJ_DIR\x2C encoding: 'utf8' }).trim();\n  } catch {\n    return 'unknown';\n  }\n}\n\n// \u2500\u2500\u2500 DOM mock (same approach as debug-sim.js) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nfunction createDomMock() {\n  const fakeCanvas = {\n    width: 800\x2C height: 600\x2C\n    getContext: () => ({\n      setTransform() {}\x2C fillRect() {}\x2C clearRect() {}\x2C\n      getImageData: () => ({ data: new Uint8ClampedArray(4) })\x2C\n      putImageData() {}\x2C createImageData: () => ({ data: new Uint8ClampedArray(4) })\x2C\n      save() {}\x2C restore() {}\x2C translate() {}\x2C scale() {}\x2C rotate() {}\x2C\n      beginPath() {}\x2C closePath() {}\x2C arc() {}\x2C fill() {}\x2C stroke() {}\x2C\n      moveTo() {}\x2C lineTo() {}\x2C fillText() {}\x2C\n      measureText: () => ({ width: 0 })\x2C drawImage() {}\x2C\n    })\x2C\n    getBoundingClientRect: () => ({ width: 800\x2C height: 600\x2C left: 0\x2C top: 0 })\x2C\n  };\n  const fakeElement = {\n    textContent: ''\x2C innerHTML: ''\x2C value: '50'\x2C style: {}\x2C\n    classList: { add() {}\x2C remove() {}\x2C toggle() {}\x2C contains: () => false }\x2C\n    appendChild() {}\x2C removeChild() {}\x2C querySelectorAll: () => []\x2C\n    querySelector: () => fakeElement\x2C removeEventListener() {}\x2C\n    setAttribute() {}\x2C getAttribute: () => null\x2C removeAttribute() {}\x2C\n    scrollWidth: 0\x2C scrollHeight: 0\x2C clientWidth: 800\x2C clientHeight: 600\x2C\n    offsetWidth: 800\x2C offsetHeight: 600\x2C\n  };\n  const canvasIds = new Set(['world'\x2C 'graph'\x2C 'geneGraph']);\n  const documentMock = {\n    getElementById: (id) => (canvasIds.has(id) ? fakeCanvas : fakeElement)\x2C\n    querySelector: () => fakeElement\x2C querySelectorAll: () => []\x2C\n    createElement: () => fakeElement\x2C createTextNode: () => fakeElement\x2C\n    body: fakeElement\x2C documentElement: fakeElement\x2C\n    addEventListener() {}\x2C removeEventListener() {}\x2C readyState: 'complete'\x2C\n  };\n  const windowMock = {\n    innerWidth: 800\x2C innerHeight: 600\x2C devicePixelRatio: 1\x2C\n    addEventListener() {}\x2C removeEventListener() {}\x2C\n    requestAnimationFrame: () => 0\x2C cancelAnimationFrame() {}\x2C\n  };\n  return { documentMock\x2C windowMock };\n}\n\n// \u2500\u2500\u2500 Load app.js into sandbox and extract sim API \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nfunction loadSim() {\n  const appJsPath = path.join(PROJ_DIR\x2C 'app.js');\n  let src = fs.readFileSync(appJsPath\x2C 'utf8');\n\n  const exportsCode = `\n    globalThis.__sim = {\n      simulate\x2C counts\x2C sim\x2C stepProducer\x2C stepMobile\x2C stepProducerField\x2C\n      seedWorld\x2C resetWorld\x2C initProducerField\x2C initGrid\x2C\n      recordGeneHistory\x2C spawnProducer\x2C spawnConsumer\x2C spawnPredator\x2C\n      kill\x2C GROUPS\x2C GROUP_KEYS\x2C GROUP_LABELS\x2C TYPE\x2C PRODUCER\x2C WORLD\x2C\n      setSeed\x2C applyThermalDecay\x2C\n      rebuildGrid\x2C compactIfNeeded\x2C\n      MAX_DT\x2C BASE_DT\x2C GRID_REFRESH_INTERVAL\x2C\n    };\n  `;\n  src = src.replace(/\\n  init\\(\\);\\n\\}\\)\\(\\);\\s*$/\x2C '\\n' + exportsCode + '\\n})();\\n');\n  if (!src.includes('globalThis.__sim')) {\n    throw new Error('Failed to inject exports into app.js');\n  }\n\n  const { documentMock\x2C windowMock } = createDomMock();\n  const ctx = {\n    window: windowMock\x2C document: documentMock\x2C\n    performance: { now: () => Date.now() }\x2C\n    requestAnimationFrame: () => 0\x2C\n    Intl\x2C Number\x2C Math\x2C Date\x2C console\x2C\n    setTimeout: () => {}\x2C clearTimeout: () => {}\x2C\n    setInterval: () => {}\x2C clearInterval: () => {}\x2C\n    Float32Array\x2C Uint8ClampedArray\x2C Map\x2C Set\x2C Array\x2C Object\x2C String\x2C Boolean\x2C JSON\x2C Error\x2C\n    ResizeObserver: class { observe() {} unobserve() {} disconnect() {} }\x2C\n    globalThis: {}\x2C self: {}\x2C\n  };\n  ctx.globalThis = ctx;\n  ctx.self = ctx;\n\n  vm.createContext(ctx);\n  vm.runInContext(src\x2C ctx\x2C { filename: 'app.js' });\n  if (!ctx.__sim) throw new Error('Failed to extract __sim from app.js');\n  return ctx.__sim;\n}\n\n// \u2500\u2500\u2500 Single-seed run (faithful to browser loop) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nfunction runSingleSeed(seed\x2C durationSec\x2C intervalSec\x2C dt\x2C migrationEnabled) {\n  const api = loadSim();\n\n  // Set seed BEFORE resetWorld to ensure full reproducibility\n  api.sim.seed = seed >>> 0;\n  api.resetWorld();\n  api.recordGeneHistory();\n\n  // When migration is disabled\x2C pin timer high so simulate() never fires checkMigration\n  if (!migrationEnabled) {\n    api.sim.migrationTimer = 1e9;\n  }\n\n  // Determine chunking: if dt > MAX_DT\x2C split into chunks of <= MAX_DT\n  const MAX_DT = api.MAX_DT || 0.1;\n  const GRID_REFRESH_INTERVAL = api.GRID_REFRESH_INTERVAL || 5;\n  const chunksPerStep = Math.max(1\x2C Math.ceil(dt / MAX_DT));\n  const effectiveDt = Math.min(dt / chunksPerStep\x2C MAX_DT);\n\n  const wallStart = Date.now();\n  const metrics = [];\n  const extinctions = [];\n  let lastRecord = 0;\n  let prevAlive = {\n    'producer-a': true\x2C 'producer-b': true\x2C 'producer-c': true\x2C\n    'consumer': true\x2C 'predator': true\x2C\n  };\n  let prevBirths = 0;\n  let prevDeaths = 0;\n  let stepsProcessed = 0;\n\n  // Flow accumulators for delta computation\n  const flowKeys = ['graze'\x2C 'colonyFeed'\x2C 'prodCGraze'\x2C 'predation'\x2C 'carcassEat'\x2C\n    'carcassToField'\x2C 'metabolism'\x2C 'reproduction'\x2C 'excretion'\x2C 'thermal'\x2C 'carcassExpire'];\n  let prevFlowAccum = {};\n  function snapshotFlowAccum() {\n    const snap = {};\n    for (const k of flowKeys) snap[k] = api.sim.flowAccum[k] || 0;\n    return snap;\n  }\n  prevFlowAccum = snapshotFlowAccum();\n\n  function recordMetrics() {\n    const c = api.counts();\n    const dt_real = api.sim.time - lastRecord || intervalSec;\n    const birthsDelta = api.sim.births - prevBirths;\n    const deathsDelta = api.sim.deaths - prevDeaths;\n    prevBirths = api.sim.births;\n    prevDeaths = api.sim.deaths;\n\n    // Energy by trophic level\n    let producerEnergy = 0;\n    let consumerEnergy = 0;\n    let predatorEnergy = 0;\n    let carcassEnergy = 0;\n    const creatures = api.sim.creatures;\n    for (let i = 0; i < creatures.length; i++) {\n      const e = creatures[i];\n      if (!e || !e.alive) continue;\n      if (e.type === api.TYPE.PRODUCER) producerEnergy += e.energy || 0;\n      else if (e.type === api.TYPE.CONSUMER) consumerEnergy += e.energy || 0;\n      else if (e.type === api.TYPE.PREDATOR) predatorEnergy += e.energy || 0;\n    }\n    const carcasses = api.sim.carcasses;\n    for (let i = 0; i < carcasses.length; i++) {\n      if (carcasses[i]) carcassEnergy += carcasses[i].energy || 0;\n    }\n\n    // Gene snapshot with variance\n    const genes = {};\n    if (api.sim.geneHistory.length > 0) {\n      const gh = api.sim.geneHistory.at(api.sim.geneHistory.length - 1);\n      if (gh) {\n        for (const group of api.GROUPS) {\n          if (gh[group]) {\n            // Compute variance from current creatures (gh only has averages)\n            const geneKeys = api.GROUP_KEYS[group] || [];\n            const vals = {};\n            const sums = {};\n            const sumsq = {};\n            let n = 0;\n            if (group === 'producer-a') {\n              n = 1;\n              for (const gk of geneKeys) { vals[gk] = gh[group].avg[gk] || 0; sums[gk] = vals[gk]; sumsq[gk] = vals[gk] * vals[gk]; }\n            } else {\n              for (let ci = 0; ci < creatures.length; ci++) {\n                const e = creatures[ci];\n                if (!e || !e.alive) continue;\n                const eg = groupForCreatureLive(e\x2C group\x2C api);\n                if (!eg) continue;\n                n++;\n                for (const gk of geneKeys) {\n                  const v = e[gk] || 0;\n                  sums[gk] = (sums[gk] || 0) + v;\n                  sumsq[gk] = (sumsq[gk] || 0) + v * v;\n                }\n              }\n            }\n            const avg = {};\n            const variance = {};\n            for (const gk of geneKeys) {\n              avg[gk] = n > 0 ? (sums[gk] || 0) / n : 0;\n              variance[gk] = n > 1 ? Math.max(0\x2C (sumsq[gk] || 0) / n - avg[gk] * avg[gk]) : 0;\n            }\n            genes[group] = { n\x2C avg\x2C variance };\n          }\n        }\n      }\n    }\n\n    // Energy flow deltas\n    const curFlow = snapshotFlowAccum();\n    const flows = {};\n    for (const k of flowKeys) {\n      flows[k] = (curFlow[k] - prevFlowAccum[k]) / dt_real;\n    }\n    prevFlowAccum = curFlow;\n    const energyIn = (flows.graze || 0) + (flows.colonyFeed || 0) + (flows.prodCGraze || 0)\n      + (flows.predation || 0) + (flows.carcassEat || 0) + (flows.excretion || 0);\n    const energyOut = (flows.metabolism || 0) + (flows.reproduction || 0)\n      + (flows.thermal || 0) + (flows.carcassExpire || 0);\n\n    // Detect extinctions\n    const countMap = {\n      'producer-a': c.producerDensity > 0.01\x2C\n      'producer-b': c.producerB > 0\x2C\n      'producer-c': c.producerC > 0\x2C\n      'consumer': c.consumers > 0\x2C\n      'predator': c.predators > 0\x2C\n    };\n    for (const [key\x2C alive] of Object.entries(countMap)) {\n      if (!alive && prevAlive[key]) {\n        extinctions.push({ t: parseFloat(api.sim.time.toFixed(1))\x2C group: key });\n      }\n    }\n    prevAlive = countMap;\n\n    metrics.push({\n      t: parseFloat(api.sim.time.toFixed(1))\x2C\n      populations: {\n        producerA_density: parseFloat(c.producerDensity.toFixed(4))\x2C\n        producerB: c.producerB\x2C\n        producerC: c.producerC\x2C\n        consumers: c.consumers\x2C\n        predators: c.predators\x2C\n        total_creatures: creatures.filter(e => e && e.alive).length\x2C\n      }\x2C\n      energy: {\n        producer: parseFloat(producerEnergy.toFixed(1))\x2C\n        consumer: parseFloat(consumerEnergy.toFixed(1))\x2C\n        predator: parseFloat(predatorEnergy.toFixed(1))\x2C\n        field: parseFloat((api.sim.producerField.total || 0).toFixed(1))\x2C\n        carcass: parseFloat(carcassEnergy.toFixed(1))\x2C\n        mobile_sum: parseFloat((api.sim.mobileEnergySum || 0).toFixed(1))\x2C\n        avg: parseFloat(c.energyAvg.toFixed(2))\x2C\n      }\x2C\n      rates: {\n        births_per_sec: parseFloat((birthsDelta / dt_real).toFixed(3))\x2C\n        deaths_per_sec: parseFloat((deathsDelta / dt_real).toFixed(3))\x2C\n        births_total: api.sim.births\x2C\n        deaths_total: api.sim.deaths\x2C\n      }\x2C\n      flows: {\n        graze: parseFloat((flows.graze || 0).toFixed(3))\x2C\n        colonyFeed: parseFloat((flows.colonyFeed || 0).toFixed(3))\x2C\n        prodCGraze: parseFloat((flows.prodCGraze || 0).toFixed(3))\x2C\n        predation: parseFloat((flows.predation || 0).toFixed(3))\x2C\n        carcassEat: parseFloat((flows.carcassEat || 0).toFixed(3))\x2C\n        metabolism: parseFloat((flows.metabolism || 0).toFixed(3))\x2C\n        reproduction: parseFloat((flows.reproduction || 0).toFixed(3))\x2C\n        excretion: parseFloat((flows.excretion || 0).toFixed(3))\x2C\n        thermal: parseFloat((flows.thermal || 0).toFixed(3))\x2C\n        carcassExpire: parseFloat((flows.carcassExpire || 0).toFixed(3))\x2C\n        balance_in: parseFloat(energyIn.toFixed(3))\x2C\n        balance_out: parseFloat(energyOut.toFixed(3))\x2C\n      }\x2C\n      genes\x2C\n    });\n\n    lastRecord = api.sim.time;\n  }\n\n  // Initial record\n  recordMetrics();\n\n  // Main simulation loop \u2014 faithful to browser animationLoop\n  while (api.sim.time < durationSec) {\n    // Mirror browser loop: compactIfNeeded + rebuildGrid before simulate chunks\n    api.compactIfNeeded();\n    api.rebuildGrid();\n\n    for (let chunk = 0; chunk < chunksPerStep; chunk++) {\n      api.simulate(effectiveDt);\n      stepsProcessed++;\n      // Mid-loop grid refresh for large multi-chunk steps\n      if ((chunk + 1) % GRID_REFRESH_INTERVAL === 0 && chunk + 1 < chunksPerStep) {\n        api.rebuildGrid();\n      }\n    }\n\n    // Migration: simulate() already decrements migrationTimer and calls\n    // checkMigration() internally. When migration is disabled\x2C pin timer\n    // high so it never fires.\n    if (!migrationEnabled) {\n      api.sim.migrationTimer = 1e9;\n    }\n\n    // Record gene history at intervals\n    const lastGH = api.sim.geneHistory.length > 0\n      ? api.sim.geneHistory.at(api.sim.geneHistory.length - 1).t\n      : 0;\n    if (api.sim.time - lastGH >= intervalSec) {\n      api.recordGeneHistory();\n    }\n\n    // Record metrics at intervals\n    if (api.sim.time - lastRecord >= intervalSec) {\n      recordMetrics();\n    }\n  }\n\n  // Final record\n  recordMetrics();\n\n  const wallTime = Date.now() - wallStart;\n  const last = metrics[metrics.length - 1];\n\n  // Compute p50/p95 for populations and energy across all metric points\n  const popKeys = ['producerB'\x2C 'producerC'\x2C 'consumers'\x2C 'predators'];\n  const energyKeysAgg = ['producer'\x2C 'consumer'\x2C 'predator'\x2C 'field'\x2C 'avg'];\n  const percentiles = computePercentiles(metrics\x2C popKeys\x2C energyKeysAgg);\n\n  return {\n    seed: seed >>> 0\x2C\n    git_commit: getGitHash()\x2C\n    duration_sim_sec: parseFloat(api.sim.time.toFixed(1))\x2C\n    wall_time_ms: wallTime\x2C\n    speed_factor: parseFloat((api.sim.time * 1000 / wallTime).toFixed(1))\x2C\n    dt: dt\x2C\n    effective_dt: effectiveDt\x2C\n    chunks_per_step: chunksPerStep\x2C\n    interval_sec: intervalSec\x2C\n    migration_enabled: migrationEnabled\x2C\n    metrics\x2C\n    extinctions\x2C\n    percentiles\x2C\n    final_state: {\n      populations: last.populations\x2C\n      energy: last.energy\x2C\n      rates: last.rates\x2C\n      flows: last.flows\x2C\n      survival: checkSurvival(last)\x2C\n    }\x2C\n  };\n}\n\nfunction checkSurvival(lastMetric) {\n  const p = lastMetric.populations;\n  return {\n    'producer-a': p.producerA_density > 0.01\x2C\n    'producer-b': p.producerB > 0\x2C\n    'producer-c': p.producerC > 0\x2C\n    'consumer': p.consumers > 0\x2C\n    'predator': p.predators > 0\x2C\n    all_alive: p.producerA_density > 0.01 && p.producerB > 0 && p.producerC > 0\n               && p.consumers > 0 && p.predators > 0\x2C\n  };\n}\n\n// Helper: check if a creature belongs to a gene group (live computation)\nfunction groupForCreatureLive(e\x2C group\x2C api) {\n  if (!e || !e.alive) return false;\n  if (group === 'producer-b' && e.type === api.TYPE.PRODUCER && !e.mobile) return true;\n  if (group === 'producer-c' && e.type === api.TYPE.PRODUCER && e.mobile) return true;\n  if (group === 'consumer' && e.type === api.TYPE.CONSUMER) return true;\n  if (group === 'predator' && e.type === api.TYPE.PREDATOR) return true;\n  return false;\n}\n\n// Helper: compute p50/p95 for populations and energy across time series\nfunction computePercentiles(metrics\x2C popKeys\x2C energyKeys) {\n  function pct(sorted\x2C p) {\n    if (sorted.length === 0) return 0;\n    const idx = Math.min(sorted.length - 1\x2C Math.floor(sorted.length * p));\n    return sorted[idx];\n  }\n  const result = { populations: {}\x2C energy: {} };\n  for (const k of popKeys) {\n    const vals = metrics.map(m => m.populations[k] || 0).sort((a\x2C b) => a - b);\n    result.populations[k] = { p50: pct(vals\x2C 0.5)\x2C p95: pct(vals\x2C 0.95) };\n  }\n  for (const k of energyKeys) {\n    const vals = metrics.map(m => m.energy[k] || 0).sort((a\x2C b) => a - b);\n    result.energy[k] = { p50: pct(vals\x2C 0.5)\x2C p95: pct(vals\x2C 0.95) };\n  }\n  return result;\n}\n\n// \u2500\u2500\u2500 Aggregation across seeds \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nfunction aggregateRuns(runs) {\n  const n = runs.length;\n  if (n === 0) return null;\n\n  const finals = runs.map(r => r.final_state);\n  const lastMetrics = runs.map(r => r.metrics[r.metrics.length - 1]);\n\n  function mean(arr) { return arr.reduce((a\x2C b) => a + b\x2C 0) / arr.length; }\n  function stdev(arr) {\n    if (arr.length < 2) return 0;\n    const m = mean(arr);\n    return Math.sqrt(mean(arr.map(v => (v - m) ** 2)));\n  }\n\n  const keys = ['producerA_density'\x2C 'producerB'\x2C 'producerC'\x2C 'consumers'\x2C 'predators'];\n  const popStats = {};\n  for (const k of keys) {\n    const vals = lastMetrics.map(m => m.populations[k]);\n    popStats[k] = { mean: mean(vals)\x2C stdev: stdev(vals)\x2C min: Math.min(...vals)\x2C max: Math.max(...vals) };\n  }\n\n  const energyKeys = ['producer'\x2C 'consumer'\x2C 'predator'\x2C 'field'\x2C 'carcass'\x2C 'avg'];\n  const energyStats = {};\n  for (const k of energyKeys) {\n    const vals = lastMetrics.map(m => m.energy[k]);\n    energyStats[k] = { mean: mean(vals)\x2C stdev: stdev(vals) };\n  }\n\n  // Percentile aggregation across runs\n  const pctKeys = ['producerB'\x2C 'producerC'\x2C 'consumers'\x2C 'predators'];\n  const pctStats = { populations: {}\x2C energy: {} };\n  for (const k of pctKeys) {\n    const p50vals = runs.map(r => r.percentiles?.populations[k]?.p50 || 0);\n    const p95vals = runs.map(r => r.percentiles?.populations[k]?.p95 || 0);\n    pctStats.populations[k] = {\n      p50_mean: mean(p50vals)\x2C p50_stdev: stdev(p50vals)\x2C\n      p95_mean: mean(p95vals)\x2C p95_stdev: stdev(p95vals)\x2C\n    };\n  }\n  for (const k of ['producer'\x2C 'consumer'\x2C 'predator'\x2C 'field'\x2C 'avg']) {\n    const p50vals = runs.map(r => r.percentiles?.energy[k]?.p50 || 0);\n    const p95vals = runs.map(r => r.percentiles?.energy[k]?.p95 || 0);\n    pctStats.energy[k] = {\n      p50_mean: mean(p50vals)\x2C p50_stdev: stdev(p50vals)\x2C\n      p95_mean: mean(p95vals)\x2C p95_stdev: stdev(p95vals)\x2C\n    };\n  }\n\n  const birthRates = lastMetrics.map(m => m.rates.births_per_sec);\n  const deathRates = lastMetrics.map(m => m.rates.deaths_per_sec);\n\n  // Flow aggregation\n  const flowKeysAgg = ['graze'\x2C 'colonyFeed'\x2C 'prodCGraze'\x2C 'predation'\x2C 'carcassEat'\x2C\n    'metabolism'\x2C 'reproduction'\x2C 'excretion'\x2C 'thermal'\x2C 'carcassExpire'];\n  const flowStats = {};\n  for (const k of flowKeysAgg) {\n    const vals = lastMetrics.map(m => m.flows ? m.flows[k] || 0 : 0);\n    flowStats[k] = { mean: mean(vals)\x2C stdev: stdev(vals) };\n  }\n  const balanceIn = lastMetrics.map(m => m.flows ? m.flows.balance_in || 0 : 0);\n  const balanceOut = lastMetrics.map(m => m.flows ? m.flows.balance_out || 0 : 0);\n  flowStats.balance_in = { mean: mean(balanceIn)\x2C stdev: stdev(balanceIn) };\n  flowStats.balance_out = { mean: mean(balanceOut)\x2C stdev: stdev(balanceOut) };\n  flowStats.net = { mean: mean(balanceIn) - mean(balanceOut)\x2C stdev: stdev(balanceIn.map((v\x2C i) => v - balanceOut[i])) };\n\n  const extinctions = runs.map(r => r.extinctions.length);\n  const survivalCounts = finals.map(f => Object.values(f.survival).filter(Boolean).length - 1);\n\n  // Coefficient of variation for final populations (stability metric)\n  const cvConsumers = popStats.consumers.stdev / Math.max(1\x2C popStats.consumers.mean);\n  const cvPredators = popStats.predators.stdev / Math.max(1\x2C popStats.predators.mean);\n\n  return {\n    seeds: n\x2C\n    populations: popStats\x2C\n    energy: energyStats\x2C\n    percentiles: pctStats\x2C\n    rates: {\n      births_per_sec: { mean: mean(birthRates)\x2C stdev: stdev(birthRates) }\x2C\n      deaths_per_sec: { mean: mean(deathRates)\x2C stdev: stdev(deathRates) }\x2C\n      total_births: { mean: mean(finals.map(f => f.rates.births_total))\x2C stdev: stdev(finals.map(f => f.rates.births_total)) }\x2C\n      total_deaths: { mean: mean(finals.map(f => f.rates.deaths_total))\x2C stdev: stdev(finals.map(f => f.rates.deaths_total)) }\x2C\n    }\x2C\n    flows: flowStats\x2C\n    extinctions: {\n      total: extinctions.reduce((a\x2C b) => a + b\x2C 0)\x2C\n      per_run: extinctions\x2C\n      mean: mean(extinctions)\x2C\n    }\x2C\n    survival: {\n      groups_alive_mean: mean(survivalCounts)\x2C\n      all_survived: finals.every(f => f.survival.all_alive)\x2C\n      any_extinction: runs.some(r => r.extinctions.length > 0)\x2C\n    }\x2C\n    stability: {\n      cv_consumers: parseFloat(cvConsumers.toFixed(3))\x2C\n      cv_predators: parseFloat(cvPredators.toFixed(3))\x2C\n    }\x2C\n    performance: {\n      wall_time_ms: { mean: mean(runs.map(r => r.wall_time_ms))\x2C stdev: stdev(runs.map(r => r.wall_time_ms)) }\x2C\n      speed_factor: { mean: mean(runs.map(r => r.speed_factor))\x2C stdev: stdev(runs.map(r => r.speed_factor)) }\x2C\n    }\x2C\n  };\n}\n\n// \u2500\u2500\u2500 Human-readable report \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nfunction formatTime(t) {\n  const mins = Math.floor(t / 60);\n  const secs = Math.floor(t % 60);\n  return `${String(mins).padStart(2\x2C '0')}:${String(secs).padStart(2\x2C '0')}`;\n}\n\nfunction fmt(v\x2C decimals = 1) {\n  if (typeof v !== 'number' || !isFinite(v)) return 'N/A';\n  if (Math.abs(v) >= 100) return Math.round(v).toString();\n  return v.toFixed(decimals);\n}\n\nfunction printHumanReport(runs\x2C agg) {\n  const lines = [];\n  const first = runs[0];\n\n  lines.push('\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550');\n  lines.push('  \ud83e\uddec SIM-HARNESS \u2014 Multi-seed Ecosystem Analysis');\n  lines.push('\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550');\n  lines.push('');\n  lines.push(`  Commit:     ${first.git_commit}`);\n  lines.push(`  Seeds:      ${runs.length} (${runs.map(r => r.seed).join('\x2C ')})`);\n  lines.push(`  Duration:   ${formatTime(first.duration_sim_sec)} (${first.duration_sim_sec}s per run)`);\n  lines.push(`  dt:         ${first.dt.toFixed(4)}s (eff: ${first.effective_dt?.toFixed(4) || first.dt.toFixed(4)}s\x2C chunks: ${first.chunks_per_step || 1})`);\n  lines.push(`  Interval:   ${first.interval_sec}s`);\n  lines.push(`  Migration:  ${first.migration_enabled ? 'ON' : 'OFF'}`);\n  lines.push(`  Timestamp:  ${new Date().toISOString()}`);\n  lines.push('');\n\n  // Aggregated populations\n  lines.push('\u2500\u2500 POPULATIONS (mean \xb1 \u03c3 across seeds) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500');\n  lines.push('  Group                Mean         \u03c3          Min          Max');\n  lines.push('  \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500');\n  const popLabels = {\n    producerA_density: 'Prod A (dens.)'\x2C\n    producerB: 'Prod B (colonia)'\x2C\n    producerC: 'Prod C (m\xf3vil)'\x2C\n    consumers: 'Consumidores'\x2C\n    predators: 'Depredadores'\x2C\n  };\n  for (const [k\x2C label] of Object.entries(popLabels)) {\n    const s = agg.populations[k];\n    lines.push(`  ${label.padEnd(19)} ${fmt(s.mean\x2C 2).padStart(10)} ${fmt(s.stdev\x2C 2).padStart(10)} ${fmt(s.min\x2C 2).padStart(10)} ${fmt(s.max\x2C 2).padStart(10)}`);\n  }\n  lines.push('');\n\n  // Percentiles\n  if (agg.percentiles) {\n    lines.push('\u2500\u2500 PERCENTILES p50/p95 (mean across seeds) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500');\n    lines.push('  Group                p50         p95');\n    lines.push('  \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500');\n    for (const [k\x2C label] of Object.entries({ producerB: 'Prod B'\x2C producerC: 'Prod C'\x2C consumers: 'Consumers'\x2C predators: 'Predators' })) {\n      const s = agg.percentiles.populations[k];\n      if (s) lines.push(`  ${label.padEnd(19)} ${fmt(s.p50_mean\x2C 1).padStart(10)} ${fmt(s.p95_mean\x2C 1).padStart(10)}`);\n    }\n    lines.push('');\n  }\n\n  // Aggregated energy\n  lines.push('\u2500\u2500 ENERGY (mean \xb1 \u03c3) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500');\n  const eLabels = { producer: 'Productores'\x2C consumer: 'Consumidores'\x2C predator: 'Depredadores'\x2C field: 'Campo'\x2C carcass: 'Carcasses'\x2C avg: 'Promedio' };\n  for (const [k\x2C label] of Object.entries(eLabels)) {\n    const s = agg.energy[k];\n    lines.push(`  ${label.padEnd(19)} ${fmt(s.mean\x2C 1).padStart(10)} ${fmt(s.stdev\x2C 1).padStart(10)}`);\n  }\n  lines.push('');\n\n  // Energy flows\n  if (agg.flows) {\n    lines.push('\u2500\u2500 ENERGY FLOWS (mean \xb1 \u03c3\x2C energy/s) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500');\n    const fLabels = {\n      graze: 'Grazing'\x2C colonyFeed: 'Colonia feed'\x2C prodCGraze: 'ProdC grazing'\x2C\n      predation: 'Predaci\xf3n'\x2C carcassEat: 'Carcass eat'\x2C metabolism: 'Metabolismo'\x2C\n      reproduction: 'Reproducci\xf3n'\x2C excretion: 'Excretion'\x2C thermal: 'Thermal'\x2C\n      carcassExpire: 'Carcass expire'\x2C\n    };\n    for (const [k\x2C label] of Object.entries(fLabels)) {\n      const s = agg.flows[k];\n      if (s) lines.push(`  ${label.padEnd(19)} ${fmt(s.mean\x2C 2).padStart(10)} ${fmt(s.stdev\x2C 2).padStart(10)}`);\n    }\n    if (agg.flows.net) {\n      lines.push(`  ${'NET BALANCE'.padEnd(19)} ${fmt(agg.flows.net.mean\x2C 2).padStart(10)} ${fmt(agg.flows.net.stdev\x2C 2).padStart(10)}`);\n    }\n    lines.push('');\n  }\n\n  // Births/deaths\n  lines.push('\u2500\u2500 EVENTOS (mean \xb1 \u03c3) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500');\n  lines.push(`  Births/s:    ${fmt(agg.rates.births_per_sec.mean\x2C 3)} \xb1 ${fmt(agg.rates.births_per_sec.stdev\x2C 3)}`);\n  lines.push(`  Deaths/s:    ${fmt(agg.rates.deaths_per_sec.mean\x2C 3)} \xb1 ${fmt(agg.rates.deaths_per_sec.stdev\x2C 3)}`);\n  lines.push(`  Total births: ${fmt(agg.rates.total_births.mean\x2C 0)} \xb1 ${fmt(agg.rates.total_births.stdev\x2C 0)}`);\n  lines.push(`  Total deaths: ${fmt(agg.rates.total_deaths.mean\x2C 0)} \xb1 ${fmt(agg.rates.total_deaths.stdev\x2C 0)}`);\n  lines.push('');\n\n  // Extinctions\n  if (agg.extinctions.total > 0) {\n    lines.push('\u2500\u2500 \u26a0 EXTINCIONES \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500');\n    lines.push(`  Total: ${agg.extinctions.total} | Por run: [${agg.extinctions.per_run.join('\x2C ')}]`);\n    for (const run of runs) {\n      if (run.extinctions.length > 0) {\n        for (const ext of run.extinctions) {\n          lines.push(`  Seed ${run.seed}: ${formatTime(ext.t)} \u2014 ${ext.group}`);\n        }\n      }\n    }\n    lines.push('');\n  } else {\n    lines.push('\u2500\u2500 \u2705 Sin extinciones en ninguna semilla \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500');\n    lines.push('');\n  }\n\n  // Survival\n  lines.push('\u2500\u2500 SUPERVIVENCIA \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500');\n  lines.push(`  Todos sobrevivieron: ${agg.survival.all_survived ? '\u2705 S\xed' : '\u274c No'}`);\n  lines.push(`  Grupos vivos promedio: ${fmt(agg.survival.groups_alive_mean\x2C 1)}/5`);\n  if (agg.stability) {\n    lines.push(`  CV consumers: ${fmt(agg.stability.cv_consumers\x2C 3)} | CV predators: ${fmt(agg.stability.cv_predators\x2C 3)}`);\n  }\n  lines.push('');\n\n  // Performance\n  lines.push('\u2500\u2500 RENDIMIENTO \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500');\n  lines.push(`  Wall time: ${fmt(agg.performance.wall_time_ms.mean / 1000\x2C 1)}s \xb1 ${fmt(agg.performance.wall_time_ms.stdev / 1000\x2C 1)}s`);\n  lines.push(`  Speed:     ${fmt(agg.performance.speed_factor.mean\x2C 1)}x \xb1 ${fmt(agg.performance.speed_factor.stdev\x2C 1)}x`);\n  lines.push('');\n\n  // Per-run detail\n  lines.push('\u2500\u2500 DETALLE POR SEMILLA \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500');\n  for (const run of runs) {\n    const f = run.final_state;\n    lines.push(`  Seed ${run.seed}: P:${f.populations.producerB}/${f.populations.producerC} C:${f.populations.consumers} X:${f.populations.predators} | E:${fmt(f.energy.avg\x2C 1)} | B:${f.rates.births_total} D:${f.rates.deaths_total} | ${f.survival.all_alive ? '\u2705' : '\u274c'}`);\n  }\n  lines.push('');\n  lines.push('\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550');\n\n  return lines.join('\\n');\n}\n\n// \u2500\u2500\u2500 Main \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nfunction main() {\n  if (!OPTS.quiet) {\n    process.stderr.write(`\\n\ud83e\uddec sim-harness: ${OPTS.seeds} seed(s) \xd7 ${OPTS.durationMin} min\x2C dt=${DT.toFixed(4)}s\\n\\n`);\n  }\n\n  const runs = [];\n  for (let i = 0; i < SEEDS.length; i++) {\n    const seed = SEEDS[i];\n    if (!OPTS.quiet) {\n      process.stderr.write(`  Run ${i + 1}/${SEEDS.length} (seed=${seed})... `);\n    }\n    const runStart = Date.now();\n    const result = runSingleSeed(seed\x2C DURATION_SEC\x2C OPTS.intervalSec\x2C DT\x2C OPTS.migration);\n    runs.push(result);\n    if (!OPTS.quiet) {\n      process.stderr.write(`done in ${((Date.now() - runStart) / 1000).toFixed(1)}s\\n`);\n    }\n  }\n\n  const agg = aggregateRuns(runs);\n\n  const report = {\n    meta: {\n      tool: 'sim-harness.js'\x2C\n      version: '1.0'\x2C\n      git_commit: runs[0].git_commit\x2C\n      timestamp: new Date().toISOString()\x2C\n      config: {\n        duration_min: OPTS.durationMin\x2C\n        duration_sec: DURATION_SEC\x2C\n        seeds: SEEDS\x2C\n        seed_count: SEEDS.length\x2C\n        dt: DT\x2C\n        interval_sec: OPTS.intervalSec\x2C\n        migration: OPTS.migration\x2C\n      }\x2C\n    }\x2C\n    aggregate: agg\x2C\n    runs\x2C\n  };\n\n  const json = JSON.stringify(report\x2C null\x2C 2);\n\n  if (OPTS.outFile) {\n    fs.writeFileSync(OPTS.outFile\x2C json);\n    if (!OPTS.quiet) {\n      process.stderr.write(`\\n  JSON written to ${OPTS.outFile}\\n`);\n    }\n  } else {\n    // JSON to stdout\n    process.stdout.write(json + '\\n');\n  }\n\n  if (!OPTS.quiet) {\n    process.stderr.write('\\n');\n    process.stderr.write(printHumanReport(runs\x2C agg));\n    process.stderr.write('\\n\\n');\n  }\n}\n\nmain();\n
